<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Views: Find and Replace" Width="384" Height="313" MinWidth="384"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Style="{StaticResource KlaFoundationWindow}">
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid x:Name="window_body">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Label Content="Renaming Parameters" Style="{StaticResource KlaFoundationPromptLabel}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource KlaSection}">
                        <ItemsControl Style="{StaticResource KlaFieldRows}">
                            <Label Content="Find:" Target="{Binding ElementName=input_find}" Style="{StaticResource KlaCompactFieldLabel}"/>
                            <TextBox x:Name="input_find" Grid.Column="1" Style="{StaticResource KlaCompactFieldInput}" AutomationProperties.Name="Find view name text"/>
                            <Label Grid.Row="2" Content="Replace:" Target="{Binding ElementName=input_replace}" Style="{StaticResource KlaCompactFieldLabel}"/>
                            <TextBox x:Name="input_replace" Grid.Row="2" Grid.Column="1" Style="{StaticResource KlaCompactFieldInput}" AutomationProperties.Name="Replacement view name text"/>
                            <Label Grid.Row="4" Content="Prefix:" Target="{Binding ElementName=input_prefix}" Style="{StaticResource KlaCompactFieldLabel}"/>
                            <TextBox x:Name="input_prefix" Grid.Row="4" Grid.Column="1" Style="{StaticResource KlaCompactFieldInput}" AutomationProperties.Name="View name prefix"/>
                            <Label Grid.Row="6" Content="Suffix:" Target="{Binding ElementName=input_suffix}" Style="{StaticResource KlaCompactFieldLabel}"/>
                            <TextBox x:Name="input_suffix" Grid.Row="6" Grid.Column="1" Style="{StaticResource KlaCompactFieldInput}" AutomationProperties.Name="View name suffix"/>
                        </ItemsControl>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Click="button_uppercase" Content="Uppercase" Style="{StaticResource KlaSecondaryButton}" Margin="{StaticResource KlaPairGap}"/>
                        <Button Click="button_lowercase" Content="Lowercase" Style="{StaticResource KlaSecondaryButton}"/>
                    </StackPanel>
                    <Button x:Name="UI_main_button" Click="button_run" Content="Rename" Style="{StaticResource KlaFoundationMainButton}" Margin="0,8,0,0"/>
                    <Border x:Name="result_panel" Visibility="Collapsed" Margin="0,8,0,0" Style="{StaticResource KlaSection}">
                        <StackPanel>
                            <TextBlock x:Name="result_summary" Style="{StaticResource KlaInfoText}" Margin="0,0,0,8"/>
                            <TextBox x:Name="result_details" Height="140" Style="{StaticResource KlaMultilineReadout}" AutomationProperties.Name="View rename results"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </ContentControl>
</Window>
