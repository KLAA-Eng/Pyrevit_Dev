<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Views: Find and Replace"
    Width="384"
    Height="313"
    MinWidth="384"
    ShowInTaskbar="True"
    Style="{StaticResource klcFdnWindow}"
    WindowStartupLocation="CenterScreen">
    <ContentControl x:Name="window_shell" Style="{StaticResource klcWindowShell}">
        <Grid x:Name="window_body">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Label
                        Margin="0,0,0,8"
                        Content="Renaming Parameters"
                        Style="{StaticResource klcLabelPrompt}" />
                    <Border Style="{StaticResource KlaSection}">
                        <ItemsControl Style="{StaticResource KlaFieldRows}">
                            <Label
                                Content="Find:"
                                Style="{StaticResource klcLabelCentered}"
                                Target="{Binding ElementName=input_find}" />
                            <TextBox
                                x:Name="input_find"
                                Grid.Column="1"
                                AutomationProperties.Name="Find view name text"
                                Style="{StaticResource KlaCompactFieldInput}" />
                            <Label
                                Grid.Row="2"
                                Content="Replace:"
                                Style="{StaticResource klcLabelCentered}"
                                Target="{Binding ElementName=input_replace}" />
                            <TextBox
                                x:Name="input_replace"
                                Grid.Row="2"
                                Grid.Column="1"
                                AutomationProperties.Name="Replacement view name text"
                                Style="{StaticResource KlaCompactFieldInput}" />
                            <Label
                                Grid.Row="4"
                                Content="Prefix:"
                                Style="{StaticResource klcLabelCentered}"
                                Target="{Binding ElementName=input_prefix}" />
                            <TextBox
                                x:Name="input_prefix"
                                Grid.Row="4"
                                Grid.Column="1"
                                AutomationProperties.Name="View name prefix"
                                Style="{StaticResource KlaCompactFieldInput}" />
                            <Label
                                Grid.Row="6"
                                Content="Suffix:"
                                Style="{StaticResource klcLabelCentered}"
                                Target="{Binding ElementName=input_suffix}" />
                            <TextBox
                                x:Name="input_suffix"
                                Grid.Row="6"
                                Grid.Column="1"
                                AutomationProperties.Name="View name suffix"
                                Style="{StaticResource KlaCompactFieldInput}" />
                        </ItemsControl>
                    </Border>
                    <StackPanel
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Click="button_uppercase"
                            Content="Uppercase"
                            Style="{StaticResource KlaButtonSecondary}" />
                        <Button
                            Margin="{StaticResource KlaPairGap}"
                            Click="button_lowercase"
                            Content="Lowercase"
                            Style="{StaticResource KlaButtonSecondary}" />
                    </StackPanel>
                    <Button
                        x:Name="UI_main_button"
                        Margin="0,8,0,0"
                        Click="button_run"
                        Content="Rename"
                        Style="{StaticResource klcButtonDouble}" />
                    <Border
                        x:Name="result_panel"
                        Margin="0,8,0,0"
                        Style="{StaticResource KlaSection}"
                        Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock
                                x:Name="result_summary"
                                Margin="0,0,0,8"
                                Style="{StaticResource KlaInfoText}" />
                            <TextBox
                                x:Name="result_details"
                                Height="140"
                                AutomationProperties.Name="View rename results"
                                Style="{StaticResource KlaMultilineReadout}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </ContentControl>
</Window>
