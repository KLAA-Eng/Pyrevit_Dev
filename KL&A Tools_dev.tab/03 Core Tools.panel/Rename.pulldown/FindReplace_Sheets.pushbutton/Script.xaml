<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sheets: Find and Replace" Width="712" Height="313" MinWidth="712"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Style="{StaticResource KlaFoundationWindow}">
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid x:Name="window_body">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="Sheet Number" Style="{StaticResource KlaFoundationPromptLabel}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource KlaSection}">
                                <ItemsControl Style="{StaticResource KlaFieldRows}">
                                    <Label Content="Find:" Target="{Binding ElementName=input_sheet_number_find}" Style="{StaticResource KlaCompactFieldLabel}"/>
                                    <TextBox x:Name="input_sheet_number_find" Grid.Column="1" Style="{StaticResource KlaCompactFieldInput}" AutomationProperties.Name="Find sheet number text"/>
                                    <Label Grid.Row="2" Content="Replace:" Target="{Binding ElementName=input_sheet_number_replace}" Style="{StaticResource KlaCompactFieldLabel}"/>
                                    <TextBox x:Name="input_sheet_number_replace" Grid.Row="2" Grid.Column="1" Style="{StaticResource KlaCompactFieldInput}" AutomationProperties.Name="Replacement sheet number text"/>
                                    <Label Grid.Row="4" Content="Prefix:" Target="{Binding ElementName=input_sheet_number_prefix}" Style="{StaticResource KlaCompactFieldLabel}"/>
                                    <TextBox x:Name="input_sheet_number_prefix" Grid.Row="4" Grid.Column="1" Style="{StaticResource KlaCompactFieldInput}" AutomationProperties.Name="Sheet number prefix"/>
                                    <Label Grid.Row="6" Content="Suffix:" Target="{Binding ElementName=input_sheet_number_suffix}" Style="{StaticResource KlaCompactFieldLabel}"/>
                                    <TextBox x:Name="input_sheet_number_suffix" Grid.Row="6" Grid.Column="1" Style="{StaticResource KlaCompactFieldInput}" AutomationProperties.Name="Sheet number suffix"/>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Sheet Name" Style="{StaticResource KlaFoundationPromptLabel}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource KlaSection}">
                                <ItemsControl Style="{StaticResource KlaFieldRows}">
                                    <Label Content="Find:" Target="{Binding ElementName=input_sheet_name_find}" Style="{StaticResource KlaCompactFieldLabel}"/>
                                    <TextBox x:Name="input_sheet_name_find" Grid.Column="1" Style="{StaticResource KlaCompactFieldInput}" AutomationProperties.Name="Find sheet name text"/>
                                    <Label Grid.Row="2" Content="Replace:" Target="{Binding ElementName=input_sheet_name_replace}" Style="{StaticResource KlaCompactFieldLabel}"/>
                                    <TextBox x:Name="input_sheet_name_replace" Grid.Row="2" Grid.Column="1" Style="{StaticResource KlaCompactFieldInput}" AutomationProperties.Name="Replacement sheet name text"/>
                                    <Label Grid.Row="4" Content="Prefix:" Target="{Binding ElementName=input_sheet_name_prefix}" Style="{StaticResource KlaCompactFieldLabel}"/>
                                    <TextBox x:Name="input_sheet_name_prefix" Grid.Row="4" Grid.Column="1" Style="{StaticResource KlaCompactFieldInput}" AutomationProperties.Name="Sheet name prefix"/>
                                    <Label Grid.Row="6" Content="Suffix:" Target="{Binding ElementName=input_sheet_name_suffix}" Style="{StaticResource KlaCompactFieldLabel}"/>
                                    <TextBox x:Name="input_sheet_name_suffix" Grid.Row="6" Grid.Column="1" Style="{StaticResource KlaCompactFieldInput}" AutomationProperties.Name="Sheet name suffix"/>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Click="button_uppercase" Content="Uppercase" Style="{StaticResource KlaSecondaryButton}" Margin="{StaticResource KlaPairGap}"/>
                        <Button Click="button_lowercase" Content="Lowercase" Style="{StaticResource KlaSecondaryButton}"/>
                    </StackPanel>
                    <Button x:Name="UI_main_button" Click="button_run" Content="Rename" Style="{StaticResource KlaFoundationMainButton}" Margin="0,8,0,0"/>
                    <Border x:Name="result_panel" Visibility="Collapsed" Margin="0,8,0,0" Style="{StaticResource KlaSection}">
                        <StackPanel>
                            <TextBlock x:Name="result_summary" Style="{StaticResource KlaInfoText}" Margin="0,0,0,8"/>
                            <TextBox x:Name="result_details" Height="140" Style="{StaticResource KlaMultilineReadout}" AutomationProperties.Name="Sheet rename results"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </ContentControl>
</Window>
