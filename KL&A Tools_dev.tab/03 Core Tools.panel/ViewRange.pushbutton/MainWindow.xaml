<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="View Range Editor"
    Width="760"
    MinWidth="760"
    MinHeight="380"
    MaxHeight="600"
    ResizeMode="CanResizeWithGrip"
    SizeToContent="Height"
    Style="{StaticResource klcWindow}"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style
            x:Key="ViewRangeTableHeader"
            BasedOn="{StaticResource klcTextBlockHeading}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="ViewRangeTableCell" BasedOn="{StaticResource xText}" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <ContentControl x:Name="window_shell" Style="{StaticResource klcWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                <RowDefinition Height="*" />
                <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                x:Name="view_message_scroll"
                MinHeight="40"
                MaxHeight="96"
                AutomationProperties.Name="View range instructions"
                Focusable="True"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <TextBlock
                    Style="{StaticResource klcTextBlockMuted}"
                    Text="{Binding message}"
                    TextWrapping="Wrap" />
            </ScrollViewer>
            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid x:Name="grid_main" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.Row="0"
                            Grid.ColumnSpan="8"
                            Background="{StaticResource KlaBorderStrongBrush}"
                            CornerRadius="{StaticResource klcRadButton}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource ViewRangeTableHeader}"
                            Text="Plane" />
                        <TextBlock
                            Grid.Column="3"
                            Style="{StaticResource ViewRangeTableHeader}"
                            Text="Elevation - ft" />
                        <TextBlock
                            Grid.Column="5"
                            Style="{StaticResource ViewRangeTableHeader}"
                            Text="Level Offset" />
                        <TextBlock
                            Grid.Column="7"
                            Style="{StaticResource ViewRangeTableHeader}"
                            Text="Level" />

                        <Rectangle
                            Grid.Row="2"
                            Width="5"
                            Height="20"
                            VerticalAlignment="Center"
                            Fill="{Binding topplane_brush}"
                            RadiusX="3"
                            RadiusY="3" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="4,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="Top Plane" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="3"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="{Binding topplane_elevation}" />
                        <TextBox
                            x:Name="topplane_input"
                            Grid.Row="2"
                            Grid.Column="5"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Right"
                            AutomationProperties.Name="Top plane level offset"
                            IsEnabled="{Binding can_modify_view}"
                            Style="{StaticResource klcTextBox}"
                            Text="{Binding topplane_new_value, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            x:Name="topplane_level_combo"
                            Grid.Row="2"
                            Grid.Column="7"
                            MinWidth="170"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Top plane level"
                            DisplayMemberPath="Name"
                            IsEnabled="{Binding can_modify_view}"
                            ItemsSource="{Binding available_levels}"
                            SelectedValue="{Binding topplane_level_id, Mode=TwoWay}"
                            SelectedValuePath="IdValue"
                            Style="{StaticResource klcComboBoxFilter}" />

                        <Rectangle
                            Grid.Row="4"
                            Width="5"
                            Height="20"
                            VerticalAlignment="Center"
                            Fill="{Binding cutplane_brush}"
                            RadiusX="3"
                            RadiusY="3" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="4,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="Cut Plane" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="3"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="{Binding cutplane_elevation}" />
                        <TextBox
                            x:Name="cutplane_input"
                            Grid.Row="4"
                            Grid.Column="5"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Right"
                            AutomationProperties.Name="Cut plane level offset"
                            IsEnabled="{Binding can_modify_view}"
                            Style="{StaticResource klcTextBox}"
                            Text="{Binding cutplane_new_value, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="7"
                            FontStyle="Italic"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="{Binding cutplane_level_name}" />

                        <Rectangle
                            Grid.Row="6"
                            Width="5"
                            Height="20"
                            VerticalAlignment="Center"
                            Fill="{Binding bottomplane_brush}"
                            RadiusX="3"
                            RadiusY="3" />
                        <TextBlock
                            Grid.Row="6"
                            Grid.Column="1"
                            Margin="4,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="Bottom Plane" />
                        <TextBlock
                            Grid.Row="6"
                            Grid.Column="3"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="{Binding bottomplane_elevation}" />
                        <TextBox
                            x:Name="bottomplane_input"
                            Grid.Row="6"
                            Grid.Column="5"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Right"
                            AutomationProperties.Name="Bottom plane level offset"
                            IsEnabled="{Binding can_modify_view}"
                            Style="{StaticResource klcTextBox}"
                            Text="{Binding bottomplane_new_value, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            x:Name="bottomplane_level_combo"
                            Grid.Row="6"
                            Grid.Column="7"
                            MinWidth="170"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Bottom plane level"
                            DisplayMemberPath="Name"
                            IsEnabled="{Binding can_modify_view}"
                            ItemsSource="{Binding available_levels}"
                            SelectedValue="{Binding bottomplane_level_id, Mode=TwoWay}"
                            SelectedValuePath="IdValue"
                            Style="{StaticResource klcComboBoxFilter}" />

                        <Rectangle
                            Grid.Row="8"
                            Width="5"
                            Height="20"
                            VerticalAlignment="Center"
                            Fill="{Binding viewdepth_brush}"
                            RadiusX="3"
                            RadiusY="3" />
                        <TextBlock
                            Grid.Row="8"
                            Grid.Column="1"
                            Margin="4,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="View Depth" />
                        <TextBlock
                            Grid.Row="8"
                            Grid.Column="3"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="{Binding viewdepth_elevation}" />
                        <TextBox
                            x:Name="viewdepth_input"
                            Grid.Row="8"
                            Grid.Column="5"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Right"
                            AutomationProperties.Name="View depth level offset"
                            IsEnabled="{Binding can_modify_view}"
                            Style="{StaticResource klcTextBox}"
                            Text="{Binding viewdepth_new_value, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            x:Name="viewdepth_level_combo"
                            Grid.Row="8"
                            Grid.Column="7"
                            MinWidth="170"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="View depth level"
                            DisplayMemberPath="Name"
                            IsEnabled="{Binding can_modify_view}"
                            ItemsSource="{Binding available_levels}"
                            SelectedValue="{Binding viewdepth_level_id, Mode=TwoWay}"
                            SelectedValuePath="IdValue"
                            Style="{StaticResource klcComboBoxFilter}" />
                    </Grid>
                    <!--  The status line follows the view model's status_kind: success, warning (default) or error.  -->
                    <TextBlock
                        x:Name="warning"
                        Margin="{StaticResource klcStackGapVert}"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{Binding warning_message}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource klcTextBlockFeedback}" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource klcWarningColor}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding status_kind}" Value="success">
                                        <Setter Property="Foreground" Value="{StaticResource klcSuccessColor}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding status_kind}" Value="error">
                                        <Setter Property="Foreground" Value="{StaticResource klcErrorColor}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding warning_message}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{StaticResource klcBodySpaceSmall}" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button
                    Click="reset_values_click"
                    Content="Reset"
                    Style="{StaticResource klcButtonSec}"
                    ToolTip="Reset to original values" />
                <Button
                    Grid.Row="2"
                    Click="apply_changes_click"
                    Content="Apply Changes"
                    IsEnabled="{Binding can_modify_view}"
                    Style="{StaticResource klcButtonDouble}" />
            </Grid>
        </Grid>
    </ContentControl>
</Window>
