<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="View Range Editor"
    Width="760"
    MinWidth="760"
    MinHeight="340"
    MaxHeight="600"
    ResizeMode="CanResizeWithGrip"
    SizeToContent="Height"
    Style="{StaticResource klcWindow}"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style
            x:Key="ViewRangeTableHeader"
            BasedOn="{StaticResource KlaSectionHeading}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="ViewRangeTableCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <!--
        NOTE (2026-11-01): this body still uses literal rows, margins and a hand-built table; it needs a full layout rework
        on the dialog pattern (token spacer rows, Reset above the main action). Only the status colours, the action row
        height and the pair gap were corrected in this pass.
    -->
    <ContentControl x:Name="window_shell" Style="{StaticResource klcWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                x:Name="view_message_scroll"
                MinHeight="40"
                MaxHeight="96"
                AutomationProperties.Name="View range instructions"
                Focusable="True"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <TextBlock
                    Style="{StaticResource KlaInfoText}"
                    Text="{Binding message}"
                    TextWrapping="Wrap" />
            </ScrollViewer>
            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid x:Name="grid_main" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>
                        <Rectangle
                            Grid.Row="0"
                            Grid.ColumnSpan="5"
                            Fill="{StaticResource KlaBorderStrongBrush}"
                            RadiusX="5"
                            RadiusY="5" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource ViewRangeTableHeader}"
                            Text="Plane" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource ViewRangeTableHeader}"
                            Text="Elevation - ft" />
                        <TextBlock
                            Grid.Column="3"
                            Style="{StaticResource ViewRangeTableHeader}"
                            Text="Level Offset" />
                        <TextBlock
                            Grid.Column="4"
                            Style="{StaticResource ViewRangeTableHeader}"
                            Text="Level" />

                        <Rectangle
                            Grid.Row="1"
                            Width="5"
                            Height="20"
                            VerticalAlignment="Center"
                            Fill="{Binding topplane_brush}"
                            RadiusX="3"
                            RadiusY="3" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="4,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="Top Plane" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="{Binding topplane_elevation}" />
                        <TextBox
                            x:Name="topplane_input"
                            Grid.Row="1"
                            Grid.Column="3"
                            Width="104"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            AutomationProperties.Name="Top plane level offset"
                            IsEnabled="{Binding can_modify_view}"
                            Style="{StaticResource KlaCompactFieldInput}"
                            Text="{Binding topplane_new_value, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            x:Name="topplane_level_combo"
                            Grid.Row="1"
                            Grid.Column="4"
                            Width="170"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Top plane level"
                            DisplayMemberPath="Name"
                            IsEnabled="{Binding can_modify_view}"
                            ItemsSource="{Binding available_levels}"
                            SelectedValue="{Binding topplane_level_id, Mode=TwoWay}"
                            SelectedValuePath="IdValue"
                            Style="{StaticResource KlaCompactComboBox}" />

                        <Rectangle
                            Grid.Row="2"
                            Width="5"
                            Height="20"
                            VerticalAlignment="Center"
                            Fill="{Binding cutplane_brush}"
                            RadiusX="3"
                            RadiusY="3" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="4,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="Cut Plane" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="{Binding cutplane_elevation}" />
                        <TextBox
                            x:Name="cutplane_input"
                            Grid.Row="2"
                            Grid.Column="3"
                            Width="104"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            AutomationProperties.Name="Cut plane level offset"
                            IsEnabled="{Binding can_modify_view}"
                            Style="{StaticResource KlaCompactFieldInput}"
                            Text="{Binding cutplane_new_value, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="4"
                            FontStyle="Italic"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="{Binding cutplane_level_name}" />

                        <Rectangle
                            Grid.Row="3"
                            Width="5"
                            Height="20"
                            VerticalAlignment="Center"
                            Fill="{Binding bottomplane_brush}"
                            RadiusX="3"
                            RadiusY="3" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="4,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="Bottom Plane" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="2"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="{Binding bottomplane_elevation}" />
                        <TextBox
                            x:Name="bottomplane_input"
                            Grid.Row="3"
                            Grid.Column="3"
                            Width="104"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            AutomationProperties.Name="Bottom plane level offset"
                            IsEnabled="{Binding can_modify_view}"
                            Style="{StaticResource KlaCompactFieldInput}"
                            Text="{Binding bottomplane_new_value, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            x:Name="bottomplane_level_combo"
                            Grid.Row="3"
                            Grid.Column="4"
                            Width="170"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Bottom plane level"
                            DisplayMemberPath="Name"
                            IsEnabled="{Binding can_modify_view}"
                            ItemsSource="{Binding available_levels}"
                            SelectedValue="{Binding bottomplane_level_id, Mode=TwoWay}"
                            SelectedValuePath="IdValue"
                            Style="{StaticResource KlaCompactComboBox}" />

                        <Rectangle
                            Grid.Row="4"
                            Width="5"
                            Height="20"
                            VerticalAlignment="Center"
                            Fill="{Binding viewdepth_brush}"
                            RadiusX="3"
                            RadiusY="3" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="4,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="View Depth" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="2"
                            Style="{StaticResource ViewRangeTableCell}"
                            Text="{Binding viewdepth_elevation}" />
                        <TextBox
                            x:Name="viewdepth_input"
                            Grid.Row="4"
                            Grid.Column="3"
                            Width="104"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            AutomationProperties.Name="View depth level offset"
                            IsEnabled="{Binding can_modify_view}"
                            Style="{StaticResource KlaCompactFieldInput}"
                            Text="{Binding viewdepth_new_value, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            x:Name="viewdepth_level_combo"
                            Grid.Row="4"
                            Grid.Column="4"
                            Width="170"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="View depth level"
                            DisplayMemberPath="Name"
                            IsEnabled="{Binding can_modify_view}"
                            ItemsSource="{Binding available_levels}"
                            SelectedValue="{Binding viewdepth_level_id, Mode=TwoWay}"
                            SelectedValuePath="IdValue"
                            Style="{StaticResource KlaCompactComboBox}" />
                    </Grid>
                    <!--  The status line follows the view model's status_kind: success, warning (default) or error.  -->
                    <TextBlock
                        x:Name="warning"
                        Margin="0,8,0,0"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{Binding warning_message}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource klcWarningColor}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding status_kind}" Value="success">
                                        <Setter Property="Foreground" Value="{StaticResource klcSuccessColor}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding status_kind}" Value="error">
                                        <Setter Property="Foreground" Value="{StaticResource klcErrorColor}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding warning_message}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
            <StackPanel
                Grid.Row="4"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Click="apply_changes_click"
                    Content="Apply Changes"
                    IsEnabled="{Binding can_modify_view}"
                    Style="{StaticResource klcButtonDouble}" />
                <Button
                    Margin="{StaticResource KlaPairGap}"
                    Click="reset_values_click"
                    Content="Reset"
                    Style="{StaticResource KlaButtonSecondary}"
                    ToolTip="Reset to original values" />
            </StackPanel>
        </Grid>
    </ContentControl>
</Window>
