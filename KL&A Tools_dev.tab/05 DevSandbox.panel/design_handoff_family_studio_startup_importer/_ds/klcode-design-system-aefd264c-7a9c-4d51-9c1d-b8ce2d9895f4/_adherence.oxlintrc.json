{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chrome/**",
              "components/forms/**",
              "ui_kits/dialogs/**",
              "ui_kits/ribbon/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Audiowide))/i]",
        "message": "Font not provided by the design system. Available: Audiowide."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|onClose|key|ref|className|style|children)$/]",
        "message": "<AlertDialog> doesn't accept that prop. Declared props: title, body, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: size, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|auto)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg' | 'auto'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|disabled|onChange|variant|children|key|ref|className|style|children)$/]",
        "message": "<CheckItem> doesn't accept that prop. Declared props: checked, disabled, onChange, variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckItem'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:bullet|system)$/]",
        "message": "<CheckItem> variant must be one of 'bullet' | 'system'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FieldLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<FieldLabel> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|key|ref|className|style|children)$/]",
        "message": "<FilterField> doesn't accept that prop. Declared props: value, onChange, placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='GroupBorder'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|labelStyle|children|style|key|ref|className|style|children)$/]",
        "message": "<GroupBorder> doesn't accept that prop. Declared props: label, labelStyle, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|children|style|key|ref|className|style|children)$/]",
        "message": "<ListPanel> doesn't accept that prop. Declared props: height, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|name|value|onChange|disabled|children|key|ref|className|style|children)$/]",
        "message": "<RadioItem> doesn't accept that prop. Declared props: checked, name, value, onChange, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='RibbonButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|size|dropdown|active|tooltip|onClick|key|ref|className|style|children)$/]",
        "message": "<RibbonButton> doesn't accept that prop. Declared props: label, icon, size, dropdown, active, tooltip, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='RibbonButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:large|small)$/]",
        "message": "<RibbonButton> size must be one of 'large' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RibbonPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|key|ref|className|style|children)$/]",
        "message": "<RibbonPanel> doesn't accept that prop. Declared props: title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='RibbonStack'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|key|ref|className|style|children)$/]",
        "message": "<RibbonStack> doesn't accept that prop. Declared props: items."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|options|onChange|width|disabled|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: value, options, onChange, width, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeparatorLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|style|key|ref|className|style|children)$/]",
        "message": "<SeparatorLine> doesn't accept that prop. Declared props: tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SeparatorLine'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|native)$/]",
        "message": "<SeparatorLine> tone must be one of 'dark' | 'native'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|width|tone|height|fontSize|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: value, onChange, placeholder, width, tone, height, fontSize, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sage|white)$/]",
        "message": "<TextField> tone must be one of 'sage' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WindowFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:version|leftLabel|leftHref|linkLabel|linkHref|key|ref|className|style|children)$/]",
        "message": "<WindowFooter> doesn't accept that prop. Declared props: version, leftLabel, leftHref, linkLabel, linkHref."
      },
      {
        "selector": "JSXOpeningElement[name.name='WindowFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|width|height|bordered|footer|version|brand|brandMark|onClose|children|key|ref|className|style|children)$/]",
        "message": "<WindowFrame> doesn't accept that prop. Declared props: title, width, height, bordered, footer, version, brand, brandMark, onClose, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='WindowFrame'] > JSXAttribute[name.name='brandMark'] > Literal[value!=/^(?:text|audiowide)$/]",
        "message": "<WindowFrame> brandMark must be one of 'text' | 'audiowide'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WindowHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|brandMark|title|onClose|showClose|key|ref|className|style|children)$/]",
        "message": "<WindowHeader> doesn't accept that prop. Declared props: brand, brandMark, title, onClose, showClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='WindowHeader'] > JSXAttribute[name.name='brandMark'] > Literal[value!=/^(?:text|audiowide)$/]",
        "message": "<WindowHeader> brandMark must be one of 'text' | 'audiowide'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
