<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sheets: Find and Replace"
    Height="289" Width="620"
    WindowStartupLocation="CenterScreen"
    HorizontalAlignment="Center"
    ShowInTaskbar="True"
    WindowStyle="None"
    ResizeMode="NoResize"
    Background="#1A252B">

    <Grid Background="#1A252B">
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MouseDown="header_drag" Background="#1A252B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="86"/>
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0" Width="70" Height="12" Margin="8,0,0,0"
                            VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                            ContentTemplate="{StaticResource KLCodeWordmark}"/>
            <TextBlock x:Name="main_title" Grid.ColumnSpan="3" Text="Sheets: Find and Replace"
                       Style="{StaticResource KLCodeHeaderTitle}" MaxWidth="180"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" Content="Close" Click="button_close"
                    Style="{StaticResource KLCodeCloseButton}"/>
        </Grid>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="5,16,5,0">
            <Grid Margin="5,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <Label Content="SheetNumber" Margin="0" Foreground="{StaticResource text_white}"/>
                    <Border Height="110" BorderBrush="{DynamicResource border_green_dark}"
                            BorderThickness="1" CornerRadius="10">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                            <DockPanel HorizontalAlignment="Left" Margin="2">
                                <TextBlock Text="Find:" Foreground="{StaticResource text_white}" Width="60"/>
                                <TextBox x:Name="input_sheet_number_find" Width="200" Background="{StaticResource header_background}"
                                         Foreground="{StaticResource text_white}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel HorizontalAlignment="Left" Margin="2">
                                <TextBlock Text="Replace:" Foreground="{StaticResource text_white}" Width="60"/>
                                <TextBox x:Name="input_sheet_number_replace" Width="200" Background="{StaticResource header_background}"
                                         Foreground="{StaticResource text_white}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel HorizontalAlignment="Left" Margin="2">
                                <TextBlock Text="Prefix:" Foreground="{StaticResource text_white}" Width="60"/>
                                <TextBox x:Name="input_sheet_number_prefix" Width="200" Background="{StaticResource header_background}"
                                         Foreground="{StaticResource text_white}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel HorizontalAlignment="Left" Margin="2">
                                <TextBlock Text="Suffix:" Foreground="{StaticResource text_white}" Width="60"/>
                                <TextBox x:Name="input_sheet_number_suffix" Width="200" Background="{StaticResource header_background}"
                                         Foreground="{StaticResource text_white}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <Label Content="SheetName" Margin="0" Foreground="{StaticResource text_white}"/>
                    <Border Height="110" BorderBrush="{DynamicResource border_green_dark}"
                            BorderThickness="1" CornerRadius="10">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                            <DockPanel HorizontalAlignment="Left" Margin="2">
                                <TextBlock Text="Find:" Foreground="{StaticResource text_white}" Width="60"/>
                                <TextBox x:Name="input_sheet_name_find" Width="200" Background="{StaticResource header_background}"
                                         Foreground="{StaticResource text_white}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel HorizontalAlignment="Left" Margin="2">
                                <TextBlock Text="Replace:" Foreground="{StaticResource text_white}" Width="60"/>
                                <TextBox x:Name="input_sheet_name_replace" Width="200" Background="{StaticResource header_background}"
                                         Foreground="{StaticResource text_white}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel HorizontalAlignment="Left" Margin="2">
                                <TextBlock Text="Prefix:" Foreground="{StaticResource text_white}" Width="60"/>
                                <TextBox x:Name="input_sheet_name_prefix" Width="200" Background="{StaticResource header_background}"
                                         Foreground="{StaticResource text_white}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel HorizontalAlignment="Left" Margin="2">
                                <TextBlock Text="Suffix:" Foreground="{StaticResource text_white}" Width="60"/>
                                <TextBox x:Name="input_sheet_name_suffix" Width="200" Background="{StaticResource header_background}"
                                         Foreground="{StaticResource text_white}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Click="button_uppercase" Content="UPPERCASE" Width="104" Height="26"
                        FontSize="12" Margin="0,0,8,0" Style="{StaticResource KLCodeActionButton}"/>
                <Button Click="button_lowercase" Content="lowercase" Width="104" Height="26"
                        FontSize="12" Style="{StaticResource KLCodeActionButton}"/>
            </StackPanel>

            <Button x:Name="UI_main_button" Click="button_run" Content="Rename" Width="210" Height="32"
                    Margin="0,8,0,16" HorizontalAlignment="Center"
                    Style="{StaticResource KLCodeActionButton}"/>
        </StackPanel>

        <Grid Grid.Row="2" Style="{StaticResource KLCodeFooterGrid}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                <Hyperlink NavigateUri="https://forms.cloud.microsoft/r/HjuggSZqyU"
                           RequestNavigate="Hyperlink_RequestNavigate"
                           Style="{StaticResource KLCodeFooterLink}">Prototype</Hyperlink>
            </TextBlock>
            <TextBlock x:Name="footer_version" Grid.Column="1" Text="Version: 1.0"
                       Style="{StaticResource KLCodeFooterVersion}"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                <Hyperlink NavigateUri="https://forms.microsoft.com/Pages/ResponsePage.aspx?id=Bfmd9K3MFkqVWdMqprbPvvfxx29Ur-NGhLTDKxuFAqVUMU1OMUpRWDRKUDBMNEFEMlQ2SEJJNFdCUi4u"
                           RequestNavigate="Hyperlink_RequestNavigate"
                           Style="{StaticResource KLCodeFooterLink}">Outreach</Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
