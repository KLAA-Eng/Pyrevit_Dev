<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevSandbox UI Gallery" Height="520" Width="900"
        MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Background="#1A252B">
    <Grid Background="#1A252B">
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <Grid MouseDown="header_drag"
              Background="{StaticResource header_background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="KLCode"
                       Margin="5,0,0,0"
                       FontSize="14px"
                       FontWeight="Heavy"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource text_white}"/>
            <TextBlock x:Name="main_title"
                       Grid.Column="1"
                       Text="DevSandbox UI Gallery"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource text_white}"/>
            <Button Grid.Column="2"
                    Content="Close"
                    Width="60" Height="20"
                    FontSize="10"
                    Click="button_close"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"/>
        </Grid>

    <DockPanel Grid.Row="1" Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Open KL&amp;A dialogs and repo-used pyRevit form patterns. Seeded previews use fictional data; host/model-dependent forms are cataloged but disabled. Gallery previews never modify the Revit document."
                       TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBox x:Name="FilterBox" Height="25" TextChanged="filter_changed"
                     ToolTip="Filter by dialog family, title, or description" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="LaunchButton" Content="Open Selected Window" Width="155" Margin="0,0,8,0" Click="launch_selected" />
            <Button Content="Close" Width="80" Click="close_window" />
        </StackPanel>
        <DataGrid x:Name="EntriesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="selection_changed" CanUserAddRows="False"
                  Background="{StaticResource header_background}"
                  Foreground="{StaticResource text_white}"
                  BorderBrush="{StaticResource border_green_dark}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource border_green_dark}"
                  RowBackground="{StaticResource header_background}"
                  AlternatingRowBackground="#FF131313"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  CanUserResizeRows="False">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource border_green_dark}"/>
                    <Setter Property="Foreground" Value="{StaticResource text_white}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="BorderBrush" Value="{StaticResource header_background}"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{StaticResource header_background}"/>
                    <Setter Property="Foreground" Value="{StaticResource text_white}"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource text_white}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource border_green_dark}"/>
                    <Setter Property="Padding" Value="6,3"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource button_bg_hover}"/>
                            <Setter Property="Foreground" Value="{StaticResource button_fg_normal}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Family" Binding="{Binding Category}" Width="120" />
                <DataGridTextColumn Header="Window" Binding="{Binding Title}" Width="170" />
                <DataGridTextColumn Header="Relative Path" Binding="{Binding RelativePath}" Width="260" />
                <DataGridTextColumn Header="Called By" Binding="{Binding CalledBy}" Width="260" />
                <DataGridTextColumn Header="Data" Binding="{Binding SampleData}" Width="160" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="240" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>

        <Grid Grid.Row="2" Background="{StaticResource header_background}">
            <TextBlock Text="UI Gallery"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource text_gray}"/>
        </Grid>
    </Grid>
</Window>
