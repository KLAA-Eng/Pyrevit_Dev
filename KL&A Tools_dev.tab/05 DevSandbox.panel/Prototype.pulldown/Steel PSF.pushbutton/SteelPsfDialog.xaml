<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steel PSF" Width="432" Height="576" MinWidth="432" MinHeight="576" MaxHeight="576"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Style="{StaticResource KlaFoundationWindow}">
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource KlaFilterRow}"/><RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="4"/>
                <RowDefinition Height="*"/><RowDefinition Height="8"/>
                <RowDefinition Height="{StaticResource KlaCompactRow}"/><RowDefinition Height="8"/>
                <RowDefinition Height="{StaticResource KlaCompactRow}"/><RowDefinition Height="8"/>
                <RowDefinition Height="{StaticResource KlaControlRow}"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image x:Name="filter_icon" Source="{StaticResource KlaIconSearch}" AutomationProperties.Name="Search" Width="16" Height="16" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBox x:Name="textbox_filter" Grid.Column="2" TextChanged="text_filter_updated" Style="{StaticResource KlaFoundationFilter}" AutomationProperties.Name="Search stories"/>
            </Grid>
            <Label x:Name="text_label" Grid.Row="2" Content="Select Stories to Review:" Target="{Binding ElementName=main_ListBox}" Style="{StaticResource KlaFoundationPromptLabel}"/>
            <ListBox x:Name="main_ListBox" Grid.Row="4" SelectionMode="Single" Style="{StaticResource KlaFoundationList}" AutomationProperties.Name="Stories to review">
                <ListBox.ItemTemplate><DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Checked="UIe_ItemChecked" Style="{StaticResource KlaFoundationCheckBox}"/>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Select All" Click="button_select_all" Style="{StaticResource KlaFoundationButton}" Margin="{StaticResource KlaPairGap}"/>
                <Button Content="Select None" Click="button_select_none" Style="{StaticResource KlaFoundationButton}"/>
            </StackPanel>
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Initialize CSV" Click="button_initialize_csv" Style="{StaticResource KlaSecondaryButton}" Margin="{StaticResource KlaPairGap}"/>
                <Button Content="Append CSV" Click="button_append_csv" Style="{StaticResource KlaSecondaryButton}"/>
            </StackPanel>
            <Button x:Name="button_main" Grid.Row="10" Content="Review Selected Stories" Click="button_select" Style="{StaticResource KlaFoundationMainButton}"/>
        </Grid>
    </ContentControl>
</Window>
