<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Steel PSF"
    Height="610" Width="430"
    MinWidth="430"
    MinHeight="610" MaxHeight="610"
    WindowStartupLocation="CenterScreen"
    HorizontalAlignment="Center"
    ShowInTaskbar="True"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="#1A252B">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                <GradientStop Color="#33286048" Offset="0" />
                <GradientStop Color="#33307050" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="45"/>
            <RowDefinition/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <Grid MouseDown="header_drag" Background="{StaticResource header_background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                <TextBlock Margin="5,0,0,0"
                           FontSize="14px"
                           FontWeight="Heavy"
                           Foreground="{StaticResource text_white}">
                    KLCode
                </TextBlock>
            </DockPanel>

            <TextBlock x:Name="main_title"
                       Text="Steel PSF"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource text_white}" />

            <Button Content="Close"
                    Grid.Column="2"
                    Width="60" Height="20"
                    FontSize="10"
                    Click="button_close"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right" />
        </Grid>

        <DockPanel Grid.Row="1">
            <Label Content="Search"
                   VerticalAlignment="Top"
                   Height="26"
                   Foreground="{StaticResource text_white}"
                   Margin="5,5,5,5"/>

            <TextBox x:Name="textbox_filter"
                     Text=""
                     Height="22"
                     VerticalAlignment="Top"
                     Foreground="{StaticResource text_white}"
                     Background="{StaticResource header_background}"
                     Margin="0,8,10,5"
                     FontSize="14"
                     BorderBrush="{StaticResource border_magenta}"
                     TextChanged="text_filter_updated" />
        </DockPanel>

        <StackPanel Grid.Row="2"
                    VerticalAlignment="Top"
                    Margin="10,5,10,5">

            <Separator Background="{StaticResource border_magenta}"/>

            <Label x:Name="text_label"
                   Content="Select stories to review:"
                   Foreground="{StaticResource text_white}"/>

            <ListBox x:Name="main_ListBox"
                     Height="330"
                     Background="{StaticResource header_background}"
                     SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderBrush="{StaticResource border_magenta}">

                <ListBox.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="{StaticResource border_magenta}"/>
                        <Setter Property="Foreground" Value="{StaticResource border_magenta}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource header_background}"/>
                        <Setter Property="Opacity" Value="0.9"/>
                        <Setter Property="Margin" Value="3"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid x:Name="Bg" SnapsToDevicePixels="true">
                                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Background="{TemplateBinding Background}"
                                                Grid.Row="1"
                                                CornerRadius="10"/>
                                        <Track x:Name="PART_Track"
                                               IsDirectionReversed="true"
                                               IsEnabled="{TemplateBinding IsMouseOver}"
                                               Grid.Row="1">
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ScrollBarThumbVertical}" Margin="2"/>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="ListBox">
                        <Style.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Style.Resources>
                    </Style>
                </ListBox.Resources>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Background="#286048"
                                  Foreground="{StaticResource text_white}"
                                  IsChecked="{Binding IsChecked}"
                                  Checked="UIe_ItemChecked">
                            <TextBlock Text="{Binding Name}"/>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Select All"
                        Click="button_select_all"
                        Height="20"
                        Width="100"
                        Margin="5" />
                <Button Content="Select None"
                        Click="button_select_none"
                        Height="20"
                        Width="100"
                        Margin="5" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Initialize CSV"
                        Click="button_initialize_csv"
                        Height="20"
                        Width="100"
                        Margin="5" />
                <Button Content="Append CSV"
                        Click="button_append_csv"
                        Height="20"
                        Width="100"
                        Margin="5" />
            </StackPanel>

            <Button x:Name="button_main"
                    Content="Review Selected Stories"
                    Click="button_select"
                    Height="30"
                    Width="230"
                    Margin="5" />
        </StackPanel>

        <Grid Grid.Row="3" Background="{StaticResource header_background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="footer_version"
                       Text="DevSandbox Prototype"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource text_gray}" />
        </Grid>
    </Grid>
</Window>
