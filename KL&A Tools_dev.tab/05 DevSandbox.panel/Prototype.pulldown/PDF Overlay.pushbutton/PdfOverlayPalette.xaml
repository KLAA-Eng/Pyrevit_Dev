<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PDF Overlay"
    Height="560" Width="340"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="True"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="#1A252B">

    <Grid Background="#1A252B">

        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <Grid MouseDown="header_drag" Background="#1A252B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="86"/>
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Width="70" Height="12" Margin="8,0,0,0"
                            VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                            ContentTemplate="{StaticResource KLCodeWordmark}"/>

            <TextBlock Text="PDF Overlay"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Style="{StaticResource KLCodeHeaderTitle}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource text_white}" />

            <Button Content="Close"
                    Grid.Column="2"
                    Click="button_close"
                    Style="{StaticResource KLCodeCloseButton}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="12,6,12,0">

            <Label Content="Overlay in this model:" Foreground="{StaticResource text_white}" FontSize="12" Padding="0,0,0,2"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="72"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="overlay_list" Height="24" SelectionChanged="overlay_selected"/>
                <Button Grid.Column="1" Content="Refresh" Click="button_refresh" Height="24" Margin="6,0,0,0"
                        FontSize="12" Style="{StaticResource KLCodeActionButton}"/>
            </Grid>
            <UniformGrid Columns="3" Margin="0,6,0,0">
                <Button Content="Place in View" Click="button_place" Height="24" Margin="0,0,3,0"
                        FontSize="11" Style="{StaticResource KLCodeActionButton}"/>
                <Button Content="Replace PDF..." Click="button_replace" Height="24" Margin="3,0,3,0"
                        FontSize="11" Style="{StaticResource KLCodeActionButton}"/>
                <Button Content="Remove" Click="button_remove" Height="24" Margin="3,0,0,0"
                        FontSize="11" Style="{StaticResource KLCodeActionButton}"/>
            </UniformGrid>

            <Separator Background="{StaticResource border_green_dark}" Margin="0,10,0,6"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Content="Page" Foreground="{StaticResource text_white}" FontSize="12" VerticalAlignment="Center" Padding="0"/>
                <TextBox x:Name="page_box" Grid.Column="1" Text="1" Height="24" VerticalContentAlignment="Center"/>
                <Label Grid.Column="2" Content="DPI" Foreground="{StaticResource text_white}" FontSize="12"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Padding="0,0,6,0"/>
                <ComboBox x:Name="dpi_list" Grid.Column="3" Height="24"/>
                <Button Grid.Column="4" Content="Import PDF..." Click="button_import" Height="24" Margin="6,0,0,0"
                        FontSize="12" Style="{StaticResource KLCodeActionButton}"/>
            </Grid>

            <Button Content="Align (2 Points)" Click="button_align" Height="28" Margin="0,8,0,0"
                    FontSize="12" Style="{StaticResource KLCodeActionButton}"/>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Content="Match within" Foreground="{StaticResource text_white}" FontSize="12"
                       VerticalAlignment="Center" Padding="0,0,6,0"/>
                <TextBox x:Name="tolerance_feet_box" Grid.Column="1" Text="2.5" Height="24"
                         VerticalContentAlignment="Center"
                         ToolTip="How far a PDF size label can sit from a member line, in feet."/>
                <Label Grid.Column="2" Content="ft and" Foreground="{StaticResource text_white}" FontSize="12"
                       VerticalAlignment="Center" Padding="4,0,6,0"/>
                <TextBox x:Name="tolerance_angle_box" Grid.Column="3" Text="15" Height="24"
                         VerticalContentAlignment="Center"
                         ToolTip="How far a label's direction can turn from the member's, in degrees."/>
                <Label Grid.Column="4" Content="degrees" Foreground="{StaticResource text_white}" FontSize="12"
                       VerticalAlignment="Center" Padding="4,0,0,0"/>
            </Grid>
            <Button Content="Check Members" Click="button_check" Height="28" Margin="0,6,0,0"
                    FontSize="12" Style="{StaticResource KLCodeActionButton}"/>

            <Separator Background="{StaticResource border_green_dark}" Margin="0,10,0,6"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <Label Content="Opacity" Foreground="{StaticResource text_white}" FontSize="12" Padding="0"/>
                <TextBlock x:Name="opacity_text" Grid.Column="1" Text="60%" Foreground="{StaticResource text_white}"
                           FontSize="12" HorizontalAlignment="Right"/>
            </Grid>
            <Slider x:Name="opacity_slider" Minimum="0" Maximum="100" Value="60" SmallChange="5" LargeChange="10"
                    TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Margin="0,4,0,0"
                    ValueChanged="opacity_changed"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label Content="Color" Foreground="{StaticResource text_white}" FontSize="12" VerticalAlignment="Center" Padding="0"/>
                <ComboBox x:Name="tint_list" Grid.Column="1" Height="24" SelectionChanged="tint_selected"/>
            </Grid>

            <CheckBox x:Name="visible_check" Content="Show overlay in active view" IsChecked="True" Margin="0,10,0,0"
                      Foreground="{StaticResource text_white}" FontSize="12"
                      Checked="visibility_changed" Unchecked="visibility_changed"/>

            <TextBlock x:Name="status_text" Text="" Foreground="{StaticResource text_gray}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,10,0,0" Height="64"/>
        </StackPanel>

        <Grid Grid.Row="2" Style="{StaticResource KLCodeFooterGrid}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                <Hyperlink NavigateUri="https://forms.cloud.microsoft/r/HjuggSZqyU"
                           RequestNavigate="Hyperlink_RequestNavigate"
                           Style="{StaticResource KLCodeFooterLink}">Prototype</Hyperlink>
            </TextBlock>

            <TextBlock Style="{StaticResource KLCodeFooterVersion}"
                       Text="DevSandbox Prototype"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                <Hyperlink NavigateUri="https://forms.microsoft.com/Pages/ResponsePage.aspx?id=Bfmd9K3MFkqVWdMqprbPvvfxx29Ur-NGhLTDKxuFAqVUMU1OMUpRWDRKUDBMNEFEMlQ2SEJJNFdCUi4u"
                           RequestNavigate="Hyperlink_RequestNavigate"
                           Style="{StaticResource KLCodeFooterLink}">Outreach</Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
