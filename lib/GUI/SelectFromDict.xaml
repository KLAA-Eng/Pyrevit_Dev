<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select From Dict" Width="432" Height="576" MinWidth="432" MinHeight="576" MaxHeight="576"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Style="{StaticResource KlaFoundationWindow}">
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <ItemsControl x:Name="window_body" Style="{StaticResource KlaFilteredCheckList}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource KlaGridSpace16}"/><ColumnDefinition Width="{StaticResource KlaGridSpace8}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image x:Name="filter_icon" Source="{StaticResource KlaIconSearch}" AutomationProperties.Name="Search" Width="{StaticResource KlaIconSize}" Height="{StaticResource KlaIconSize}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBox x:Name="textbox_filter" Grid.Column="2" TextChanged="text_filter_updated" Style="{StaticResource KlaFoundationFilter}" AutomationProperties.Name="Filter available elements"/>
            </Grid>
            <Label x:Name="text_label" Grid.Row="2" Content="Select Elements:" Target="{Binding ElementName=main_ListBox}" Style="{StaticResource KlaFoundationPromptLabel}"/>
            <ListBox x:Name="main_ListBox" Grid.Row="4" SelectionMode="Single" Style="{StaticResource KlaFoundationList}" AutomationProperties.Name="Available elements">
                <ListBox.ItemTemplate><DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="UIe_ItemChecked" Style="{StaticResource KlaFoundationCheckBox}"/>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="UI_Buttons_all_none" Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Select All" Click="button_select_all" Style="{StaticResource KlaFoundationButton}" Margin="{StaticResource KlaPairGap}"/>
                <Button Content="Select None" Click="button_select_none" Style="{StaticResource KlaFoundationButton}"/>
            </StackPanel>
            <Button x:Name="button_main" Grid.Row="8" Content="Select" Click="button_select" Style="{StaticResource KlaFoundationMainButton}" IsDefault="True"/>
        </ItemsControl>
    </ContentControl>
</Window>
