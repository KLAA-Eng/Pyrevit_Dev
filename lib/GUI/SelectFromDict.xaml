<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Select From Dict"
    Height="550" Width="400"
    MinWidth="400"
    MinHeight="550" MaxHeight="550"
    WindowStartupLocation="CenterScreen"
    HorizontalAlignment="Center"
    ShowInTaskbar="True"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="#1A252B">

    <!--MAIN-->
    <Grid Background="#1A252B">


        <Grid.RowDefinitions>

            <RowDefinition Height="24"/>
            <RowDefinition Height="32"/>
            <RowDefinition/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!--HEADER START-->
        <Grid   MouseDown="header_drag"
                Background="{StaticResource header_background}"
                Grid.ColumnSpan="2">
            <!--HEADER GRID-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="86"/>
            </Grid.ColumnDefinitions>

            <!--LOGO-->
            <ContentControl Grid.Column="0" Width="70" Height="12" Margin="8,0,0,0"
                            VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                            ContentTemplate="{StaticResource KLCodeWordmark}"/>
            <DockPanel  Grid.Column="0"
                        Grid.ColumnSpan="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed">


                <TextBlock
                    Margin="5,0,0,0"
                    FontSize="14px"
                    FontWeight="Heavy"
                    Foreground="{StaticResource text_white}">
                    KLCode
                </TextBlock>
            </DockPanel>

            <!--__TITLE__-->
            <TextBlock x:Name="main_title"
                Text="__title__"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Foreground="{StaticResource text_white}"
                MaxWidth="180"
                TextTrimming="CharacterEllipsis"
                />

            <!--CLOSE-->
            <Button
                Content="Close"
                Grid.Column="2"
                Width="60" Height="18"
                FontSize="10"
                Click="button_close"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Style="{StaticResource KLCodeCloseButton}"
                    />
        </Grid>
        <!--HEADER END-->



        <!--FILTER START-->
        <Grid Grid.Row="1" Margin="8,4,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="../_icons/search_16px_light.png" Width="16" Height="16"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="None" SnapsToDevicePixels="True"/>
            <Border Grid.Column="2" Background="{StaticResource window_background}" BorderBrush="{StaticResource text_green}"
                    BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                <TextBox x:Name="textbox_filter" Text="" TextChanged="text_filter_updated"
                         Style="{StaticResource KLCodeFilterTextBox}"/>
            </Border>
        </Grid>
        <!--FILTER END-->

        <!--LISTBOX START-->
        <StackPanel Grid.Row="2"
                    VerticalAlignment="Top"
                    Margin="10,5,10,5">

            <Separator Background="{StaticResource border_green_dark}"/>

            <Label x:Name="text_label"  Content="Select Elements:"
                           Foreground="{StaticResource text_white}"/>

            <ListBox x:Name="main_ListBox"
                         Height="350" Grid.Row="0"
                         Background="{StaticResource header_background}"
                         SelectionMode="Single"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         BorderBrush="{StaticResource border_green_dark}"
                         >

                <ListBox.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="{StaticResource border_green_dark}"/>
                        <Setter Property="Foreground" Value="{StaticResource border_green_dark}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource header_background}"/>
                        <Setter Property="Opacity" Value="0.9"/>
                        <Setter Property="Margin" Value="3"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid x:Name="Bg"
                                              SnapsToDevicePixels="true">
                                        <Border BorderBrush     = "{TemplateBinding BorderBrush}"
                                                    BorderThickness = "{TemplateBinding BorderThickness}"
                                                    Background      = "{TemplateBinding Background}"

                                                    Grid.Row        = "1"
                                                    CornerRadius="10"/>

                                        <Track x:Name="PART_Track"
                                                   IsDirectionReversed="true"
                                                   IsEnabled="{TemplateBinding IsMouseOver}"
                                                   Grid.Row="1">
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ScrollBarThumbVertical}"
                                                           Margin="2"/>
                                            </Track.Thumb>
                                        </Track>

                                    </Grid>

                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="ListBox">
                        <Style.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Style.Resources>
                    </Style>
                </ListBox.Resources>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox  Background="#286048" Foreground="{StaticResource text_white}" IsChecked="{Binding IsChecked}"  Checked="UIe_ItemChecked" >
                            <TextBlock Text="{Binding Name}"/>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>


            </ListBox>

            <!--BUTTONS START-->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" x:Name="UI_Buttons_all_none">
                <!--BUTTON_1-->
                <Button Content="Select All"
                        Click="button_select_all"
                        Height="20"
                        Width="100"
                        Margin="5"
                        />
                <!--BUTTON_2-->
                <Button Content="Select None"
                        Click="button_select_none"
                        Height="20"
                        Width="100"
                        Margin="5"
                        />
            </StackPanel>
            <!--BUTTONS END-->

            <!--BUTTON_2-->
            <Button x:Name="button_main"
                Content="Select"
                        Click="button_select"
                        Height="30"
                        Width="210"
                        Margin="5"
                        />

        </StackPanel>
        <!--LISTBOX END-->

        <!--FOOTER START-->
        <Grid Grid.Row="3" Background="{StaticResource header_background}">
            <!--FOOTER GRID-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!--IMAGE-->
            <TextBlock>
                <Hyperlink  NavigateUri="https://www.learnrevitapi.com" RequestNavigate="Hyperlink_RequestNavigate">
                               <Image  Height="20"   Margin="1"  HorizontalAlignment="Left"   VerticalAlignment="Top"
                                   Source="https://www.learnrevitapi.com/static/img_new/logo/logo_learnrevitapi.png" />
                </Hyperlink>
            </TextBlock>



            <!--VERSION-->
            <TextBlock x:Name="footer_version"
              Text="Version: 1.0"
              Grid.Column="1"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Foreground="{StaticResource text_gray}"
    />

            <!--Ko-Fi-->
            <TextBlock  Grid.Column="2"
              VerticalAlignment="Center"
              HorizontalAlignment="Right"
              Margin="0,0,10,0">
              <Hyperlink
                  RequestNavigate="Hyperlink_RequestNavigate"
                  NavigateUri="https://forms.microsoft.com/Pages/ResponsePage.aspx?id=Bfmd9K3MFkqVWdMqprbPvvfxx29Ur-NGhLTDKxuFAqVUMU1OMUpRWDRKUDBMNEFEMlQ2SEJJNFdCUi4u"
                  FontWeight="Medium"
                  Foreground="{StaticResource button_bg_hover}">
                  Outreach
              </Hyperlink>
            </TextBlock>
        </Grid>
        <!--FOOTER END-->
    </Grid>
</Window>
