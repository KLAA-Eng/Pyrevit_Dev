<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="White">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  
            <!--  search bar  -->
            <RowDefinition Height="Auto" />  
            <!--  check/uncheck/toggle  -->
            <RowDefinition Height="*" />     
            <!--  parameter list  -->
            <RowDefinition Height="Auto" />  
            <!--  category filter  -->
            <RowDefinition Height="Auto" />  
            <!--  source buttons  -->
            <RowDefinition Height="Auto" />  
            <!--  paste buttons  -->
        </Grid.RowDefinitions>

        <!--  ── Row 0: Search bar ─────────────────────────────────────  -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <ToggleButton
                x:Name="regexToggle_b"
                Width="24"
                Height="24"
                Margin="0,0,6,0"
                Click="toggle_regex"
                Content="{DynamicResource filterIcon}"
                DockPanel.Dock="Left"
                ToolTip="{DynamicResource TooltipToggleRegex}" />
            <Grid>
                <TextBox
                    x:Name="search_tb"
                    Height="24"
                    Padding="5,0,26,0"
                    VerticalContentAlignment="Center"
                    TextChanged="search_changed" />
                <Button
                    x:Name="clrsearch_b"
                    Width="22"
                    Height="22"
                    Margin="0,0,1,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Click="clear_search"
                    Style="{DynamicResource ClearButton}"
                    Visibility="Collapsed">
                    <Canvas Width="16" Height="16">
                        <Path
                            Canvas.Left="1"
                            Canvas.Top="1"
                            Data="{DynamicResource CloseSearchGeometry}"
                            Fill="DimGray">
                            <Path.LayoutTransform>
                                <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                            </Path.LayoutTransform>
                        </Path>
                    </Canvas>
                </Button>
            </Grid>
        </DockPanel>

        <!--  ── Row 1: Check / Uncheck / Toggle ──────────────────────  -->
        <UniformGrid
            Grid.Row="1"
            Margin="0,0,0,6"
            Rows="1">
            <Button
                Height="22"
                Margin="0,0,2,0"
                Click="check_all"
                Content="{DynamicResource BtnCheckAll}" />
            <Button
                Height="22"
                Margin="2,0,2,0"
                Click="uncheck_all"
                Content="{DynamicResource BtnUncheckAll}" />
            <Button
                Height="22"
                Margin="2,0,0,0"
                Click="toggle_all"
                Content="{DynamicResource BtnToggleAll}" />
        </UniformGrid>

        <!--  ── Row 2: Parameter history list ────────────────────────  -->
        <ListView
            x:Name="paramListView"
            Grid.Row="2"
            Margin="0,0,0,6"
            SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <!--  checkbox column  -->
                    <GridViewColumn Width="32">
                        <GridViewColumn.Header>
                            <TextBlock Text="" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Click="checkbox_click" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!--  parameter name  -->
                    <GridViewColumn Width="130" DisplayMemberBinding="{Binding Name}">
                        <GridViewColumn.Header>
                            <TextBlock Text="{DynamicResource ColParameter}" />
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <!--  display value  -->
                    <GridViewColumn Width="115" DisplayMemberBinding="{Binding DisplayValue}">
                        <GridViewColumn.Header>
                            <TextBlock Text="{DynamicResource ColValue}" />
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <!--  category: single name or "multiple"  -->
                    <GridViewColumn
                        x:Name="categoryColumn"
                        Width="100"
                        DisplayMemberBinding="{Binding Category}">
                        <GridViewColumn.Header>
                            <TextBlock Text="{DynamicResource ColCategory}" />
                        </GridViewColumn.Header>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!--  ── Row 3: Category selection filter toggle ───────────────  -->
        <CheckBox
            x:Name="categoryFilterCheck"
            Grid.Row="3"
            Margin="2,0,0,6"
            Content="{DynamicResource ChkRestrictCategories}"
            ToolTip="{DynamicResource TooltipRestrictCategories}" />

        <!--  ── Row 4: Load-source buttons ───────────────────────────────────  -->
        <UniformGrid
            Grid.Row="4"
            Margin="0,0,0,4"
            Rows="1">

            <!--  tag-multiple: parameters are tagged key/value pairs on an element  -->
            <Button
                Height="28"
                Margin="0,0,2,0"
                Click="load_from_element"
                ToolTip="{DynamicResource TooltipElemParams}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox
                        Width="15"
                        Height="15"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{DynamicResource ElemParamsGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource BtnElemParams}" />
                </StackPanel>
            </Button>

            <!--  eye-outline: reading / inspecting the active view  -->
            <Button
                x:Name="loadViewFiltersBtn"
                Height="28"
                Margin="2,0,2,0"
                Click="load_from_view_filters"
                ToolTip="{DynamicResource TooltipViewFilters}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox
                        Width="15"
                        Height="15"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{DynamicResource ViewFiltersGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource BtnViewFilters}" />
                </StackPanel>
            </Button>

            <!--  filter (funnel): filtering down to the most-common value  -->
            <Button
                x:Name="loadFilterElemBtn"
                Height="28"
                Margin="2,0,0,0"
                Click="load_from_filter_and_element"
                ToolTip="{DynamicResource TooltipFilterElem}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox
                        Width="15"
                        Height="15"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{DynamicResource FilterElemGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource BtnFilterElem}" />
                </StackPanel>
            </Button>

        </UniformGrid>

        <!--  ── Row 5: Paste buttons ──────────────────────────────────────────  -->
        <UniformGrid Grid.Row="5" Rows="1">

            <!--  cursor-default: clicking one element at a time  -->
            <Button
                x:Name="pasteSingleBtn"
                Height="28"
                Margin="0,0,2,0"
                Click="paste_single"
                IsEnabled="False"
                ToolTip="{DynamicResource TooltipPasteOne}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox
                        Width="15"
                        Height="15"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{DynamicResource PasteSingleGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource BtnPasteOne}" />
                </StackPanel>
            </Button>

            <!--  crop-free: the four corner handles of a drag-selection rectangle  -->
            <Button
                x:Name="pasteRectBtn"
                Height="28"
                Margin="2,0,2,0"
                Click="paste_rectangle"
                IsEnabled="False"
                ToolTip="{DynamicResource TooltipPasteBox}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox
                        Width="15"
                        Height="15"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{DynamicResource PasteRectGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource BtnPasteBox}" />
                </StackPanel>
            </Button>

            <!--  check-all: multiple items already selected, paste to all at once  -->
            <Button
                x:Name="pasteSelBtn"
                Height="28"
                Margin="2,0,0,0"
                Click="paste_selection"
                IsEnabled="False"
                ToolTip="{DynamicResource TooltipPasteSel}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox
                        Width="15"
                        Height="15"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{DynamicResource PasteSelGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource BtnPasteSel}" />
                </StackPanel>
            </Button>

        </UniformGrid>
    </Grid>
</UserControl>
