<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Text" Width="560" Height="180" MinWidth="480" MinHeight="0" MaxHeight="560" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" Style="{StaticResource KlaWindow}" >
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="prompt_scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="prompt_fields">
                    <Grid>
                        <TextBox x:Name="input_text" Style="{StaticResource KlaTextPromptInput}" TextChanged="text_changed" AcceptsReturn="False" AcceptsTab="False" AutomationProperties.Name="Text value"/>
                        <TextBlock x:Name="input_placeholder" Text="[ENTER TEXT]" IsHitTestVisible="False"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="{StaticResource KlaTextPromptInputFontSize}" FontWeight="Bold"
                                   Foreground="{StaticResource KlaMutedBrush}">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=input_text}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock x:Name="validation_text" TextWrapping="Wrap" Foreground="{StaticResource KlaErrorBrush}" Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="prompt_actions" Grid.Row="1" Margin="{StaticResource KlaActionTopGap}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
    <Button x:Name="accept_button" Content="OK" Click="accept_text" Style="{StaticResource KlaButton}" IsDefault="True"/>
</StackPanel></Grid>
        </Grid>
    </ContentControl>
</Window>
