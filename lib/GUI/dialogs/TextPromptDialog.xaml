<!--  Window: Good - Revisit Shell w/o Footer  -->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Enter Text"
    Width="432"
    Style="{StaticResource klcWindow}"
    WindowStartupLocation="CenterScreen">
    <!--  ContentControl: Good  -->
    <ContentControl x:Name="window_shell" Style="{StaticResource klcWindowShell}">
        <!--  Grid: Good - What Are "FocusVisualStyle" "Focusable" "KeyboardNavigation.IsTabStop"?  -->
        <Grid
            x:Name="window_body"
            FocusVisualStyle="{x:Null}"
            Focusable="True"
            KeyboardNavigation.IsTabStop="False">
            <!--  Grid.RowDefinitions: Good  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{StaticResource klcBodySpaceSmall}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{StaticResource klcBodySpaceSmall}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  TextBox: Good  -->
            <TextBox
                x:Name="input_text"
                AutomationProperties.Name="Text value"
                Style="{StaticResource klcTextBoxPrompt}"
                TextChanged="text_changed" />
            <!--  TextBlock: Good  -->
            <TextBlock
                x:Name="validation_text"
                Grid.Row="2"
                Style="{StaticResource klcTextBlockFeedback}" />
            <!--  Button: Good - What Is "IsDefault"?  -->
            <Button
                x:Name="accept_button"
                Grid.Row="4"
                Click="accept_text"
                Content="OK"
                IsDefault="True"
                Style="{StaticResource klcButton}" />
        </Grid>
    </ContentControl>
</Window>
