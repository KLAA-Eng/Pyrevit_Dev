<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Enter Text"
    Width="560"
    Height="180"
    MinWidth="480"
    MinHeight="0"
    MaxHeight="560"
    ResizeMode="CanResizeWithGrip"
    Style="{StaticResource KlaWindow}"
    WindowStartupLocation="CenterScreen">
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid
            x:Name="window_body"
            FocusVisualStyle="{x:Null}"
            Focusable="True"
            KeyboardNavigation.IsTabStop="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                x:Name="prompt_scroll"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="prompt_fields">
                    <Grid>
                        <TextBox
                            x:Name="input_text"
                            AcceptsReturn="False"
                            AcceptsTab="False"
                            AutomationProperties.Name="Text value"
                            Style="{StaticResource KlaTextPromptInput}"
                            TextChanged="text_changed" />
                        <!--  Compact line height plus the optical inset centers the visible capital glyphs.  -->
                        <TextBlock
                            x:Name="input_placeholder"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource KlaTextPromptInputFontSize}"
                            FontWeight="Bold"
                            Foreground="{StaticResource KlaFooterVersionBrush}"
                            IsHitTestVisible="False"
                            LineHeight="24"
                            LineStackingStrategy="BlockLineHeight"
                            Text="[ENTER TEXT]">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text, ElementName=input_text}" Value="" />
                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=input_text}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock
                        x:Name="validation_text"
                        Margin="0,8,0,0"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{StaticResource KlaErrorBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
            <Grid
                x:Name="prompt_actions"
                Grid.Row="1"
                Margin="{StaticResource KlaActionTopGap}">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button
                        x:Name="accept_button"
                        Click="accept_text"
                        Content="OK"
                        IsDefault="True"
                        Style="{StaticResource KlaButton}" />
                </StackPanel>
            </Grid>
        </Grid>
    </ContentControl>
</Window>
