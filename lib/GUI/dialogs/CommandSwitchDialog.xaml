<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Command Switch"
    Width="480"
    MinWidth="360"
    MinHeight="120"
    MaxHeight="500"
    PreviewKeyDown="on_key_down"
    PreviewMouseDown="pointer_down"
    PreviewMouseLeftButtonUp="pointer_up"
    PreviewMouseMove="pointer_move"
    PreviewTextInput="on_text_input"
    Style="{StaticResource klcWindowFloating}"
    WindowStartupLocation="CenterScreen">
    <!--  NTS: Reviw Padding  -->
    <Border
        x:Name="switch_panel"
        Margin="{StaticResource KlaFloatingMargin}"
        Padding="{StaticResource KlaSectionPadding}"
        Background="{StaticResource klcWindowColor}"
        BorderThickness="0"
        CornerRadius="{StaticResource KlaWindowFloatingRad}">
        <Grid
            x:Name="window_body"
            FocusVisualStyle="{x:Null}"
            Focusable="True"
            KeyboardNavigation.IsTabStop="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{StaticResource klcBodySpaceLarge}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="drag_region">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label
                    x:Name="prompt_label"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="{StaticResource klcWindowPromptFontSize}"
                    FontWeight="SemiBold"
                    Padding="{StaticResource KlaOpticalTextInset}"
                    Style="{StaticResource klcLabelPrompt}"
                    Target="{Binding ElementName=search_text}" />
                <TextBox
                    x:Name="search_text"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.HelpText="Type to filter commands. Tab moves between controls. Escape clears the search, then closes."
                    Style="{StaticResource KlaInputCompact}"
                    Tag="Type to filter"
                    TextChanged="filter_changed" />
            </Grid>
            <ScrollViewer
                x:Name="commands_scroll"
                Grid.Row="2"
                Focusable="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <WrapPanel
                        x:Name="toggles_panel"
                        KeyboardNavigation.TabNavigation="Continue"
                        SizeChanged="command_panel_size_changed" />
                    <WrapPanel
                        x:Name="commands_panel"
                        KeyboardNavigation.TabNavigation="Continue"
                        SizeChanged="command_panel_size_changed" />
                    <TextBlock
                        x:Name="empty_text"
                        Margin="{StaticResource KlaStackGapBelow}"
                        Style="{StaticResource KlaInfoText}"
                        Text="No commands available."
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
