<!--  Window: Need to decide on the tranparent window style, need preview for height, what are the preview properties?  -->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Command Switch"
    Width="480"
    MinWidth="480"
    MinHeight="120"
    MaxWidth="752"
    PreviewKeyDown="on_key_down"
    PreviewMouseDown="pointer_down"
    PreviewMouseLeftButtonUp="pointer_up"
    PreviewMouseMove="pointer_move"
    PreviewTextInput="on_text_input"
    Style="{StaticResource klcWindowFloating}"
    WindowStartupLocation="CenterScreen">
    <!--  Border: Padding and Margin need review  -->
    <Border
        x:Name="switch_panel"
        Style="{StaticResource klcBorderFloating}">
        <!--  Grid: [EnterNotes]  -->
        <Grid
            x:Name="window_body"
            FocusVisualStyle="{x:Null}"
            Focusable="True"
            KeyboardNavigation.IsTabStop="False">
            <!--  Grid.RowDefinitions: Good  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{StaticResource klcBodySpaceLarge}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  Grid: Good  -->
            <Grid x:Name="drag_region">
                <!--  Grid.ColumnDefinitions: [EnterNotes]  -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  Label: [EnterNotes]  -->
                <Label
                    x:Name="prompt_label"
                    Padding="{StaticResource KlaOpticalTextInset}"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Style="{StaticResource klcLabelHeading}"
                    Target="{Binding ElementName=search_text}" />
                <!--  TextBox: [EnterNotes]  -->
                <TextBox
                    x:Name="search_text"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.HelpText="Type to filter commands. Tab moves between controls. Escape clears the search, then closes."
                    Style="{StaticResource klcTextBoxFilter}"
                    TextChanged="filter_changed" />
            </Grid>
            <!--  The switches, commands, and empty message size to their content.  -->
            <StackPanel Grid.Row="2">
                <!--  ItemsControl: one switch pill per SwitchState.switches row (Key, Label, IsChecked, CanToggle)  -->
                <ItemsControl
                    x:Name="toggles_panel"
                    Margin="{StaticResource klcStackGapBelow}"
                    Style="{StaticResource klcCommandPillItems}"
                    Focusable="False"
                    KeyboardNavigation.TabNavigation="Continue"
                    SizeChanged="command_panel_size_changed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton
                                AutomationProperties.Name="{Binding Label}"
                                Click="switch_clicked"
                                Content="{Binding Label}"
                                IsChecked="{Binding IsChecked, Mode=OneWay}"
                                IsEnabled="{Binding CanToggle}"
                                Style="{StaticResource klcToggleCommand}"
                                Tag="{Binding Key}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid>
                    <!--  ItemsControl: one command pill per SwitchState.choices row (Key, Label, Description, CanSelect)  -->
                    <ItemsControl
                        x:Name="commands_panel"
                        Focusable="False"
                        KeyboardNavigation.TabNavigation="Continue"
                        SizeChanged="command_panel_size_changed">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl" BasedOn="{StaticResource klcCommandPillItems}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=empty_text}" Value="Visible">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    AutomationProperties.HelpText="{Binding Description}"
                                    AutomationProperties.Name="{Binding Label}"
                                    Click="command_clicked"
                                    Content="{Binding Label}"
                                    IsEnabled="{Binding CanSelect}"
                                    Style="{StaticResource klcButtonCommand}"
                                    Tag="{Binding Key}"
                                    ToolTip="{Binding Description}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!--  TextBlock: [EnterNotes]  -->
                    <TextBlock
                        x:Name="empty_text"
                        Style="{StaticResource klcTextBlockMuted}"
                        Text="No commands available."
                        Visibility="Collapsed" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
