<!--  Window: Need to decide on the tranparent window style, need preview for height, what are the preview properties?  -->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Command Switch"
    Width="480"
    MinWidth="464"
    MinHeight="120"
    MaxWidth="752"
    PreviewKeyDown="on_key_down"
    PreviewMouseDown="pointer_down"
    PreviewMouseLeftButtonUp="pointer_up"
    PreviewMouseMove="pointer_move"
    PreviewTextInput="on_text_input"
    Style="{StaticResource klcWindowFloating}"
    WindowStartupLocation="CenterScreen">
    <!--  Border: Padding and Margin need review  -->
    <Border
        x:Name="switch_panel"
        Margin="{StaticResource KlaMarginFloatingWindow}"
        Padding="{StaticResource KlaPadFloating}"
        Background="{StaticResource klcBackgroundColor}"
        BorderThickness="0"
        CornerRadius="{StaticResource klcRadFloating}">
        <!--  Grid: [EnterNotes]  -->
        <Grid
            x:Name="window_body"
            FocusVisualStyle="{x:Null}"
            Focusable="True"
            KeyboardNavigation.IsTabStop="False">
            <!--  Grid.RowDefinitions: Good  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{StaticResource klcBodySpaceLarge}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  Grid: [EnterNotes]  -->
            <Grid x:Name="drag_region">
                <!--  Grid.ColumnDefinitions: [EnterNotes]  -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  Label: [EnterNotes]  -->
                <Label
                    x:Name="prompt_label"
                    Padding="{StaticResource KlaOpticalTextInset}"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="{StaticResource klcWindowPromptFontSize}"
                    FontWeight="SemiBold"
                    Style="{StaticResource klcLabelSectionHeading}"
                    Target="{Binding ElementName=search_text}" />
                <!--  TextBox: [EnterNotes]  -->
                <TextBox
                    x:Name="search_text"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.HelpText="Type to filter commands. Tab moves between controls. Escape clears the search, then closes."
                    Style="{StaticResource KlaCompactFieldInput}"
                    Tag="Type to filter"
                    TextChanged="filter_changed" />
            </Grid>
            <!--  ScrollViewer: [EnterNotes]  -->
            <ScrollViewer
                x:Name="commands_scroll"
                Grid.Row="2"
                Focusable="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <!--  StackPanel: [EnterNotes]  -->
                <StackPanel>
                    <!--  ItemsControl: one switch pill per SwitchState.switches row (Key, Label, IsChecked, CanToggle)  -->
                    <ItemsControl
                        x:Name="toggles_panel"
                        Focusable="False"
                        KeyboardNavigation.TabNavigation="Continue"
                        SizeChanged="command_panel_size_changed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton
                                    AutomationProperties.Name="{Binding Label}"
                                    Click="switch_clicked"
                                    Content="{Binding Label}"
                                    IsChecked="{Binding IsChecked, Mode=OneWay}"
                                    IsEnabled="{Binding CanToggle}"
                                    Style="{StaticResource KlaCommandToggle}"
                                    Tag="{Binding Key}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!--  ItemsControl: one command pill per SwitchState.choices row (Key, Label, Description, CanSelect)  -->
                    <ItemsControl
                        x:Name="commands_panel"
                        Margin="{StaticResource klcStackGapVert}"
                        Focusable="False"
                        KeyboardNavigation.TabNavigation="Continue"
                        SizeChanged="command_panel_size_changed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    AutomationProperties.HelpText="{Binding Description}"
                                    AutomationProperties.Name="{Binding Label}"
                                    Click="command_clicked"
                                    Content="{Binding Label}"
                                    IsEnabled="{Binding CanSelect}"
                                    Style="{StaticResource KlaCommandButton}"
                                    Tag="{Binding Key}"
                                    ToolTip="{Binding Description}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!--  TextBlock: [EnterNotes]  -->
                    <TextBlock
                        x:Name="empty_text"
                        Margin="{StaticResource klcStackGapVert}"
                        Style="{StaticResource KlaInfoText}"
                        Text="No commands available."
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
