<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Command Switch"
    Width="600"
    MinWidth="360"
    MinHeight="120"
    MaxHeight="500"
    PreviewKeyDown="on_key_down"
    PreviewMouseDown="pointer_down"
    PreviewMouseLeftButtonUp="pointer_up"
    PreviewMouseMove="pointer_move"
    PreviewTextInput="on_text_input"
    Style="{StaticResource KlaFloatingWindow}"
    WindowStartupLocation="CenterScreen">
    <Border
        x:Name="switch_panel"
        Margin="{StaticResource KlaFloatingMargin}"
        Padding="{StaticResource KlaSectionPadding}"
        Background="{StaticResource KlaWindowBrush}"
        BorderThickness="0"
        CornerRadius="{StaticResource KlaRadiusFloating}">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="12"
                Opacity="0.4"
                ShadowDepth="0"
                Color="{Binding Color, Source={StaticResource KlaWindowBrush}}" />
        </Border.Effect>
        <Grid
            x:Name="window_body"
            FocusVisualStyle="{x:Null}"
            Focusable="True"
            KeyboardNavigation.IsTabStop="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="drag_region" Margin="{StaticResource KlaStackGapBelow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label
                    x:Name="prompt_label"
                    MinHeight="{StaticResource KlaFilterHeight}"
                    MaxWidth="{StaticResource KlaSwitchPromptMaxWidth}"
                    Margin="{StaticResource KlaPairGap}"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="{StaticResource KlaSubheadingFontSize}"
                    FontWeight="SemiBold"
                    Style="{StaticResource KlaPromptLabel}"
                    Target="{Binding ElementName=search_text}">
                    <Label.ContentTemplate>
                        <DataTemplate>
                            <!--  Optical centering of Segoe UI's visible glyphs within the input row.  -->
                            <TextBlock
                                Margin="{StaticResource KlaOpticalTextInset}"
                                Text="{Binding}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </Label.ContentTemplate>
                </Label>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBox
                        x:Name="search_text"
                        AutomationProperties.HelpText="Type to filter commands. Tab moves between controls. Escape clears the search, then closes."
                        AutomationProperties.Name="Filter commands"
                        Style="{StaticResource KlaInputCompact}"
                        TextChanged="filter_changed" />
                    <TextBlock
                        x:Name="search_hint"
                        Margin="{StaticResource KlaInputPadding}"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource KlaPlaceholderBrush}"
                        IsHitTestVisible="False"
                        Text="Type to filter" />
                </Grid>
            </Grid>
            <ScrollViewer
                x:Name="commands_scroll"
                Grid.Row="1"
                Focusable="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <WrapPanel
                        x:Name="toggles_panel"
                        KeyboardNavigation.TabNavigation="Continue"
                        SizeChanged="command_panel_size_changed" />
                    <WrapPanel
                        x:Name="commands_panel"
                        KeyboardNavigation.TabNavigation="Continue"
                        SizeChanged="command_panel_size_changed" />
                    <TextBlock
                        x:Name="empty_text"
                        Margin="{StaticResource KlaStackGapBelow}"
                        Style="{StaticResource KlaInfoText}"
                        Text="No commands available."
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
