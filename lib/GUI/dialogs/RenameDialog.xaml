<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rename"
    Width="346"
    MinWidth="346"
    MinHeight="0"
    MaxHeight="640"
    ResizeMode="CanResizeWithGrip"
    Style="{StaticResource KlaWindow}"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style
            x:Key="KlaRenamePromptLabel"
            BasedOn="{StaticResource KlaPromptLabel}"
            TargetType="Label">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  Rename uses a tighter label column without changing tool form rows.  -->
        <Style
            x:Key="KlaRenameFieldRows"
            BasedOn="{StaticResource KlaFieldRows}"
            TargetType="ItemsControl">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource KlaRenameLabelColumn}" />
                                <ColumnDefinition Width="{StaticResource KlaCompactFieldInputColumn}" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{StaticResource KlaCompactFieldRow}" />
                                <RowDefinition Height="{StaticResource KlaGridSpace8}" />
                                <RowDefinition Height="{StaticResource KlaCompactFieldRow}" />
                                <RowDefinition Height="{StaticResource KlaGridSpace8}" />
                                <RowDefinition Height="{StaticResource KlaCompactFieldRow}" />
                                <RowDefinition Height="{StaticResource KlaGridSpace8}" />
                                <RowDefinition Height="{StaticResource KlaCompactFieldRow}" />
                            </Grid.RowDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid
            x:Name="window_body"
            FocusVisualStyle="{x:Null}"
            Focusable="True"
            KeyboardNavigation.IsTabStop="False">
            <ScrollViewer
                x:Name="rename_scroll"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid x:Name="fields_panel" />
                    <TextBlock
                        x:Name="validation_text"
                        Margin="{StaticResource KlaStackGap}"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{StaticResource KlaErrorBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="accept_button"
                        Margin="{StaticResource KlaActionTopGap}"
                        AutomationProperties.Name="Rename"
                        Click="accept_rename"
                        Content="Rename"
                        IsDefault="True"
                        Style="{StaticResource KlaButtonPrimary}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </ContentControl>
</Window>
