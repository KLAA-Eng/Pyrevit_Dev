<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Select Items"
    Width="432"
    Height="512"
    MinWidth="432"
    MinHeight="420"
    ResizeMode="CanResizeWithGrip"
    Style="{StaticResource klcWindow}"
    WindowStartupLocation="CenterScreen">
    <ContentControl x:Name="window_shell" Style="{StaticResource klcWindowShell}">
        <Grid
            x:Name="window_body"
            FocusVisualStyle="{x:Null}"
            Focusable="True"
            KeyboardNavigation.IsTabStop="False">
            <!--  Grid.RowDefinitions: Good  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{StaticResource klcBodySpaceSmall}" />
                <RowDefinition Height="*" />
                <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="secondary_gap" Height="{StaticResource klcBodySpaceNormal}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  StackPanel: Need to work on icons and inputs  -->
            <StackPanel>
                <Grid x:Name="search_row">
                    <!--  Grid.ColDefinitions: Good  -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl
                        x:Name="search_icon"
                        VerticalAlignment="Center"
                        Content="{StaticResource kliconSearch}"
                        Style="{StaticResource KlaIcon}" />
                    <TextBox
                        x:Name="filter_text"
                        Grid.Column="2"
                        AutomationProperties.Name="Search items"
                        Style="{StaticResource KlaFilter}"
                        TextChanged="filter_changed" />
                </Grid>
                <Grid x:Name="group_row" Margin="{StaticResource KlaStackGapAbove}">
                    <!--  Grid.ColDefinitions: Good  -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl
                        x:Name="group_icon"
                        VerticalAlignment="Center"
                        Content="{StaticResource kliconGroup}"
                        Style="{StaticResource KlaIcon}" />
                    <ComboBox
                        x:Name="group_filter"
                        Grid.Column="2"
                        AutomationProperties.Name="Item group"
                        DisplayMemberPath="Label"
                        SelectionChanged="filter_changed"
                        Style="{StaticResource KlaCompactComboBox}" />
                </Grid>
            </StackPanel>
            <!--  Label: Is label the right tool? Fix spacing and gaps  -->
            <Label
                x:Name="prompt_label"
                Grid.Row="2"
                Content="xxTitle"
                Style="{StaticResource klcLabelPrompt}"
                Target="{Binding ElementName=items_list}" />
            <!--  ListBox: Need to do a list clean  -->
            <ListBox
                x:Name="items_list"
                Grid.Row="4"
                AutomationProperties.Name="Selectable items"
                Style="{StaticResource KlaList}">
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource KlaDialogListItem}" TargetType="ListBoxItem" />
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox
                            AutomationProperties.Name="{Binding Label}"
                            Click="item_checked"
                            Content="{Binding}"
                            IsChecked="{Binding IsChecked, Mode=OneWay}"
                            IsEnabled="{Binding CanSelect}"
                            Style="{StaticResource KlaDialogCheck}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!--  StackPanel: Is the text blocl necessary  -->
            <StackPanel Grid.Row="6">
                <TextBlock
                    x:Name="validation_text"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{StaticResource klcErrorColor}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <StackPanel
                    x:Name="batch_actions"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Click="check_all"
                        Content="Select All"
                        Style="{StaticResource KlaButtonSecondary}" />
                    <Button
                        Margin="{StaticResource KlaPairGap}"
                        Click="check_none"
                        Content="Select None"
                        Style="{StaticResource KlaButtonSecondary}" />
                </StackPanel>
            </StackPanel>
            <!--  Button: include this in the button stackpanel?  -->
            <Button
                x:Name="accept_button"
                Grid.Row="8"
                Click="accept_selection"
                Content="Select"
                Style="{StaticResource klcButtonDouble}" />
        </Grid>
    </ContentControl>
</Window>
