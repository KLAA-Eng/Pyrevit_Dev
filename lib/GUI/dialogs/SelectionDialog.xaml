<!--  Window: Need preview for height  -->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Select Items"
    Width="432"
    MinWidth="432"
    MinHeight="420"
    MaxWidth="512"
    MaxHeight="620"
    ResizeMode="CanResizeWithGrip"
    Style="{StaticResource klcWindow}"
    WindowStartupLocation="CenterScreen">
    <!--  ContentControl: Good  -->
    <ContentControl x:Name="window_shell" Style="{StaticResource klcWindowShell}">
        <!--  Grid: What are the additional properties for?  -->
        <Grid
            x:Name="window_body"
            FocusVisualStyle="{x:Null}"
            Focusable="True"
            KeyboardNavigation.IsTabStop="False">
            <!--  Grid.RowDefinitions: Good  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{StaticResource klcBodySpaceSmall}" />
                <RowDefinition Height="*" />
                <RowDefinition Height="{StaticResource klcBodySpaceSmall}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{StaticResource klcBodySpaceSmall}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  StackPanel: Fdn TextBox and ComboBox need work  -->
            <StackPanel>
                <!--  Grid: Good  -->
                <Grid x:Name="search_row">
                    <!--  Grid.ColumnDefinitions: Good  -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  ContentControl: Good  -->
                    <ContentControl
                        x:Name="search_icon"
                        VerticalAlignment="Center"
                        Content="{StaticResource kliconSearch}"
                        Style="{StaticResource klcIcon16}" />
                    <!--  TextBox: Good  -->
                    <TextBox
                        x:Name="filter_text"
                        Grid.Column="2"
                        AutomationProperties.Name="Search items"
                        Style="{StaticResource klcTextBoxFilter}"
                        TextChanged="filter_changed" />
                </Grid>
                <!--  Grid: Good  -->
                <Grid x:Name="group_row" Margin="{StaticResource klcStackGapVert}">
                    <!--  Grid.ColumnDefinitions: Good  -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  ContentControl: Good  -->
                    <ContentControl
                        x:Name="group_icon"
                        VerticalAlignment="Center"
                        Content="{StaticResource kliconGroup}"
                        Style="{StaticResource klcIcon16}" />
                    <!--  ComboBox: Good  -->
                    <ComboBox
                        x:Name="group_filter"
                        Grid.Column="2"
                        AutomationProperties.Name="Item group"
                        DisplayMemberPath="Label"
                        SelectionChanged="filter_changed"
                        Style="{StaticResource klcComboBoxFilter}" />
                </Grid>
            </StackPanel>
            <!--  Label: Good  -->
            <Label
                x:Name="prompt_label"
                Grid.Row="2"
                Style="{StaticResource klcLabelHeading}"
                Target="{Binding ElementName=items_list}" />
            <!--  ListBox: Review Preview  -->
            <ListBox
                x:Name="items_list"
                Grid.Row="4"
                Style="{StaticResource KlaList}">
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource KlaDialogListItem}" TargetType="ListBoxItem" />
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox
                            AutomationProperties.Name="{Binding Label}"
                            Click="item_checked"
                            Content="{Binding}"
                            IsChecked="{Binding IsChecked, Mode=OneWay}"
                            IsEnabled="{Binding CanSelect}"
                            Style="{StaticResource klcCheckBoxSelection}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!--  TextBox: Good  -->
            <TextBlock
                x:Name="validation_text"
                Grid.Row="6"
                Style="{StaticResource klcTextBlockFeedback}" />
            <!--  StackPanel: Good  -->
            <StackPanel Grid.Row="8">
                <!--  StackPanel: Good  -->
                <StackPanel
                    x:Name="batch_actions"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  Button: Good  -->
                    <Button
                        Click="check_all"
                        Content="Select All"
                        Style="{StaticResource klcButtonSec}" />
                    <!--  Button: Good  -->
                    <Button
                        Margin="{StaticResource klcStackGapHoriz}"
                        Click="check_none"
                        Content="Select None"
                        Style="{StaticResource klcButtonSec}" />
                </StackPanel>
                <!--  Button: Good  -->
                <Button
                    x:Name="accept_button"
                    Click="accept_selection"
                    Content="Select"
                    Style="{StaticResource klcButtonDouble}" />
            </StackPanel>
        </Grid>
    </ContentControl>
</Window>
