<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Items" Width="432" Height="576" MinWidth="432" MinHeight="420" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" Style="{StaticResource KlaWindow}">
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="{StaticResource KlaGridSpace4}"/>
                <RowDefinition Height="*"/><RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                <RowDefinition Height="{StaticResource KlaControlRow}"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <Grid x:Name="search_row">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource KlaGridSpace16}"/><ColumnDefinition Width="{StaticResource KlaGridSpace8}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ContentControl x:Name="search_icon" Style="{StaticResource KlaGuiIcon}" Content="{StaticResource KlaSearchGeometry}" VerticalAlignment="Center"/>
                    <TextBox x:Name="filter_text" Grid.Column="2" TextChanged="filter_changed" Style="{StaticResource KlaFilter}" AutomationProperties.Name="Search items"/>
                </Grid>
                <Grid x:Name="group_row" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource KlaGridSpace16}"/><ColumnDefinition Width="{StaticResource KlaGridSpace8}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ContentControl x:Name="group_icon" Style="{StaticResource KlaGuiIcon}" Content="{StaticResource KlaGroupGeometry}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="group_filter" Grid.Column="2" DisplayMemberPath="Label" SelectionChanged="filter_changed" Style="{StaticResource KlaCompactComboBox}" AutomationProperties.Name="Item group"/>
                </Grid>
            </StackPanel>
            <Label x:Name="prompt_label" Grid.Row="2" Target="{Binding ElementName=items_list}" Style="{StaticResource KlaPromptLabel}"/>
            <ListBox x:Name="items_list" Grid.Row="4" Style="{StaticResource KlaList}" AutomationProperties.Name="Selectable items">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource KlaDialogListItem}"/></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <CheckBox Content="{Binding}" IsChecked="{Binding IsChecked, Mode=OneWay}" IsEnabled="{Binding CanSelect}" Click="item_checked" Style="{StaticResource KlaDialogCheck}" AutomationProperties.Name="{Binding Label}"/>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="6">
                <TextBlock x:Name="summary_text" Style="{StaticResource KlaInfoText}"/>
                <TextBlock x:Name="validation_text" TextWrapping="Wrap" Foreground="{StaticResource KlaErrorBrush}" Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                <StackPanel x:Name="batch_actions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Content="Select All" Click="check_all" Style="{StaticResource KlaButtonSecondary}" Margin="{StaticResource KlaPairGap}"/>
                    <Button Content="Select None" Click="check_none" Style="{StaticResource KlaButtonSecondary}"/>
                </StackPanel>
            </StackPanel>
            <Button x:Name="accept_button" Grid.Row="8" Content="Select" Click="accept_selection" Style="{StaticResource KlaButtonPrimary}"/>
        </Grid>
    </ContentControl>
</Window>
