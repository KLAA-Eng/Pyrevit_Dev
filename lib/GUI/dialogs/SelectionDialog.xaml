<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Items" Width="640" Height="560" MinWidth="480" MinHeight="420" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" Style="{StaticResource KlaWindow}" >
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="group_row" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Content="Group" Target="{Binding ElementName=group_filter}" Style="{StaticResource KlaLabel}"/>
                <ComboBox x:Name="group_filter" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="filter_changed" Style="{StaticResource KlaComboBox}" AutomationProperties.Name="Item group"/>
            </Grid>
            <StackPanel Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource KlaGuiIcon}" Content="{StaticResource KlaSearchGeometry}"/>
                    <TextBox x:Name="filter_text" Grid.Column="1" TextChanged="filter_changed" Style="{StaticResource KlaFilter}" AutomationProperties.Name="Search items"/>
                </Grid>
                <Label x:Name="prompt_label" Target="{Binding ElementName=items_list}" Style="{StaticResource KlaPromptLabel}"/>
            </StackPanel>
            <ListBox x:Name="items_list" Grid.Row="2" Style="{StaticResource KlaList}" AutomationProperties.Name="Selectable items">
                <ListBox.ItemContainerStyle>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource KlaDialogListItem}"/>
</ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding}" IsChecked="{Binding IsChecked, Mode=OneWay}" IsEnabled="{Binding CanSelect}" Click="item_checked" Style="{StaticResource KlaDialogCheck}" AutomationProperties.Name="{Binding Label}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <StackPanel x:Name="batch_actions" Orientation="Horizontal">
                    <Button Content="All Visible" Click="check_all" Style="{StaticResource KlaButtonSecondary}" Margin="0,0,8,0"/>
                    <Button Content="None Visible" Click="check_none" Style="{StaticResource KlaButtonSecondary}"/>
                </StackPanel>
                <TextBlock x:Name="summary_text" Style="{StaticResource KlaInfoText}" Margin="0,8,0,0"/>
                <TextBlock x:Name="validation_text" TextWrapping="Wrap" Foreground="{StaticResource KlaErrorBrush}" Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <Grid Grid.Row="4" Margin="0,16,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
    <Button Content="Cancel" Click="cancel" Style="{StaticResource KlaButtonSecondary}" Margin="0,0,8,0"/>
    <Button x:Name="accept_button" Content="Select" Click="accept_selection" Style="{StaticResource KlaButtonPrimary}" IsDefault="True"/>
</StackPanel></Grid>
        </Grid>
    </ContentControl>
</Window>
