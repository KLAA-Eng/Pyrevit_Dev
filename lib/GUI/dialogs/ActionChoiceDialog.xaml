<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Choose Action"
    Width="560"
    MinWidth="480"
    MinHeight="0"
    MaxHeight="640"
    ResizeMode="CanResizeWithGrip"
    Style="{StaticResource KlaWindow}"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!--  A simple repo-native arrow; no upstream TaskDialog code or asset.  -->
        <PathGeometry x:Key="ActionCommandArrow" Figures="M4,12 L20,12 M14,6 L20,12 L14,18" />
        <Style
            x:Key="ActionCommandLink"
            BasedOn="{StaticResource KlaButton}"
            TargetType="Button">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                Margin="0,4,8,0"
                                VerticalAlignment="Top"
                                Content="{StaticResource ActionCommandArrow}"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Style="{StaticResource KlaGuiIcon}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Text="{Binding Label}"
                                    TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Description}">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource KlaDialogDescription}" TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource KlaRadiusControl}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource KlaPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionDetailsToggle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource KlaMutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl
                                    x:Name="DetailsChevron"
                                    Margin="0,0,4,0"
                                    Content="{StaticResource KlaChevronRightGeometry}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Style="{StaticResource KlaGuiIcon}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="DetailsChevron" Property="Content" Value="{StaticResource KlaChevronDownGeometry}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid
            x:Name="window_body"
            FocusVisualStyle="{x:Null}"
            Focusable="True"
            KeyboardNavigation.IsTabStop="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                x:Name="main_scroll"
                Focusable="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="main_content">
                    <Grid x:Name="instruction_panel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            x:Name="severity_icon"
                            Width="32"
                            Height="32"
                            Margin="0,0,8,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource KlaGuiIcon}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="instruction_text"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="22"
                            Style="{StaticResource KlaSectionHeading}" />
                    </Grid>
                    <TextBlock
                        x:Name="body_text"
                        Margin="0,8,0,0"
                        Style="{StaticResource KlaInfoText}" />
                    <StackPanel x:Name="commands_panel" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer
                x:Name="option_scroll"
                Grid.Row="1"
                MaxHeight="80"
                Margin="0,8,0,0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <CheckBox
                    x:Name="option_check"
                    Style="{StaticResource KlaCheck}"
                    Visibility="Collapsed" />
            </ScrollViewer>
            <Expander
                x:Name="details_expander"
                Grid.Row="2"
                Margin="0,8,0,0"
                Collapsed="details_changed"
                Expanded="details_changed"
                Foreground="{StaticResource KlaMutedBrush}"
                Header="Details"
                IsExpanded="False"
                Visibility="Collapsed">
                <Expander.Template>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton
                                x:Name="DetailsToggle"
                                AutomationProperties.Name="Details"
                                Content="{TemplateBinding Header}"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                Style="{StaticResource ActionDetailsToggle}" />
                            <ContentPresenter x:Name="DetailsContent" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="DetailsContent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Expander.Template>
                <TextBox
                    x:Name="details_text"
                    Height="128"
                    Margin="0,8,0,0"
                    AutomationProperties.Name="Detailed action information"
                    Style="{StaticResource KlaMultilineReadout}" />
            </Expander>
            <Grid
                x:Name="buttons_panel"
                Grid.Row="3"
                Margin="{StaticResource KlaActionTopGap}"
                HorizontalAlignment="Right" />
            <ScrollViewer
                x:Name="help_panel"
                Grid.Row="4"
                MaxHeight="80"
                Margin="0,8,0,0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel>
                    <TextBlock
                        x:Name="help_plain_text"
                        Style="{StaticResource KlaInfoText}"
                        Visibility="Collapsed" />
                    <TextBlock x:Name="help_link_text" TextWrapping="Wrap"><Hyperlink
                            x:Name="help_link"
                            RequestNavigate="help_requested"
                            Style="{StaticResource KlaLink}">
                            <Run x:Name="help_caption" />
                        </Hyperlink></TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </ContentControl>
</Window>
