<!--  Window: Need preview for height/width. Is this window the right choice?  -->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Choose Action"
    Width="420"
    MinWidth="248"
    MaxHeight="640"
    Style="{StaticResource klcWindow}"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!--  Action instructions use the shared heading scale and wrap at the dialog width.  -->
        <Style x:Key="ActionChoiceInstruction" BasedOn="{StaticResource klcTextBlockHeading}" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  Primary actions use green; secondary actions use muted; focus adds weight.  -->
        <Style x:Key="klcButton" BasedOn="{StaticResource klcButtonSec}" TargetType="Button">
            <Setter Property="BorderBrush" Value="{StaticResource klcTextColorMuted}" />
            <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
            <Style.Triggers>
                <Trigger Property="IsDefault" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource klcColorGreen}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <!--  ContentControl: Good  -->
    <ContentControl x:Name="window_shell" Style="{StaticResource klcWindowShell}">
        <!--  Grid: What are the additional properties for? Need preview  -->
        <Grid
            x:Name="window_body"
            FocusVisualStyle="{x:Null}"
            Focusable="True"
            KeyboardNavigation.IsTabStop="False">
            <!--  Grid.RowDefinitions: [Enter Notes]  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  ScrollViewer: [Enter Notes]  -->
            <ScrollViewer
                x:Name="main_scroll"
                Focusable="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <!--  StackPanel: [Enter Notes]  -->
                <StackPanel x:Name="main_content">
                    <!--  Grid: [Enter Notes]  -->
                    <Grid x:Name="instruction_panel">
                        <!--  Grid.ColumnDefinitions: [Enter Notes]  -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!--  The controller supplies an icon only when severity is requested.  -->
                        <ContentControl
                            x:Name="severity_icon"
                            VerticalAlignment="Top"
                            Style="{StaticResource klcIcon32}"
                            Visibility="Collapsed" />
                        <!--  TextBlock: The pair gap is set in code when the icon shows, so a collapsed icon leaves no indent.  -->
                        <TextBlock
                            x:Name="instruction_text"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource ActionChoiceInstruction}" />
                    </Grid>
                    <!--  TextBlock: [Enter Notes]  -->
                    <TextBlock
                        x:Name="body_text"
                        Margin="{StaticResource klcStackGapVert}"
                        Style="{StaticResource klcTextBlockMuted}" />
                    <!--  StackPanel: What is this?  -->
                    <StackPanel x:Name="commands_panel" Margin="{StaticResource klcStackGapVert}" />
                </StackPanel>
            </ScrollViewer>
            <!--  ScrollViewer: [Enter Notes]  -->
            <ScrollViewer
                x:Name="option_scroll"
                Grid.Row="1"
                MaxHeight="{StaticResource KlaOptionMaxHeight}"
                Margin="{StaticResource klcStackGapVert}"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <CheckBox
                    x:Name="option_check"
                    Style="{StaticResource klcCheckBox}"
                    Visibility="Collapsed" />
            </ScrollViewer>
            <!--  Expander: [Enter Notes]  -->
            <Expander
                x:Name="details_expander"
                Grid.Row="2"
                Margin="{StaticResource klcStackGapVert}"
                Collapsed="details_changed"
                Expanded="details_changed"
                Header="Details"
                Style="{StaticResource klcExpanderDetails}"
                Visibility="Collapsed">
                <TextBox
                    x:Name="details_text"
                    AutomationProperties.Name="Detailed action information"
                    Style="{StaticResource klcTextBoxReadout}" />
            </Expander>
            <!--  Grid: [Enter Notes]  -->
            <Grid
                x:Name="buttons_panel"
                Grid.Row="3"
                Margin="{StaticResource KlaActionTopGap}"
                HorizontalAlignment="Right" />
            <!--  ScrollViewer: [Enter Notes]  -->
            <ScrollViewer
                x:Name="help_panel"
                Grid.Row="4"
                MaxHeight="{StaticResource KlaOptionMaxHeight}"
                Margin="{StaticResource klcStackGapVert}"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel>
                    <TextBlock
                        x:Name="help_plain_text"
                        Style="{StaticResource klcTextBlockMuted}"
                        Visibility="Collapsed" />
                    <TextBlock x:Name="help_link_text" TextWrapping="Wrap"><Hyperlink
                            x:Name="help_link"
                            RequestNavigate="help_requested"
                            Style="{StaticResource klcLink}">
                            <Run x:Name="help_caption" />
                        </Hyperlink></TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </ContentControl>
</Window>
