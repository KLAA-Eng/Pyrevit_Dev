<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Choose Action"
    Width="560"
    MinWidth="480"
    MinHeight="0"
    MaxHeight="640"
    ResizeMode="CanResizeWithGrip"
    Style="{StaticResource KlaWindow}"
    WindowStartupLocation="CenterScreen">
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid
            x:Name="window_body"
            FocusVisualStyle="{x:Null}"
            Focusable="True"
            KeyboardNavigation.IsTabStop="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                x:Name="main_scroll"
                Focusable="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="main_content">
                    <Grid x:Name="instruction_panel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            x:Name="severity_icon"
                            Width="{StaticResource KlaSeverityIconSize}"
                            Height="{StaticResource KlaSeverityIconSize}"
                            Margin="{StaticResource KlaPairGap}"
                            VerticalAlignment="Top"
                            Style="{StaticResource KlaGuiIcon}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="instruction_text"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource KlaDialogHeadingFontSize}"
                            Style="{StaticResource KlaSectionHeading}" />
                    </Grid>
                    <TextBlock
                        x:Name="body_text"
                        Margin="{StaticResource KlaStackGap}"
                        Style="{StaticResource KlaInfoText}" />
                    <StackPanel x:Name="commands_panel" Margin="{StaticResource KlaStackGap}" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer
                x:Name="option_scroll"
                Grid.Row="1"
                MaxHeight="{StaticResource KlaOptionMaxHeight}"
                Margin="{StaticResource KlaStackGap}"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <CheckBox
                    x:Name="option_check"
                    Style="{StaticResource KlaCheck}"
                    Visibility="Collapsed" />
            </ScrollViewer>
            <Expander
                x:Name="details_expander"
                Grid.Row="2"
                Margin="{StaticResource KlaStackGap}"
                Collapsed="details_changed"
                Expanded="details_changed"
                Foreground="{StaticResource KlaMutedBrush}"
                Header="Details"
                IsExpanded="False"
                Style="{StaticResource KlaDetailsExpander}"
                Visibility="Collapsed">
                <TextBox
                    x:Name="details_text"
                    Height="{StaticResource KlaDetailsHeight}"
                    Margin="{StaticResource KlaStackGap}"
                    AutomationProperties.Name="Detailed action information"
                    Style="{StaticResource KlaMultilineReadout}" />
            </Expander>
            <Grid
                x:Name="buttons_panel"
                Grid.Row="3"
                Margin="{StaticResource KlaActionTopGap}"
                HorizontalAlignment="Right" />
            <ScrollViewer
                x:Name="help_panel"
                Grid.Row="4"
                MaxHeight="{StaticResource KlaOptionMaxHeight}"
                Margin="{StaticResource KlaStackGap}"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel>
                    <TextBlock
                        x:Name="help_plain_text"
                        Style="{StaticResource KlaInfoText}"
                        Visibility="Collapsed" />
                    <TextBlock x:Name="help_link_text" TextWrapping="Wrap"><Hyperlink
                            x:Name="help_link"
                            RequestNavigate="help_requested"
                            Style="{StaticResource KlaLink}">
                            <Run x:Name="help_caption" />
                        </Hyperlink></TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </ContentControl>
</Window>
