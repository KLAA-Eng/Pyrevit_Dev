<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Message"
    Width="560"
    Height="300"
    MinWidth="480"
    MinHeight="240"
    MaxHeight="640"
    ResizeMode="CanResizeWithGrip"
    Style="{StaticResource klcWindow}"
    WindowStartupLocation="CenterScreen">
    <ContentControl x:Name="window_shell" Style="{StaticResource klcWindowShell}">
        <Grid x:Name="window_body">
            <!--  Grid.RowDefinitions: Good  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{StaticResource klcBodySpaceSmall}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  Border: Needs Fdn work  -->
            <Border x:Name="message_banner" Style="{StaticResource KlaBanner}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="{StaticResource KlaStackGapBelow}" Orientation="Horizontal">
                        <ContentControl
                            x:Name="message_icon"
                            Style="{StaticResource klaIcon32}" />
                        <TextBlock
                            x:Name="message_heading"
                            Margin="{StaticResource KlaPairGap}"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource klcMessageHeaderFontSize}"
                            Style="{StaticResource KlaSectionHeading}" />
                    </StackPanel>
                    <ScrollViewer
                        Grid.Row="1"
                        AutomationProperties.Name="Message content"
                        Focusable="True"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="message_body"
                            Style="{StaticResource KlaInfoText}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
            <!--  Expander: Need Fdn work  -->
            <Expander
                x:Name="message_expander"
                Grid.Row="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center"
                Collapsed="details_changed"
                Expanded="details_changed"
                FontSize="{StaticResource klcDetailsFontSize}"
                Foreground="{Binding Foreground, ElementName=message_body}"
                Header="Details"
                Style="{StaticResource KlaDetailsExpander}">
                <TextBox
                    x:Name="message_details"
                    Height="{StaticResource KlaDetailsHeight}"
                    Margin="{StaticResource klaDetailTextMargin}"
                    AutomationProperties.Name="Detailed message"
                    Foreground="{Binding Foreground, ElementName=message_body}"
                    Style="{StaticResource KlaDetailsReadout}" />
            </Expander>
            <Button
                x:Name="action_one"
                Grid.Row="4"
                HorizontalAlignment="Center"
                Click="accept_message"
                IsDefault="True"
                Style="{StaticResource KlaButton}" />
        </Grid>
    </ContentControl>
</Window>
