<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Message"
    Width="560"
    Height="300"
    MinWidth="480"
    MinHeight="240"
    MaxHeight="640"
    ResizeMode="CanResizeWithGrip"
    Style="{StaticResource klcWindow}"
    WindowStartupLocation="CenterScreen">
    <ContentControl x:Name="window_shell" Style="{StaticResource klcWindowShell}">
        <Grid x:Name="window_body">
            <!--  Grid.RowDefinitions: Good  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{StaticResource klcBodySpaceSmall}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  Border: Needs Fdn work  -->
            <Border x:Name="message_banner" Style="{StaticResource KlaBanner}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            x:Name="message_icon"
                            VerticalAlignment="Center"
                            Style="{StaticResource klaIcon32}" />
                        <TextBlock
                            x:Name="message_heading"
                            Grid.Column="1"
                            Margin="{StaticResource KlaPairGap}"
                            VerticalAlignment="Center"
                            Style="{StaticResource klaMessageHeading}" />
                    </Grid>
                    <!--  A readout, so the message can be selected and copied; muted like the information text it replaced.  -->
                    <TextBox
                        x:Name="message_body"
                        Grid.Row="2"
                        AutomationProperties.Name="Message content"
                        Foreground="{StaticResource KlaMutedBrush}"
                        Style="{StaticResource klaReadout}" />
                </Grid>
            </Border>
            <!--  Expander: Need Fdn work  -->
            <Expander
                x:Name="message_expander"
                Grid.Row="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center"
                Collapsed="details_changed"
                Expanded="details_changed"
                Header="Details"
                Style="{StaticResource KlaDetailsExpander}">
                <TextBox
                    x:Name="message_details"
                    AutomationProperties.Name="Detailed message"
                    Style="{StaticResource KlaDetailsReadout}" />
            </Expander>
            <Button
                x:Name="action_one"
                Grid.Row="4"
                HorizontalAlignment="Center"
                Click="accept_message"
                IsDefault="True"
                Style="{StaticResource KlaButton}" />
        </Grid>
    </ContentControl>
</Window>
