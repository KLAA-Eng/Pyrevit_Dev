<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Width="560" Height="300" MinWidth="480" MinHeight="240" MaxHeight="640" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" Style="{StaticResource KlaWindow}" SizeChanged="message_size_changed">
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border x:Name="message_banner" Style="{StaticResource KlaBanner}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ContentControl x:Name="message_icon" Style="{StaticResource KlaGuiIcon}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="message_heading" Style="{StaticResource KlaSectionHeading}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" AutomationProperties.Name="Message content">
                        <TextBlock x:Name="message_body" Style="{StaticResource KlaInfoText}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Expander x:Name="message_expander" Grid.Row="1" Header="Details" IsExpanded="False" Foreground="{StaticResource text_white}" Margin="0,8,0,0" Expanded="details_changed" Collapsed="details_changed">
                <TextBox x:Name="message_details" Style="{StaticResource KlaMultilineReadout}" Height="128" Margin="0,8,0,0" AutomationProperties.Name="Detailed message"/>
            </Expander>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button x:Name="action_one" Click="accept_message" Style="{StaticResource KlaButton}" Margin="0,0,8,0"/>
                <Button x:Name="action_two" Click="accept_message" Style="{StaticResource KlaButton}" Margin="0,0,8,0"/>
                <Button x:Name="action_three" Click="accept_message" Style="{StaticResource KlaButton}"/>
            </StackPanel>
        </Grid>
    </ContentControl>
</Window>
