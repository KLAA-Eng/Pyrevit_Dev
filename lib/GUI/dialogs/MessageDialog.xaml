<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Message"
    Width="560"
    Height="300"
    MinWidth="480"
    MinHeight="240"
    MaxHeight="640"
    ResizeMode="CanResizeWithGrip"
    Style="{StaticResource KlaWindow}"
    WindowStartupLocation="CenterScreen">
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="message_banner" Style="{StaticResource KlaBanner}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="{StaticResource KlaStackGapBelow}" Orientation="Horizontal">
                        <ContentControl
                            x:Name="message_icon"
                            Width="{StaticResource KlaSeverityIconSize}"
                            Height="{StaticResource KlaSeverityIconSize}"
                            Margin="{StaticResource KlaPairGap}"
                            Style="{StaticResource KlaGuiIcon}" />
                        <TextBlock
                            x:Name="message_heading"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource KlaDialogHeadingFontSize}"
                            Style="{StaticResource KlaSectionHeading}" />
                    </StackPanel>
                    <ScrollViewer
                        Grid.Row="1"
                        AutomationProperties.Name="Message content"
                        Focusable="True"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="message_body"
                            Style="{StaticResource KlaInfoText}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
            <Expander
                x:Name="message_expander"
                Grid.Row="1"
                Margin="{StaticResource KlaStackGap}"
                Collapsed="details_changed"
                Expanded="details_changed"
                Foreground="{Binding Foreground, ElementName=message_body}"
                Header="Details"
                IsExpanded="False"
                Style="{StaticResource KlaDetailsExpander}">
                <TextBox
                    x:Name="message_details"
                    Height="{StaticResource KlaDetailsHeight}"
                    Margin="{StaticResource KlaStackGap}"
                    AutomationProperties.Name="Detailed message"
                    Foreground="{Binding Foreground, ElementName=message_body}"
                    Style="{StaticResource KlaDetailsReadout}" />
            </Expander>
            <StackPanel
                Grid.Row="2"
                Margin="{StaticResource KlaActionTopGap}"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    x:Name="action_one"
                    Click="accept_message"
                    IsDefault="True"
                    Style="{StaticResource KlaButton}" />
            </StackPanel>
        </Grid>
    </ContentControl>
</Window>
