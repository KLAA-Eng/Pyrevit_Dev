<!--  Window: Need preview for height/max width  -->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Message"
    Width="432"
    MinWidth="432"
    MinHeight="240"
    MaxHeight="640"
    ResizeMode="CanResizeWithGrip"
    Style="{StaticResource klcWindow}"
    WindowStartupLocation="CenterScreen">
    <!--  ContentControl: Good  -->
    <ContentControl x:Name="window_shell" Style="{StaticResource klcWindowShell}">
        <!--  Grid: Good  -->
        <Grid x:Name="window_body">
            <!--  Grid.RowDefinitions: Good  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="{StaticResource klcBodySpaceSmall}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{StaticResource klcBodySpaceSmall}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  Border: Good  -->
            <Border x:Name="message_banner" Style="{StaticResource klcBorder}">
                <!--  Grid: Good  -->
                <Grid>
                    <!--  Grid.RowDefinitions: Good  -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{StaticResource klcBodySpaceLarge}" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--  Grid: Good   -->
                    <Grid>
                        <!--  Grid.ColumnDefinitions: Good  -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!--  ContentControl: Good - Remove Placeholder Content  -->
                        <ContentControl
                            x:Name="message_icon"
                            VerticalAlignment="Center"
                            Content="{StaticResource kliconErrorAlert}"
                            Style="{StaticResource klcIcon32}" />
                        <!--  TextBlock: Good - Remove Placeholder Text  -->
                        <TextBlock
                            x:Name="message_heading"
                            Grid.Column="2"
                            Margin="0,0,0,1"
                            VerticalAlignment="Center"
                            Style="{StaticResource klcTextBlockHeadMessage}" />
                    </Grid>
                    <!--  TextBox: Good  -->
                    <TextBox
                        x:Name="message_body"
                        Grid.Row="2"
                        AutomationProperties.Name="Message content"
                        Style="{StaticResource klcTextBoxReadout}" />
                </Grid>
            </Border>
            <!--  Expander: Needs Fdn Work  -->
            <Expander
                x:Name="message_expander"
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center"
                Collapsed="details_changed"
                Expanded="details_changed"
                Header="Details"
                Style="{StaticResource klcExpanderDetails}">
                <!--  TextBox: Needs Fdn Work  -->
                <TextBox
                    x:Name="message_details"
                    AutomationProperties.Name="Detailed message"
                    Style="{StaticResource klcTextBoxReadoutSmall}"/>
            </Expander>
            <!--  Button: Good  -->
            <Button
                x:Name="action_one"
                Grid.Row="4"
                HorizontalAlignment="Center"
                Click="accept_message"
                IsDefault="True"
                Style="{StaticResource klcButton}" />
        </Grid>
    </ContentControl>
</Window>
