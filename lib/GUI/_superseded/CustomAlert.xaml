<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KL&amp;A Tools"
    Width="440"
    Height="200"
    MinWidth="440"
    MinHeight="200"
    MaxWidth="440"
    MaxHeight="640"
    ShowInTaskbar="True"
    Style="{StaticResource klcWindow}"
    WindowStartupLocation="CenterScreen">
    <ContentControl x:Name="window_shell" Style="{StaticResource klcWindowShell}">
        <Grid x:Name="window_body">
            <Border x:Name="alert_banner" Style="{StaticResource KlaBanner}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource klcBodySpaceLarge}" />
                            <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            x:Name="alert_icon"
                            VerticalAlignment="Center"
                            Content="{StaticResource kliconInfoAlert}"
                            Style="{StaticResource xIcon}" />
                        <TextBlock
                            x:Name="alert_heading"
                            Grid.Column="2"
                            Style="{StaticResource KlaSectionHeading}"
                            Text="Information" />
                    </Grid>
                    <ScrollViewer
                        x:Name="alert_scroll"
                        Grid.Row="2"
                        AutomationProperties.Name="Alert message"
                        Focusable="True"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="message_text" Style="{StaticResource KlaInfoText}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </ContentControl>
</Window>
