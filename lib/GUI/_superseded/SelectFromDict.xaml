<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Select From Dict"
    Width="432"
    Height="576"
    MinWidth="432"
    MinHeight="576"
    MaxHeight="576"
    ShowInTaskbar="True"
    Style="{StaticResource klcWindow}"
    WindowStartupLocation="CenterScreen">
    <ContentControl x:Name="window_shell" Style="{StaticResource klcWindowShell}">
        <ItemsControl x:Name="window_body" Style="{StaticResource xFilteredCheckList}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource klcBodySpaceLarge}" />
                    <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl
                    x:Name="filter_icon"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Search"
                    Content="{StaticResource kliconSearch}"
                    Style="{StaticResource xIcon}" />
                <TextBox
                    x:Name="textbox_filter"
                    Grid.Column="2"
                    AutomationProperties.Name="Filter available elements"
                    Style="{StaticResource klcTextBoxFilter}"
                    TextChanged="text_filter_updated" />
            </Grid>
            <Label
                x:Name="text_label"
                Grid.Row="2"
                Content="Select Elements"
                Style="{StaticResource klcLabelSectionHeading}"
                Target="{Binding ElementName=main_ListBox}" />
            <ListBox
                x:Name="main_ListBox"
                Grid.Row="4"
                SelectionMode="Single"
                Style="{StaticResource KlaList}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox
                            Checked="UIe_ItemChecked"
                            Content="{Binding Name}"
                            IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource KlaCheck}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel
                x:Name="UI_Buttons_all_none"
                Grid.Row="6"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Click="button_select_all"
                    Content="Select All"
                    Style="{StaticResource klcButton}" />
                <Button
                    Margin="{StaticResource klcStackGapHoriz}"
                    Click="button_select_none"
                    Content="Select None"
                    Style="{StaticResource klcButton}" />
            </StackPanel>
            <Button
                x:Name="button_main"
                Grid.Row="8"
                Click="button_select"
                Content="Select"
                IsDefault="True"
                Style="{StaticResource klcButtonDouble}" />
        </ItemsControl>
    </ContentControl>
</Window>
