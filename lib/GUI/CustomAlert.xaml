<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KL&amp;A Tools"
    Width="440" Height="255"
    MinWidth="440" MaxWidth="440"
    MinHeight="255" MaxHeight="255"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="True"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="#1A252B">
    <Border Background="#1A252B" BorderBrush="{StaticResource border_green_dark}" BorderThickness="1">
        <Grid Background="#1A252B">
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
                <RowDefinition Height="55" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource header_background}" MouseDown="header_drag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Margin="5,0,0,0"
                               FontSize="14px"
                               FontWeight="Heavy"
                               Foreground="{StaticResource text_white}">
                        KLCode
                    </TextBlock>
                </DockPanel>
                <TextBlock x:Name="main_title"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource text_white}" />
                <Button Grid.Column="2" Content="Close" Width="60" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Click="button_close" />
            </Grid>

            <Grid Grid.Row="1" Margin="24,20,24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="17" BorderBrush="{StaticResource border_green_dark}" BorderThickness="2" VerticalAlignment="Top">
                    <TextBlock x:Name="alert_icon" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="alert_heading" FontSize="16" FontWeight="Bold" Foreground="{StaticResource text_green}" />
                    <TextBlock x:Name="message_text" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource text_white}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource header_background}" BorderBrush="{StaticResource border_green_dark}" BorderThickness="0,1,0,0">
                <Button Content="OK" Width="110" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Click="button_ok" />
            </Border>
        </Grid>
    </Border>
</Window>
