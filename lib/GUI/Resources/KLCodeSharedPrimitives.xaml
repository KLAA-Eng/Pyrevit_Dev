<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="KLCode_palette.xaml" />
        <ResourceDictionary Source="../../_logos/KLCodeWordmark.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="ScrollBarThumbVertical" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border
                        x:Name="rectangle"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{StaticResource KlaBorderBrush}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="rectangle" Property="Background" Value="{StaticResource KlaBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="true">
                            <Setter TargetName="rectangle" Property="Background" Value="{StaticResource KlaBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  Footer links retain the original green and underline; hover/focus is supplied by the foundation link style.  -->
    <Style x:Key="KLCodeFooterLink" TargetType="Hyperlink">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource KlaFooterLinkBrush}" />
    </Style>
    <!--  The wordmark geometry is generated from lib/_logos/KLCode_text_1024x256px.svg (KLCodeWordmark.xaml); the fills are palette roles.  -->
    <DataTemplate x:Key="KLCodeWordmark">
        <Viewbox
            Width="70"
            Height="12"
            SnapsToDevicePixels="True"
            Stretch="Uniform">
            <Canvas
                Width="{StaticResource KlaWordmarkCanvasWidth}"
                Height="{StaticResource KlaWordmarkCanvasHeight}"
                ClipToBounds="True">
                <Path
                    Data="{StaticResource KlaWordmarkSlashGeometry}"
                    Fill="{StaticResource KlaBorderBrush}"
                    RenderTransform="{StaticResource KlaWordmarkOrigin}" />
                <Path
                    Data="{StaticResource KlaWordmarkLettersGeometry}"
                    Fill="{StaticResource KlaTextBrush}"
                    RenderTransform="{StaticResource KlaWordmarkOrigin}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource KlaWindowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KlaWindowBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaWindowBrush}" />
        <Setter Property="Opacity" Value="0.9" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <!--  Vertical: the Track runs bottom-to-top, so it is reversed.  -->
                    <Grid x:Name="Bg" SnapsToDevicePixels="true">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" />
                        <Track
                            x:Name="PART_Track"
                            IsDirectionReversed="true"
                            IsEnabled="{TemplateBinding IsMouseOver}">
                            <Track.Thumb>
                                <Thumb Margin="2" Style="{StaticResource ScrollBarThumbVertical}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--  Horizontal bars (KlaDataGrid, Recall's list) share the look; the Track runs left-to-right, so it is not reversed.  -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid x:Name="Bg" SnapsToDevicePixels="true">
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" />
                                <Track
                                    x:Name="PART_Track"
                                    IsDirectionReversed="false"
                                    IsEnabled="{TemplateBinding IsMouseOver}">
                                    <Track.Thumb>
                                        <Thumb Margin="2" Style="{StaticResource ScrollBarThumbVertical}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
