<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="KLCodeFoundation.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="KlaSection" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KlaWindowBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource KlaHairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource KlaRadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource KlaSectionPadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="KlaSectionHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource KlaTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style
        x:Key="KlaPromptText"
        BasedOn="{StaticResource KlaSectionHeading}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style
        x:Key="KlaFieldLabel"
        BasedOn="{StaticResource KlaFoundationLabel}"
        TargetType="Label" />
    <Style
        x:Key="KlaCompactFieldLabel"
        BasedOn="{StaticResource KlaFieldLabel}"
        TargetType="Label">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style
        x:Key="KlaCompactFieldInput"
        BasedOn="{StaticResource KlaFoundationInput}"
        TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource KlaCompactFieldHeight}" />
    </Style>
    <!--
        UIElement items remain their own containers. Names and event handlers
        stay in the window's namescope; only the repeated layout is shared.
    -->
    <Style x:Key="KlaFieldRows" TargetType="ItemsControl">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource KlaCompactFieldLabelColumn}" />
                            <ColumnDefinition Width="{StaticResource KlaCompactFieldInputColumn}" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{StaticResource KlaCompactFieldRow}" />
                            <RowDefinition Height="{StaticResource KlaGridSpace8}" />
                            <RowDefinition Height="{StaticResource KlaCompactFieldRow}" />
                            <RowDefinition Height="{StaticResource KlaGridSpace8}" />
                            <RowDefinition Height="{StaticResource KlaCompactFieldRow}" />
                            <RowDefinition Height="{StaticResource KlaGridSpace8}" />
                            <RowDefinition Height="{StaticResource KlaCompactFieldRow}" />
                        </Grid.RowDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KlaFilteredCheckList" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{StaticResource KlaFilterRow}" />
                            <RowDefinition Height="{StaticResource KlaGridSpace8}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource KlaGridSpace4}" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="{StaticResource KlaGridSpace8}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource KlaGridSpace8}" />
                            <RowDefinition Height="{StaticResource KlaControlRow}" />
                        </Grid.RowDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KlaInfoText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource KlaMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style
        x:Key="KlaReadOnlyField"
        BasedOn="{StaticResource KlaFoundationInput}"
        TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource KlaMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style
        x:Key="KlaMultilineReadout"
        BasedOn="{StaticResource KlaFoundationInput}"
        TargetType="TextBox">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="{StaticResource KlaReadoutMinHeight}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource KlaReadoutPadding}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
    </Style>

    <Style
        x:Key="KlaCompactReadOnlyField"
        BasedOn="{StaticResource KlaReadOnlyField}"
        TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource KlaCompactFieldHeight}" />
    </Style>

    <Style x:Key="KlaComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="Background" Value="{StaticResource KlaWindowBrush}" />
        <Setter Property="Padding" Value="{StaticResource KlaCompactInset}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border
                        x:Name="ItemBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="{StaticResource KlaHairline}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource KlaPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource KlaFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KlaComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}" />
        <Setter Property="Height" Value="{StaticResource KlaControlHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource KlaButtonWidth}" />
        <Setter Property="MaxDropDownHeight" Value="{StaticResource KlaDropDownMaxHeight}" />
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="Background" Value="{StaticResource KlaWindowBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaBorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource KlaComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton
                            x:Name="DropDownToggle"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            ClickMode="Press"
                            Focusable="False"
                            Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border
                                        x:Name="DropDownBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{StaticResource KlaHairline}"
                                        CornerRadius="{StaticResource KlaRadiusControl}">
                                        <Path
                                            Margin="{StaticResource KlaComboArrowInset}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Data="M 0,0 L 8,0 L 4,4 Z"
                                            Fill="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="DropDownBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="DropDownBorder" Property="Background" Value="{StaticResource KlaPressedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="DropDownBorder" Property="Background" Value="{StaticResource KlaDisabledFillBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!--  Selection text must not intercept clicks intended for the full-surface toggle.  -->
                        <ContentPresenter
                            Margin="{StaticResource KlaComboTextInset}"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="ComboFocus"
                            BorderBrush="Transparent"
                            BorderThickness="{StaticResource KlaHairline}"
                            CornerRadius="{StaticResource KlaRadiusControl}"
                            IsHitTestVisible="False" />
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom">
                            <Border
                                MinWidth="{TemplateBinding ActualWidth}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Background="{StaticResource KlaWindowBrush}"
                                BorderBrush="{StaticResource KlaBorderBrush}"
                                BorderThickness="{StaticResource KlaHairline}">
                                <ScrollViewer
                                    CanContentScroll="True"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboFocus" Property="BorderBrush" Value="{StaticResource KlaFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                            <Setter Property="Background" Value="{StaticResource KlaDisabledFillBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="KlaCompactComboBox"
        BasedOn="{StaticResource KlaComboBox}"
        TargetType="ComboBox">
        <Setter Property="Height" Value="{StaticResource KlaCompactFieldHeight}" />
    </Style>

    <Style x:Key="KlaRadioButton" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}" />
        <Setter Property="MinHeight" Value="{StaticResource KlaCompactHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource KlaGridSpace16}" />
                            <ColumnDefinition Width="{StaticResource KlaGridSpace4}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="RadioBorder"
                            Width="{StaticResource KlaCheckSize}"
                            Height="{StaticResource KlaCheckSize}"
                            VerticalAlignment="Center"
                            Background="{StaticResource KlaWindowBrush}"
                            BorderBrush="{StaticResource KlaBorderBrush}"
                            BorderThickness="{StaticResource KlaHairline}"
                            CornerRadius="{StaticResource KlaRadiusRadio}">
                            <Ellipse
                                x:Name="RadioMark"
                                Width="{StaticResource KlaRadioDotSize}"
                                Height="{StaticResource KlaRadioDotSize}"
                                Fill="{StaticResource KlaTextBrush}"
                                Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RadioMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource KlaAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource KlaPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KlaToggle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="{StaticResource KlaButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource KlaCompactHeight}" />
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
        <Setter Property="Padding" Value="{StaticResource KlaInputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="ToggleBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource KlaRadiusCard}">
                        <Grid>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource KlaAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource KlaPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource KlaDisabledFillBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="KlaSecondaryButton"
        BasedOn="{StaticResource KlaFoundationButton}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
    </Style>
    <!--
        Link: a text action on the surface (Clear filters, Favorites, Recent) — transparent at rest, surface on hover, the same
        role width and keyboard-only focus adorner as every button. Ghost: the same with a hairline border (Cancel beside a main action).
    -->
    <Style
        x:Key="KlaLinkButton"
        BasedOn="{StaticResource KlaFoundationButton}"
        TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="LinkBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{StaticResource KlaHairline}"
                        CornerRadius="{StaticResource KlaRadiusCard}">
                        <Grid>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LinkBorder" Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="LinkBorder" Property="Background" Value="{StaticResource KlaPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="KlaGhostButton"
        BasedOn="{StaticResource KlaLinkButton}"
        TargetType="Button">
        <Setter Property="BorderBrush" Value="{StaticResource KlaBorderStrongBrush}" />
    </Style>
    <!--
        Segment: an exclusive choice drawn as a filled pill segment, not a radio circle (Family Studio's Families / Views,
        This Project / Library, List / Grid inside a KlaBorderStrongBrush pill).
    -->
    <Style x:Key="KlaSegmentButton" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}" />
        <Setter Property="Height" Value="{StaticResource KlaCompactHeight}" />
        <Setter Property="Padding" Value="{StaticResource KlaInputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="SegmentBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent">
                        <Grid>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource KlaAccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource KlaTextOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="KlaIconTextButton"
        BasedOn="{StaticResource KlaFoundationButton}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource KlaIconTextButtonWidth}" />
    </Style>
    <Style
        x:Key="KlaIconButton"
        BasedOn="{StaticResource KlaFoundationButton}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource KlaIconButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource KlaCompactHeight}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="KlaStatusChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource KlaHairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource KlaRadiusChip}" />
        <Setter Property="Padding" Value="{StaticResource KlaCompactInset}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style
        x:Key="KlaTableStatusChip"
        BasedOn="{StaticResource KlaStatusChip}"
        TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style
        x:Key="KlaStatusReady"
        BasedOn="{StaticResource KlaStatusChip}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource KlaReadyBrush}" />
    </Style>
    <Style
        x:Key="KlaStatusWarning"
        BasedOn="{StaticResource KlaStatusChip}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource KlaWarningBrush}" />
    </Style>
    <Style
        x:Key="KlaStatusError"
        BasedOn="{StaticResource KlaStatusChip}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource KlaErrorBrush}" />
    </Style>
    <Style x:Key="KlaStatusText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style
        x:Key="KlaBanner"
        BasedOn="{StaticResource KlaSection}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
    </Style>

    <Style x:Key="KlaDataGridText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="KlaDataGridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="{StaticResource KlaHeaderCellInset}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="KlaDataGridCell" TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource KlaHairline}" />
        <Setter Property="Padding" Value="{StaticResource KlaCompactInset}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaPressedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource KlaFocusBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="KlaDataGridStatusCell"
        BasedOn="{StaticResource KlaDataGridCell}"
        TargetType="DataGridCell">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="KlaDataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource KlaWindowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="KlaDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource KlaWindowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource KlaHairline}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource KlaBorderStrongBrush}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource KlaDataGridHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource KlaDataGridCell}" />
        <Setter Property="RowStyle" Value="{StaticResource KlaDataGridRow}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
    <!--
        Implicit-style policy (both hosts): a bare TextBox, ComboBox or CheckBox inside a shared-shell window takes the compact
        input, the compact dropdown and the foundation checkbox, so no control falls back to the native look. Every other control
        is opt-in by key.
    -->
    <Style BasedOn="{StaticResource KlaCompactFieldInput}" TargetType="TextBox" />
    <Style BasedOn="{StaticResource KlaCompactComboBox}" TargetType="ComboBox" />
    <Style BasedOn="{StaticResource KlaFoundationCheckBox}" TargetType="CheckBox" />

    <!--  Compiled-host brush names (formerly KLCodeCompiledTokens.xaml): aliases of the shared brushes, so one token chain serves both hosts.  -->
    <SolidColorBrush x:Key="KlaPanelBrush" Color="{Binding Color, Source={StaticResource KlaComponentSurfaceBrush}}" />
    <SolidColorBrush x:Key="KlaMutedTextBrush" Color="{Binding Color, Source={StaticResource KlaMutedBrush}}" />
    <SolidColorBrush x:Key="KlaSubtleTextBrush" Color="{Binding Color, Source={StaticResource KlaMutedBrush}}" />
    <SolidColorBrush x:Key="KlaBlockingBrush" Color="{Binding Color, Source={StaticResource KlaErrorBrush}}" />

    <!--  Role-named aliases (the names new XAML should use); the KlaFoundation* keys stay for existing consumers.  -->
    <Style
        x:Key="KlaWindow"
        BasedOn="{StaticResource KlaFoundationWindow}"
        TargetType="Window" />
    <!--  A frameless floating panel such as the Command Switch: the window is transparent and its panel draws the surface.  -->
    <Style
        x:Key="KlaFloatingWindow"
        BasedOn="{StaticResource KlaFoundationWindow}"
        TargetType="Window">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ShowInTaskbar" Value="False" />
    </Style>
    <Style
        x:Key="KlaButton"
        BasedOn="{StaticResource KlaFoundationButton}"
        TargetType="Button" />
    <Style
        x:Key="KlaButtonPrimary"
        BasedOn="{StaticResource KlaFoundationMainButton}"
        TargetType="Button" />
    <Style
        x:Key="KlaButtonSecondary"
        BasedOn="{StaticResource KlaSecondaryButton}"
        TargetType="Button" />
    <Style
        x:Key="KlaButtonClose"
        BasedOn="{StaticResource KlaFoundationCloseButton}"
        TargetType="Button" />
    <Style
        x:Key="KlaLabel"
        BasedOn="{StaticResource KlaFoundationLabel}"
        TargetType="Label" />
    <Style
        x:Key="KlaPromptLabel"
        BasedOn="{StaticResource KlaFoundationPromptLabel}"
        TargetType="Label" />
    <Style
        x:Key="KlaInput"
        BasedOn="{StaticResource KlaFoundationInput}"
        TargetType="TextBox" />
    <Style
        x:Key="KlaInputCompact"
        BasedOn="{StaticResource KlaCompactFieldInput}"
        TargetType="TextBox" />
    <Style
        x:Key="KlaFilter"
        BasedOn="{StaticResource KlaFoundationFilter}"
        TargetType="TextBox" />
    <Style
        x:Key="KlaCheck"
        BasedOn="{StaticResource KlaFoundationCheckBox}"
        TargetType="CheckBox" />
    <Style
        x:Key="KlaList"
        BasedOn="{StaticResource KlaFoundationList}"
        TargetType="ListBox" />
    <Style
        x:Key="KlaListItem"
        BasedOn="{StaticResource KlaFoundationListItem}"
        TargetType="ListBoxItem" />
    <Style
        x:Key="KlaLink"
        BasedOn="{StaticResource KlaFoundationLink}"
        TargetType="Hyperlink" />

    <!--  Opt-in rows for the reusable dialogs; existing tool lists are unaffected.  -->
    <Style
        x:Key="KlaTextPromptInput"
        BasedOn="{StaticResource KlaInput}"
        TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource KlaTextPromptInputHeight}" />
        <Setter Property="FontSize" Value="{StaticResource KlaTextPromptInputFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style
        x:Key="KlaDialogDescription"
        BasedOn="{StaticResource KlaInfoText}"
        TargetType="TextBlock">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="KlaDialogCheck"
        BasedOn="{StaticResource KlaCheck}"
        TargetType="CheckBox">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"
                            Text="{Binding Label}"
                            TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource KlaDialogDescription}" Text="{Binding Description}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="KlaDialogListItem"
        BasedOn="{StaticResource KlaListItem}"
        TargetType="ListBoxItem">
        <Setter Property="IsEnabled" Value="{Binding CanSelect}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="KlaSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource KlaComponentBorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinWidth" Value="{StaticResource KlaSplitterSize}" />
        <Setter Property="MinHeight" Value="{StaticResource KlaSplitterSize}" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="KeyboardIncrement" Value="{StaticResource KlaSplitterSize}" />
        <Setter Property="Focusable" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaFocusBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Details disclosure shared by Message and Action Choice: a chevron that turns down when
        expanded, the Expander's own foreground, no focus visual and no native circle.
        Template part names (DetailsToggle, DetailsChevron, DetailsContent) are used by code and probes.
    -->
    <Style x:Key="KlaDetailsToggle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Expander}}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl
                                x:Name="DetailsChevron"
                                Margin="{StaticResource KlaIconTextGap}"
                                Content="{StaticResource kliconChevRight}"
                                Foreground="{TemplateBinding Foreground}"
                                Style="{StaticResource KlaGuiIcon}" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="DetailsChevron" Property="Content" Value="{StaticResource kliconChevDown}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KlaDetailsExpander" TargetType="Expander">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton
                            x:Name="DetailsToggle"
                            AutomationProperties.Name="Details"
                            Content="{TemplateBinding Header}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Style="{StaticResource KlaDetailsToggle}" />
                        <ContentPresenter x:Name="DetailsContent" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="DetailsContent" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--
        A multiline readout whose text aligns with the dialog body (Message Details). TextBoxView already
        consumes Padding; applying it again as the content-host margin would shift the first character.
    -->
    <Style
        x:Key="KlaDetailsReadout"
        BasedOn="{StaticResource KlaMultilineReadout}"
        TargetType="TextBox">
        <Setter Property="Padding" Value="{StaticResource KlaDetailsReadoutPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="InputBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource KlaRadiusControl}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource KlaFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  TaskDialog-style command link (Action Choice). A simple repo-native arrow; no upstream TaskDialog code or asset.  -->
    <PathGeometry x:Key="KlaCommandArrowGeometry" Figures="M4,12 L20,12 M14,6 L20,12 L14,18" />
    <Style
        x:Key="KlaCommandLink"
        BasedOn="{StaticResource KlaButton}"
        TargetType="Button">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="{StaticResource KlaCommandLinkMinHeight}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="{StaticResource KlaCommandLinkPadding}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource KlaCommandLinkIconColumn}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            Margin="{StaticResource KlaCommandArrowInset}"
                            VerticalAlignment="Top"
                            Content="{StaticResource KlaCommandArrowGeometry}"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Style="{StaticResource KlaGuiIcon}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontSize="{StaticResource KlaSubheadingFontSize}"
                                FontWeight="SemiBold"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Text="{Binding Label}"
                                TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource KlaDialogDescription}" TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Description}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource KlaRadiusControl}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource KlaPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
