<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="KLCodeFoundation.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Role-named styles the windows and dialogs apply, grouped by control family. Windows use only the keys here, never a
        Foundation key: every Foundation base has at least one alias here that changes nothing, and the variants sit beside it.
        The implicit TextBox / ComboBox / CheckBox styles apply in both hosts (Python and compiled C#).
    -->

    <!--  Window: [Enter Notes]  -->
    <Style
        x:Key="klcWindow"
        BasedOn="{StaticResource klcFdnWindow}"
        TargetType="Window" />
    <!--  A frameless floating panel such as the Command Switch: the window is transparent and its panel draws the surface.  -->
    <Style
        x:Key="klcWindowFloating"
        BasedOn="{StaticResource klcFdnWindow}"
        TargetType="Window">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ShowInTaskbar" Value="False" />
    </Style>

    <!--  TextBlock: klcFdnWindow already gives every TextBlock its font, body size and text colour, so text styles set only what differs.  -->
    <Style
        x:Key="KlaSectionHeading"
        BasedOn="{StaticResource klaFoundationTextBlock}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource klcSectionTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style
        x:Key="KlaInfoText"
        BasedOn="{StaticResource klaFoundationTextBlock}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource KlaMutedBrush}" />
    </Style>
    <Style
        x:Key="KlaDialogDescription"
        BasedOn="{StaticResource KlaInfoText}"
        TargetType="TextBlock">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Labels: [Enter Notes]  -->
    <Style
        x:Key="klcLabelCentered"
        BasedOn="{StaticResource klcFdnLabel}"
        TargetType="Label">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style
        x:Key="klcLabelPrompt"
        BasedOn="{StaticResource klcFdnLabel}"
        TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource klcSectionTitleFontSize}" />
    </Style>

    <!--  HyperLink: [Enter Notes]  -->
    <Style
        x:Key="klcLink"
        BasedOn="{StaticResource klcFdnLink}"
        TargetType="Hyperlink" />
    <Style
        x:Key="klcLinkFooter"
        BasedOn="{StaticResource klcFdnLink}"
        TargetType="Hyperlink">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource klcFooterLinkColor}" />
    </Style>

    <!--  ContentControl (GUI icons): the presenter windows apply; KlaGuiIcon in Foundation draws it.  -->
    <Style
        x:Key="KlaIcon"
        BasedOn="{StaticResource KlaGuiIcon}"
        TargetType="ContentControl" />

    <!--  Border: Section, banner and text  -->
    <Style
        x:Key="KlaSection"
        BasedOn="{StaticResource klaFoundationBorder}"
        TargetType="Border" />
    <Style
        x:Key="KlaBanner"
        BasedOn="{StaticResource KlaSection}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
    </Style>

    <!--  Button: [Enter Notes]  -->
    <Style
        x:Key="KlaButton"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button" />
    <Style
        x:Key="klcButtonDouble"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource klcDoubleButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource klcDoubleButtonHeight}" />
        <Setter Property="FontSize" Value="{StaticResource klcButtonFontSizeLarge}" />
    </Style>
    <Style
        x:Key="KlaButtonSecondary"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
    </Style>
    <Style
        x:Key="klcCloseButton"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <!--  Chrome is the deliberate compact exception to form control sizes.  -->
        <Setter Property="Width" Value="{StaticResource klcCloseWidth}" />
        <Setter Property="Height" Value="{StaticResource klcCloseHeight}" />
        <Setter Property="FontSize" Value="{StaticResource klcCloseFontSize}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!--  FIXED: Added HorizontalAlignment, VerticalAlignment, and TextAlignment  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{Binding}"
                        TextAlignment="Center" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TextBox: Inputs and readouts  -->
    <Style
        x:Key="KlaInput"
        BasedOn="{StaticResource KlaFoundationInput}"
        TargetType="TextBox" />
    <Style
        x:Key="KlaCompactFieldInput"
        BasedOn="{StaticResource KlaFoundationInput}"
        TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource KlaCompactFieldHeight}" />
    </Style>
    <Style
        x:Key="KlaInputCompact"
        BasedOn="{StaticResource KlaCompactFieldInput}"
        TargetType="TextBox" />
    <Style
        x:Key="KlaFilter"
        BasedOn="{StaticResource KlaFoundationInput}"
        TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource KlaCompactFieldHeight}" />
        <Setter Property="FontSize" Value="{StaticResource klcGroupSearchFontSize}" />
    </Style>
    <!--  Text Entry's single large, bold, centred field.  -->
    <Style
        x:Key="KlaTextPromptInput"
        BasedOn="{StaticResource KlaInput}"
        TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource KlaTextPromptInputHeight}" />
        <Setter Property="FontSize" Value="{StaticResource klcTextDialogFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style
        x:Key="KlaMultilineReadout"
        BasedOn="{StaticResource KlaFoundationInput}"
        TargetType="TextBox">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="{StaticResource KlaReadoutMinHeight}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource KlaReadoutPadding}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
    </Style>

    <!--  ComboBox: the alias of the Foundation base, then the compact variant  -->
    <Style
        x:Key="KlaComboBox"
        BasedOn="{StaticResource klaFoundationComboBox}"
        TargetType="ComboBox" />
    <Style
        x:Key="KlaCompactComboBox"
        BasedOn="{StaticResource KlaComboBox}"
        TargetType="ComboBox">
        <Setter Property="Height" Value="{StaticResource KlaCompactFieldHeight}" />
    </Style>

    <!--  CheckBox: [Enter Notes]  -->
    <Style
        x:Key="KlaCheck"
        BasedOn="{StaticResource KlaFoundationCheckBox}"
        TargetType="CheckBox" />
    <Style
        x:Key="KlaDialogCheck"
        BasedOn="{StaticResource KlaCheck}"
        TargetType="CheckBox">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource KlaDialogDescription}" Text="{Binding Description}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ListBoxItem & ListBox: [Enter Notes]  -->
    <Style
        x:Key="KlaListItem"
        BasedOn="{StaticResource KlaFoundationListItem}"
        TargetType="ListBoxItem" />
    <!--  Opt-in rows for the reusable dialogs; existing tool lists are unaffected.  -->
    <Style
        x:Key="KlaDialogListItem"
        BasedOn="{StaticResource KlaListItem}"
        TargetType="ListBoxItem">
        <!--  A row whose item has CanSelect false is disabled and greyed.  -->
        <Setter Property="IsEnabled" Value="{Binding CanSelect}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="KlaList"
        BasedOn="{StaticResource KlaFoundationList}"
        TargetType="ListBox" />

    <!--  ItemsControl: [Enter Notes]  -->
    <!--
        UIElement items remain their own containers. Names and event handlers
        stay in the window's namescope; only the repeated layout is shared.
    -->
    <Style x:Key="KlaFieldRows" TargetType="ItemsControl">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource KlaCompactFieldLabelColumn}" />
                            <ColumnDefinition Width="{StaticResource KlaCompactFieldInputColumn}" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                        </Grid.RowDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Implicit styles: a bare TextBox, ComboBox or CheckBox in a shared-shell window takes the compact roles above  -->
    <Style BasedOn="{StaticResource KlaCompactFieldInput}" TargetType="TextBox" />
    <Style BasedOn="{StaticResource KlaCompactComboBox}" TargetType="ComboBox" />
    <Style BasedOn="{StaticResource KlaCheck}" TargetType="CheckBox" />

    <!--  WindowShell: [Enter Notes]  -->
    <!--  Tag carries the window metadata (Title, VersionText) the header and footer bind to; Content and DataContext stay workflow-owned.  -->
    <Style x:Key="klcWindowShell" TargetType="ContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{StaticResource klcChromeHeight}" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="{StaticResource klcChromeHeight}" />
                        </Grid.RowDefinitions>
                        <!--
                            The body is declared first so keyboard order and initial focus start in the body, then Close, then the footer links;
                            Grid.Row places it visually between the two chrome bands.
                        -->
                        <ContentPresenter
                            x:Name="klcShell_Body"
                            Grid.Row="1"
                            Margin="{StaticResource klcBodyMargin}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <Grid x:Name="klcShell_Header" Grid.Row="0">

                            <!--
                                1. Center Layer: Sits across the full width of the header.
                                Symmetrical margins (110 on both sides) create a safe bounding box
                                so a long title will truncate via CharacterEllipsis before colliding with your elements.
                            -->
                            <TextBlock
                                x:Name="klcHeader_title"
                                Margin="110,0,110,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Panel.ZIndex="0"
                                FontSize="{StaticResource klcHeaderTitleFontSize}"
                                Text="{Binding Tag.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />

                            <!--  2. Left Overlay: Logo fixed to the left edge  -->
                            <ContentControl
                                x:Name="klcHeader_logo"
                                Width="{StaticResource klcLogoWidth}"
                                Height="{StaticResource klcLogoHeight}"
                                Margin="{StaticResource klcHeadFootMargin}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Panel.ZIndex="1"
                                ContentTemplate="{StaticResource klcLogo}"
                                Focusable="False"
                                IsHitTestVisible="False" />

                            <!--  3. Right Overlay: Close Button fixed to the right edge  -->
                            <Button
                                x:Name="klcHeader_close"
                                Margin="{StaticResource klcHeadFootMargin}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Panel.ZIndex="1"
                                AutomationProperties.Name="Close window"
                                Content="{DynamicResource CloseLabel}"
                                Style="{StaticResource klcCloseButton}" />
                        </Grid>
                        <Grid x:Name="klcShell_Footer" Grid.Row="2">
                            <!--
                                1. Center Layer: Spans the full width of the footer row.
                                Symmetrical margins (110 on both sides) ensure the version string truncates
                                before it can ever visually collide with your links on the edges.
                            -->
                            <TextBlock
                                x:Name="klcFooter_version"
                                Margin="110,0,110,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Panel.ZIndex="0"
                                AutomationProperties.Name="Tool version"
                                FontSize="{StaticResource klcFooterVersionFontSize}"
                                Foreground="{StaticResource klcFooterVersionColor}"
                                Text="{Binding Tag.VersionText, RelativeSource={RelativeSource TemplatedParent}}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            <!--  2. Left Layer: Prototype Link floated to the left edge  -->
                            <TextBlock
                                Margin="{StaticResource klcHeadFootMargin}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Panel.ZIndex="1">
                                <Hyperlink
                                    x:Name="klcFooter_prototype"
                                    NavigateUri="{StaticResource klcPrototypeUri}"
                                    Style="{StaticResource klcLinkFooter}">
                                    <Run Text="Prototype" />
                                </Hyperlink>
                            </TextBlock>
                            <!--  3. Right Layer: Outreach Link floated to the right edge  -->
                            <TextBlock
                                Margin="{StaticResource klcHeadFootMargin}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Panel.ZIndex="1">
                                <Hyperlink
                                    x:Name="klcFooter_outreach"
                                    NavigateUri="{StaticResource klcOutreachUri}"
                                    Style="{StaticResource klcLinkFooter}">
                                    <Run Text="Outreach" />
                                </Hyperlink>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ======================================================================  -->
    <!--  Details Dialog Components  -->
    <!--  ======================================================================  -->
    <!--  Details disclosure (Message, Action Choice)  -->
    <Style
        x:Key="KlaDetailsExpander"
        BasedOn="{StaticResource klaFoundationExpander}"
        TargetType="Expander" />
    <!--  A multiline readout whose text aligns with the dialog body (Message Details); the input template comes from KlaFoundationInput.  -->
    <Style
        x:Key="KlaDetailsReadout"
        BasedOn="{StaticResource KlaMultilineReadout}"
        TargetType="TextBox">
        <Setter Property="Padding" Value="{StaticResource KlaDetailsReadoutPadding}" />
    </Style>

    <!--  ======================================================================  -->
    <!--  Action Choice Dialog Components  -->
    <!--  ======================================================================  -->
    <!--  TaskDialog-style command link (Action Choice). A simple repo-native arrow; no upstream TaskDialog code or asset.  -->
    <PathGeometry x:Key="KlaCommandArrowGeometry" Figures="M4,12 L20,12 M14,6 L20,12 L14,18" />
    <Style
        x:Key="KlaCommandLink"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Style.Resources>
            <StaticResource x:Key="klcButtonHoverBrush" ResourceKey="KlaComponentSurfaceBrush" />
            <SolidColorBrush x:Key="klcButtonDisabledBrush" Color="Transparent" />
            <StaticResource x:Key="klcButtonRadius" ResourceKey="KlaRadiusControl" />
        </Style.Resources>
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="{StaticResource KlaCommandLinkMinHeight}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!--  Body size for the description; the label sets its own.  -->
        <Setter Property="FontSize" Value="{StaticResource klcBodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
        <Setter Property="Padding" Value="{StaticResource KlaCommandLinkPadding}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource KlaCommandLinkIconColumn}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            Margin="{StaticResource KlaCommandArrowInset}"
                            VerticalAlignment="Top"
                            Content="{StaticResource KlaCommandArrowGeometry}"
                            Style="{StaticResource KlaGuiIcon}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontSize="{StaticResource klcSectionTitleFontSize}"
                                FontWeight="SemiBold"
                                Text="{Binding Label}"
                                TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource KlaDialogDescription}" TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Description}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ======================================================================  -->
    <!--  Command Switch Dialog Components  -->
    <!--  ======================================================================  -->
    <!--  Command Switch pills  -->
    <Style
        x:Key="KlaCommandButton"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Style.Resources>
            <StaticResource x:Key="klcButtonRadius" ResourceKey="KlaCommandPillRadius" />
        </Style.Resources>
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="{StaticResource klcButtonHeight}" />
        <!--  Stretch: pills on one WrapPanel line share the tallest pill's height.  -->
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="{StaticResource klcBodyFontSize}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaAccentBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
        <Setter Property="Padding" Value="{StaticResource KlaCommandPillInset}" />
        <Setter Property="Margin" Value="{StaticResource KlaCommandPillGap}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock
                        Text="{Binding}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{StaticResource KlaDisabledFillBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="KlaCommandToggle"
        BasedOn="{StaticResource klaFoundationSwitch}"
        TargetType="ToggleButton" />

    <!--  ======================================================================  -->
    <!--  x  tier: used only by windows that are not shared dialogs (tool windows, templates, the Gallery, compiled C# hosts).  -->
    <!--  ======================================================================  -->

    <!--  x: text and labels  -->
    <Style
        x:Key="xPromptText"
        BasedOn="{StaticResource KlaSectionHeading}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style
        x:Key="xLabel"
        BasedOn="{StaticResource klcFdnLabel}"
        TargetType="Label" />

    <!--  x: status chips  -->
    <Style
        x:Key="xStatusChip"
        BasedOn="{StaticResource klaFoundationBorder}"
        TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource xRadiusChip}" />
        <Setter Property="Padding" Value="{StaticResource KlaCompactInset}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style
        x:Key="xTableStatusChip"
        BasedOn="{StaticResource xStatusChip}"
        TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style
        x:Key="xStatusReady"
        BasedOn="{StaticResource xStatusChip}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource klcSuccessColor}" />
    </Style>
    <Style
        x:Key="xStatusWarning"
        BasedOn="{StaticResource xStatusChip}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource klcWarningColor}" />
    </Style>
    <Style
        x:Key="xStatusError"
        BasedOn="{StaticResource xStatusChip}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource klcErrorColor}" />
    </Style>
    <!--  The caption inside a status chip.  -->
    <Style
        x:Key="xStatusText"
        BasedOn="{StaticResource klaFoundationTextBlock}"
        TargetType="TextBlock" />

    <!--  x: surface buttons  -->
    <!--
        Link: a text action on the surface (Clear filters, Favorites, Recent) — transparent at rest, surface on hover, the same
        role width and keyboard-only focus adorner as every button. Ghost: the same with a hairline border (Cancel beside a main action).
    -->
    <Style
        x:Key="xLinkButton"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Style.Resources>
            <StaticResource x:Key="klcButtonHoverBrush" ResourceKey="KlaComponentSurfaceBrush" />
            <SolidColorBrush x:Key="klcButtonDisabledBrush" Color="Transparent" />
        </Style.Resources>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
    </Style>
    <Style
        x:Key="xGhostButton"
        BasedOn="{StaticResource xLinkButton}"
        TargetType="Button">
        <Setter Property="BorderBrush" Value="{StaticResource KlaBorderStrongBrush}" />
    </Style>

    <!--  x: read-only fields  -->
    <Style
        x:Key="xReadOnlyField"
        BasedOn="{StaticResource KlaFoundationInput}"
        TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource KlaMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style
        x:Key="xCompactReadOnlyField"
        BasedOn="{StaticResource xReadOnlyField}"
        TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource KlaCompactFieldHeight}" />
    </Style>

    <!--  x: exclusive choices  -->
    <Style
        x:Key="xRadioButton"
        BasedOn="{StaticResource klaFoundationRadioButton}"
        TargetType="RadioButton" />
    <!--
        Segment: an exclusive choice drawn as a filled pill segment, not a radio circle (Family Studio's Families / Views,
        This Project / Library, List / Grid inside a KlaBorderStrongBrush pill).
    -->
    <Style
        x:Key="xSegmentButton"
        BasedOn="{StaticResource klaFoundationRadioButton}"
        TargetType="RadioButton">
        <Setter Property="Height" Value="{StaticResource klcButtonHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="SegmentBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent">
                        <Grid>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource KlaAccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource KlaTextOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  x: field layouts  -->
    <Style x:Key="xFilteredCheckList" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource klcBodySpaceSmall}" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="{StaticResource xBodyRowLarge}" />
                        </Grid.RowDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  x: data grid  -->
    <!--  Cell text follows the cell's foreground, so selected and disabled rows recolour it.  -->
    <Style x:Key="xDataGridText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style
        x:Key="xDataGridCell"
        BasedOn="{StaticResource klaFoundationDataGridCell}"
        TargetType="DataGridCell" />
    <Style
        x:Key="xDataGridStatusCell"
        BasedOn="{StaticResource xDataGridCell}"
        TargetType="DataGridCell">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style
        x:Key="xDataGrid"
        BasedOn="{StaticResource klaFoundationDataGrid}"
        TargetType="DataGrid" />

    <!--  x: splitter  -->
    <Style
        x:Key="xSplitter"
        BasedOn="{StaticResource klaFoundationGridSplitter}"
        TargetType="GridSplitter" />

    <!--  ======================================================================  -->
    <!--  xx tier: used only by lib/GUI/_future windows, which no tool opens yet.  -->
    <!--  ======================================================================  -->
    <!--  Checked fills the button's own Background, so the template's hover, pressed and disabled fills still take precedence over it.  -->
    <Style
        x:Key="xxToggle"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="ToggleButton">
        <Setter Property="FontSize" Value="{StaticResource klcBodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="xxIconTextButton"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource xxIconTextButtonWidth}" />
    </Style>
    <Style
        x:Key="xxIconButton"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource xxIconButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource klcButtonHeight}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--  ======================================================================  -->
    <!--  xxx tier: no consumer anywhere (Python, compiled C#, Gallery, future). Candidates for deletion, except the plain aliases  -->
    <!--  xxxText, xxxComboBoxItem, xxxDataGridHeader and xxxDataGridRow, which give their Foundation base its Components alias.  -->
    <!--  xxxLabel duplicates xLabel.  -->
    <!--  ======================================================================  -->
    <Style
        x:Key="xxxText"
        BasedOn="{StaticResource klaFoundationTextBlock}"
        TargetType="TextBlock" />
    <Style
        x:Key="xxxLabel"
        BasedOn="{StaticResource klcFdnLabel}"
        TargetType="Label" />
    <Style
        x:Key="xxxButtonClose"
        BasedOn="{StaticResource klcCloseButton}"
        TargetType="Button" />
    <Style
        x:Key="xxxComboBoxItem"
        BasedOn="{StaticResource klaFoundationComboBoxItem}"
        TargetType="ComboBoxItem" />
    <Style
        x:Key="xxxDataGridHeader"
        BasedOn="{StaticResource klaFoundationDataGridHeader}"
        TargetType="DataGridColumnHeader" />
    <Style
        x:Key="xxxDataGridRow"
        BasedOn="{StaticResource klaFoundationDataGridRow}"
        TargetType="DataGridRow" />
</ResourceDictionary>
