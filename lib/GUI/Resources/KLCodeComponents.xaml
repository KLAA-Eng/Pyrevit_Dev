<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="KLCodeFoundation.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Role-named styles the windows and dialogs apply, grouped by control family. Windows use only the keys here, never a
        Foundation key: every Foundation base has at least one alias here that changes nothing, and the variants sit beside it.
        The implicit TextBox / ComboBox / CheckBox styles apply in both hosts (Python and compiled C#).
    -->


    <!--  ======================================================================  -->
    <!--  Window: Good  -->
    <!--  ======================================================================  -->

    <!--  klcWindow: Good  -->
    <Style
        x:Key="klcWindow"
        BasedOn="{StaticResource klcFdnWindow}"
        TargetType="Window" />
    <!--  klcWindowFloating: Good  -->
    <!--  Only Used in CommandSwitchDialog  -->
    <Style
        x:Key="klcWindowFloating"
        BasedOn="{StaticResource klcFdnWindow}"
        TargetType="Window">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ShowInTaskbar" Value="False" />
    </Style>


    <!--  ======================================================================  -->
    <!--  Floating palette surface; shadow values belong to this component.  -->
    <Style x:Key="klcBorderFloating" TargetType="Border">
        <Setter Property="Margin" Value="{StaticResource KlaMarginFloatingWindow}" />
        <Setter Property="Padding" Value="{StaticResource klcPadFloating}" />
        <Setter Property="Background" Value="{StaticResource klcBackgroundColor}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource klcRadFloating}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" Opacity="0.12" ShadowDepth="0" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TextBlock: Good  -->
    <!--  ======================================================================  -->
    <!--  klcFdnWindow Supplies FONT, SIZE and COLOR  -->

    <!--  klcTextBlockHeading: Good  -->
    <Style
        x:Key="klcTextBlockHeading"
        BasedOn="{StaticResource klcFdnTextBlock}"
        TargetType="TextBlock" >
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeHeading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!--  klcTextBlockHeadMessage: Good  -->
    <!--  Window colors per severity  -->
    <Style
        x:Key="klcTextBlockHeadMessage"
        BasedOn="{StaticResource klcFdnTextBlock}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeMessage}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!--  klcTextBlockFeedback: Good  -->
    <Style
        x:Key="klcTextBlockFeedback"
        BasedOn="{StaticResource klcFdnTextBlock}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource klcErrorColor}" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--  klcTextBlockMuted:Good  -->
    <Style
        x:Key="klcTextBlockMuted"
        BasedOn="{StaticResource klcFdnTextBlock}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource klcTextColorMuted}" />
    </Style>
    <!--  klcTextBlockMutedDisabled: Good  -->
    <Style
        x:Key="klcTextBlockMutedDisabled"
        BasedOn="{StaticResource klcFdnTextBlock}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource klcTextColorMuted}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource klcTextColorDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <!--  ======================================================================  -->
    <!--  TextBox: Review Readouts  -->
    <!--  ======================================================================  -->

    <!--  klcTextBox: Good  -->
    <Style
        x:Key="klcTextBox"
        BasedOn="{StaticResource klcFdnTextBoxInput}"
        TargetType="TextBox">
        <Setter Property="Tag" Value="[ENTER TEXT]" />
    </Style>
    <!--  klcTextBoxFilter: Good  -->
    <Style
        x:Key="klcTextBoxFilter"
        BasedOn="{StaticResource klcFdnTextBoxInput}"
        TargetType="TextBox">
        <Setter Property="Tag" Value="[TYPE TO FILTER]" />
    </Style>
    <!--  klcTextBoxPrompt: Good  -->
    <!--  Only used in TextPromptDialog  -->
    <Style
        x:Key="klcTextBoxPrompt"
        BasedOn="{StaticResource klcFdnTextBoxInput}"
        TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource klcTextBoxPromptHeight}" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeTextPrompt}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Tag" Value="[ENTER TEXT]" />
    </Style>

    <!--  klcTextBoxReadout[NeedsWork]:  Selectable read-only text  -->
    <!--  Only used in MessageDialog  -->
    <!--
        Tool output the user may copy (a message body, a path, a report): read-only text drawn like body text, selectable
        with Ctrl+C and right-click Copy. The transparent hairline keeps the keyboard focus border visible.
    -->
    <Style
        x:Key="klcTextBoxReadout"
        BasedOn="{StaticResource klcFdnTextBoxInput}"
        TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <!--  klcTextBoxReadoutSmall[NeedsWork]: Wrapping, scrollable, read-only multiline field.  -->
    <Style
        x:Key="klcTextBoxReadoutSmall"
        BasedOn="{StaticResource klcFdnTextBoxInput}"
        TargetType="TextBox">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="{StaticResource KlaReadoutMinHeight}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeBody}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource klcSectionPadding}" />
        <Setter Property="BorderBrush" Value="{StaticResource klcTextColorMuted}" />
    </Style>


    <!--  ======================================================================  -->
    <!--  Label: Review Label Centered and if vert alignment is necessary.  -->
    <!--  ======================================================================  -->

    <!--  klcLabelCentered[Review]: Field caption vertically centred beside its input.  -->
    <Style
        x:Key="klcLabelCentered"
        BasedOn="{StaticResource klcFdnLabel}"
        TargetType="Label">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!--  klcLabelHeading: Good  -->
    <Style
        x:Key="klcLabelHeading"
        BasedOn="{StaticResource klcFdnLabel}"
        TargetType="Label">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeHeading}" />
    </Style>


    <!--  ======================================================================  -->
    <!--  Hyperlink: Review klcLink  -->
    <!--  ======================================================================  -->

    <!--  klcLink: Review use and color  -->
    <!--  Only used in ActionChoiceDialog  -->
    <Style
        x:Key="klcLink"
        BasedOn="{StaticResource klcFdnLink}"
        TargetType="Hyperlink" >
        <Setter Property="Foreground" Value="{StaticResource klcFooterLinkColor}" />
    </Style>
    <!--  klcLinkFooter: Good  -->
    <Style
        x:Key="klcLinkFooter"
        BasedOn="{StaticResource klcFdnLink}"
        TargetType="Hyperlink">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource klcFooterLinkColor}" />
    </Style>


    <!--  ======================================================================  -->
    <!--  Icon: Good  -->
    <!--  ======================================================================  -->
    <!--
        ContentControl (GUI icons): the sized presenters windows apply; klcFdnIcon in Foundation draws them. The number is the
        icon's size in window units, so it is written here rather than tokenised (check_ui_scale exempts the Icon<size> styles);
        the stroke stays klcIconStroke and scales with the icon.
    -->

    <!--  klcIcon12: Good  -->
    <!--  Not currently used.  -->
    <Style
        x:Key="klcIcon12"
        BasedOn="{StaticResource klcFdnIcon}"
        TargetType="ContentControl">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>
    <!--  klcIcon16: Good  -->
    <!--  Used by SelectionDialog and the KLC-ReviewTemp template.  -->
    <Style
        x:Key="klcIcon16"
        BasedOn="{StaticResource klcFdnIcon}"
        TargetType="ContentControl">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <!--  klcIcon24: Good  -->
    <!--  Not currently used.  -->
    <Style
        x:Key="klcIcon24"
        BasedOn="{StaticResource klcFdnIcon}"
        TargetType="ContentControl">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>
    <!--  klcIcon32: Good  -->
    <!--  Used by ActionChoiceDialog and MessageDialog.  -->
    <Style
        x:Key="klcIcon32"
        BasedOn="{StaticResource klcFdnIcon}"
        TargetType="ContentControl">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
    </Style>
    <!--  klcIcon48: Good  -->
    <!--  Not currently used.  -->
    <Style
        x:Key="klcIcon48"
        BasedOn="{StaticResource klcFdnIcon}"
        TargetType="ContentControl">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
    </Style>


    <!--  ======================================================================  -->
    <!--  Border: Good  -->
    <!--  ======================================================================  -->

    <!--  klcBorder: Good  -->
    <Style
        x:Key="klcBorder"
        BasedOn="{StaticResource klcFdnBorder}"
        TargetType="Border" />


    <!--  ======================================================================  -->
    <!--  Button: Good  -->
    <!--  ======================================================================  -->

    <!--  klcButton: Good  -->
    <Style
        x:Key="klcButton"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button" />
    <!--  klcButtonDouble: Good  -->
    <Style
        x:Key="klcButtonDouble"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource klcDoubleButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource klcDoubleButtonHeight}" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeButtonLarge}" />
    </Style>
    <!--  klcButtonSec: Good  -->
    <Style
        x:Key="klcButtonSec"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!--  Repo-native command arrow geometry, shared by the action link template below.  -->
    <PathGeometry x:Key="KlaCommandArrowGeometry" Figures="M4,12 L20,12 M14,6 L20,12 L14,18" />
    <!--  KlaCommandLink: Full-width action with an arrow, wrapping label and optional description.  -->
    <!--  Only used in ActionChoiceDialog; shares the standard button template and state tokens.  -->
    <Style x:Key="KlaCommandLink" BasedOn="{StaticResource klcFdnButton}" TargetType="Button">
        <Style.Resources>
            <SolidColorBrush x:Key="klcButtonHoverBrush" Color="{Binding Color, Source={StaticResource KlaComponentSurfaceBrush}}" />
            <SolidColorBrush x:Key="klcButtonDisabledBrush" Color="Transparent" />
            <Style x:Key="klcButtonBorderShape" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource klcRadTextBox}" />
            </Style>
        </Style.Resources>
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="{StaticResource KlaCommandLinkMinHeight}" />
        <Setter Property="Margin" Value="{StaticResource klcStackGapVertSmall}" />
        <Setter Property="BorderBrush" Value="{StaticResource klcTextColorMuted}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
        <Setter Property="Padding" Value="{StaticResource KlaCommandLinkPadding}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Content.Label, RelativeSource={RelativeSource Self}}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding Content.Description, RelativeSource={RelativeSource Self}}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource KlaCommandLinkIconColumn}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Margin="{StaticResource KlaCommandArrowInset}"
                            VerticalAlignment="Top" Content="{StaticResource KlaCommandArrowGeometry}"
                            Style="{StaticResource klcIcon16}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="{StaticResource klcFontSizeHeading}" FontWeight="SemiBold"
                                Text="{Binding Label}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource klcTextBlockMutedDisabled}" TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Description}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <!--  Primary actions stay green; secondary actions stay muted, including on hover.  -->
        <Style.Triggers>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource klcColorGreen}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--  klcButtonClose: Good  -->
    <Style
        x:Key="klcButtonClose"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <!--  Chrome is the deliberate compact exception to form control sizes.  -->
        <Setter Property="Width" Value="{StaticResource klcCloseWidth}" />
        <Setter Property="Height" Value="{StaticResource klcCloseHeight}" />
        <Setter Property="FontSize" Value="{StaticResource klcCloseFontSize}" />
        <!--  The default caption; a window or tool that sets Content itself replaces it.  -->
        <Setter Property="Content" Value="{DynamicResource CloseLabel}" />
    </Style>
    <!--  klcButtonCommand: Good  -->
    <!--  Only used in CommandSwitchDialog  -->
    <Style
        x:Key="klcButtonCommand"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Style.Resources>
            <Style x:Key="klcButtonBorderShape" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource KlaCommandPillRadius}" />
            </Style>
        </Style.Resources>
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="{StaticResource klcButtonHeight}" />
        <!--  Stretch: pills on one WrapPanel line share the tallest pill's height.  -->
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeBody}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaAccentBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
        <Setter Property="Padding" Value="{StaticResource klcCommandPillInset}" />

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{StaticResource KlaDisabledFillBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <!--  ======================================================================  -->
    <!--  ToggleButton: Good -->
    <!--  ======================================================================  -->

    <!--  Item containers own spacing; compensate once at the panel edge so
          wrapped rows have a gap without adding trailing group whitespace.  -->
    <Style x:Key="klcCommandPillItems" TargetType="ItemsControl">
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="{StaticResource KlaCommandPillGap}" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Margin="{StaticResource klcCommandPillPanelInset}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  klcToggleCommand: Good  -->
    <!--  Only used in CommandSwitchDialog  -->
    <Style
        x:Key="klcToggleCommand"
        BasedOn="{StaticResource klcFdnSwitch}"
        TargetType="ToggleButton" />


    <!--  ======================================================================  -->
    <!--  ComboBox: Standard and filter variants.  -->
    <!--  ======================================================================  -->
    <!--  ComboBox: the alias of the Foundation base, then the compact variant  -->

    <!--  KlaComboBox: Foundation combo box alias.  -->
    <Style
        x:Key="KlaComboBox"
        BasedOn="{StaticResource klaFoundationComboBox}"
        TargetType="ComboBox" />
    <!--  klcComboBoxFilter: Compact combo box sized for filter controls.  -->
    <Style
        x:Key="klcComboBoxFilter"
        BasedOn="{StaticResource klaFoundationComboBox}"
        TargetType="ComboBox">
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeTextBox}" />
        <Setter Property="Height" Value="{StaticResource klcFieldHeightNormal}" />
    </Style>

    <!--  ======================================================================  -->
    <!--  CheckBox: Standard and selection variants.  -->
    <!--  ======================================================================  -->
    <!--  CheckBox: the plain alias, then the dialog row that shows a label and a description  -->

    <!--  klcCheckBox: Foundation check box alias.  -->
    <Style
        x:Key="klcCheckBox"
        BasedOn="{StaticResource klcFdnCheckBox}"
        TargetType="CheckBox" />
    <!--  KlaCheck: Compatibility alias for klcCheckBox.  -->
    <Style
        x:Key="KlaCheck"
        BasedOn="{StaticResource klcCheckBox}"
        TargetType="CheckBox" />
    <!--  klcCheckBoxSelection: SelectionDialog check box with a label and optional description.  -->
    <!--  Only used in SelectionDialog  -->
    <Style
        x:Key="klcCheckBoxSelection"
        BasedOn="{StaticResource klcFdnCheckBox}"
        TargetType="CheckBox">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="description"
                            Style="{StaticResource klcTextBlockMutedDisabled}"
                            Text="{Binding Description}" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                            <Setter TargetName="description" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Description}" Value="">
                            <Setter TargetName="description" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ======================================================================  -->
    <!--  ListBox: List items and container.  -->
    <!--  ======================================================================  -->
    <!--  ListBoxItem & ListBox: the plain aliases, with the dialog row that disables itself when CanSelect is false  -->

    <!--  KlaListItem: Foundation list item alias.  -->
    <!--  Only used in SelectionDialog (through KlaDialogListItem)  -->
    <Style
        x:Key="KlaListItem"
        BasedOn="{StaticResource KlaFoundationListItem}"
        TargetType="ListBoxItem" />
    <!--  KlaDialogListItem: Dialog list row disabled when CanSelect is false.  -->
    <!--  Only used in SelectionDialog  -->
    <!--  Opt-in rows for the reusable dialogs; existing tool lists are unaffected.  -->
    <Style
        x:Key="KlaDialogListItem"
        BasedOn="{StaticResource KlaListItem}"
        TargetType="ListBoxItem">
        <!--  A row whose item has CanSelect false is disabled and greyed.  -->
        <Setter Property="IsEnabled" Value="{Binding CanSelect}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource klcTextColorDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--  KlaList: Foundation list box alias.  -->
    <Style
        x:Key="KlaList"
        BasedOn="{StaticResource KlaFoundationList}"
        TargetType="ListBox" />

    <!--  ======================================================================  -->
    <!--  ItemsControl: Shared field-row layout.  -->
    <!--  ======================================================================  -->
    <!--  ItemsControl: fixed row layouts; the direct items stay the window's named controls  -->
    <!--
        UIElement items remain their own containers. Names and event handlers
        stay in the window's namescope; only the repeated layout is shared.
    -->

    <!--  klcRenameRows: Good  -->
    <Style x:Key="klcRenameRows" TargetType="ItemsControl">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource klcRenameLabelColumn}" />
                            <ColumnDefinition Width="{StaticResource klcRenameInputColumn}" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                        </Grid.RowDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ======================================================================  -->
    <!--  Implicit styles: Default compact controls in shared-shell windows.  -->
    <!--  ======================================================================  -->
    <!--  Implicit styles: a bare TextBox, ComboBox or CheckBox in a shared-shell window takes the compact roles above  -->

    <!--  Implicit TextBox: Applies the shared default style.  -->
    <Style BasedOn="{StaticResource klcTextBox}" TargetType="TextBox" />
    <!--  Implicit ComboBox: Applies the shared default style.  -->
    <Style BasedOn="{StaticResource klcComboBoxFilter}" TargetType="ComboBox" />
    <!--  Implicit CheckBox: Applies the shared default style.  -->
    <Style BasedOn="{StaticResource klcCheckBox}" TargetType="CheckBox" />

    <!--  ======================================================================  -->
    <!--  WindowShell: Shared header, body and footer.  -->
    <!--  ======================================================================  -->
    <!--  WindowShell: the header band (logo, title, Close), the inset body and the footer band (links, version) around every window body  -->
    <!--  Tag carries the window metadata (Title, VersionText) the header and footer bind to; Content and DataContext stay workflow-owned.  -->

    <!--  klcWindowShell: Shared window header, body and footer shell.  -->
    <Style x:Key="klcWindowShell" TargetType="ContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{StaticResource klcChromeHeight}" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="{StaticResource klcChromeHeight}" />
                        </Grid.RowDefinitions>
                        <!--
                            The body is declared first so keyboard order and initial focus start in the body, then Close, then the footer links;
                            Grid.Row places it visually between the two chrome bands.
                        -->
                        <ContentPresenter
                            x:Name="klcShell_Body"
                            Grid.Row="1"
                            Margin="{StaticResource klcBodyMargin}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <Grid x:Name="klcShell_Header" Grid.Row="0">

                            <!--
                                1. Center Layer: Sits across the full width of the header.
                                Symmetrical margins (110 on both sides) create a safe bounding box
                                so a long title will truncate via CharacterEllipsis before colliding with your elements.
                            -->
                            <TextBlock
                                x:Name="klcHeader_title"
                                Margin="110,0,110,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Panel.ZIndex="0"
                                FontSize="{StaticResource klcFontSizeShellTitle}"
                                Text="{Binding Tag.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />

                            <!--  2. Left Overlay: Logo fixed to the left edge  -->
                            <ContentControl
                                x:Name="klcHeader_logo"
                                Width="{StaticResource klcLogoWidth}"
                                Height="{StaticResource klcLogoHeight}"
                                Margin="{StaticResource klcHeadFootMargin}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Panel.ZIndex="1"
                                ContentTemplate="{StaticResource klcLogo}"
                                Focusable="False"
                                IsHitTestVisible="False" />

                            <!--  3. Right Overlay: Close Button fixed to the right edge  -->
                            <Button
                                x:Name="klcHeader_close"
                                Margin="{StaticResource klcHeadFootMargin}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Panel.ZIndex="1"
                                AutomationProperties.Name="Close window"
                                Style="{StaticResource klcButtonClose}" />
                        </Grid>
                        <Grid x:Name="klcShell_Footer" Grid.Row="2">
                            <!--
                                1. Center Layer: Spans the full width of the footer row.
                                Symmetrical margins (110 on both sides) ensure the version string truncates
                                before it can ever visually collide with your links on the edges.
                            -->
                            <TextBlock
                                x:Name="klcFooter_version"
                                Margin="110,0,110,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Panel.ZIndex="0"
                                AutomationProperties.Name="Tool version"
                                FontSize="{StaticResource klcFontSizeShellVersion}"
                                Foreground="{StaticResource klcFooterVersionColor}"
                                Text="{Binding Tag.VersionText, RelativeSource={RelativeSource TemplatedParent}}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            <!--  2. Left Layer: Prototype Link floated to the left edge  -->
                            <TextBlock
                                Margin="{StaticResource klcHeadFootMargin}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Panel.ZIndex="1">
                                <Hyperlink
                                    x:Name="klcFooter_prototype"
                                    NavigateUri="{StaticResource klcPrototypeUri}"
                                    Style="{StaticResource klcLinkFooter}">
                                    <Run Text="Prototype" />
                                </Hyperlink>
                            </TextBlock>
                            <!--  3. Right Layer: Outreach Link floated to the right edge  -->
                            <TextBlock
                                Margin="{StaticResource klcHeadFootMargin}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Panel.ZIndex="1">
                                <Hyperlink
                                    x:Name="klcFooter_outreach"
                                    NavigateUri="{StaticResource klcOutreachUri}"
                                    Style="{StaticResource klcLinkFooter}">
                                    <Run Text="Outreach" />
                                </Hyperlink>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ======================================================================  -->
    <!--  Details Dialog Components  -->
    <!--  ======================================================================  -->

    <!--  klcExpanderDetails: Muted details disclosure used in message and action-choice dialogs.  -->
    <!--  Details disclosure (Message, Action Choice): muted, details size, with the 16 chevron the Foundation toggle draws.  -->
    <Style
        x:Key="klcExpanderDetails"
        BasedOn="{StaticResource klcFdnExpander}"
        TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource klcTextColorMuted}" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeDetails}" />
    </Style>


    <!--  ======================================================================  -->
    <!--  x  tier: used only by windows that are not shared dialogs (tool windows, templates, the Gallery, compiled C# hosts).  -->
    <!--  ======================================================================  -->

    <!--  ======================================================================  -->
    <!--  Tool window message border.  -->
    <!--  ======================================================================  -->
    <!--  xBorderMessage: Message border with the component border colour.  -->
    <Style
        x:Key="xBorderMessage"
        BasedOn="{StaticResource klcFdnBorder}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
    </Style>

    <!--  ======================================================================  -->
    <!--  Tool window text.  -->
    <!--  ======================================================================  -->
    <!--  x: text  -->

    <!--  xText: Foundation text style alias for tool windows.  -->
    <Style
        x:Key="xText"
        BasedOn="{StaticResource klcFdnTextBlock}"
        TargetType="TextBlock" />

    <!--  ======================================================================  -->
    <!--  Tool window icons.  -->
    <!--  ======================================================================  -->
    <!--  x: icons. The unsized alias of klcFdnIcon (16 by default); the shared dialogs name a size instead.  -->

    <!--  xIcon: Unsized foundation icon presenter for tool windows.  -->
    <!--  Only used in SteelPsfDialog  -->
    <Style
        x:Key="xIcon"
        BasedOn="{StaticResource klcFdnIcon}"
        TargetType="ContentControl" />

    <!--  ======================================================================  -->
    <!--  Tool window status chips.  -->
    <!--  ======================================================================  -->
    <!--  x: status chips  -->

    <!--  xStatusChip: Base bordered status chip.  -->
    <!--  Only used in KLC-ReviewTemp (through derived styles)  -->
    <Style
        x:Key="xStatusChip"
        BasedOn="{StaticResource klcFdnBorder}"
        TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource xRadiusChip}" />
        <Setter Property="Padding" Value="{StaticResource KlaCompactInset}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!--  xTableStatusChip: Status chip centred in a table cell.  -->
    <!--  Only used in KLC-ReviewTemp (through xStatusTagChip)  -->
    <Style
        x:Key="xTableStatusChip"
        BasedOn="{StaticResource xStatusChip}"
        TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!--  xStatusWarning: Status chip with a warning-coloured border.  -->
    <Style
        x:Key="xStatusWarning"
        BasedOn="{StaticResource xStatusChip}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource klcWarningColor}" />
    </Style>
    <!--  xStatusError: Status chip with an error-coloured border.  -->
    <Style
        x:Key="xStatusError"
        BasedOn="{StaticResource xStatusChip}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource klcErrorColor}" />
    </Style>
    <!--  xStatusTagChip: Table chip whose border colour follows its status Tag.  -->
    <!--  Only used in KLC-ReviewTemp  -->
    <!--  A chip whose colour follows its Tag (Ready, Warning or Blocked), for a table cell that binds a status value.  -->
    <Style
        x:Key="xStatusTagChip"
        BasedOn="{StaticResource xTableStatusChip}"
        TargetType="Border">
        <Style.Triggers>
            <Trigger Property="Tag" Value="Ready">
                <Setter Property="BorderBrush" Value="{StaticResource klcSuccessColor}" />
            </Trigger>
            <Trigger Property="Tag" Value="Warning">
                <Setter Property="BorderBrush" Value="{StaticResource klcWarningColor}" />
            </Trigger>
            <Trigger Property="Tag" Value="Blocked">
                <Setter Property="BorderBrush" Value="{StaticResource klcErrorColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--  xStatusText: Text inside a status chip.  -->
    <!--  Only used in KLC-ReviewTemp  -->
    <!--  The caption inside a status chip.  -->
    <Style
        x:Key="xStatusText"
        BasedOn="{StaticResource klcFdnTextBlock}"
        TargetType="TextBlock" />

    <!--  ======================================================================  -->
    <!--  Tool window surface buttons.  -->
    <!--  ======================================================================  -->
    <!--  x: surface buttons  -->
    <!--
        Link: a text action on the surface (Clear filters, Favorites, Recent) — transparent at rest, surface on hover, the same
        role width and keyboard-only focus adorner as every button. Ghost: the same with a hairline border (Cancel beside a main action).
    -->

    <!--  xLinkButton: Surface-level text action with a transparent background.  -->
    <Style
        x:Key="xLinkButton"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Style.Resources>
            <SolidColorBrush x:Key="klcButtonHoverBrush" Color="{Binding Color, Source={StaticResource KlaComponentSurfaceBrush}}" />
            <SolidColorBrush x:Key="klcButtonDisabledBrush" Color="Transparent" />
        </Style.Resources>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
    </Style>
    <!--  xGhostButton: Surface-level action with a visible border.  -->
    <Style
        x:Key="xGhostButton"
        BasedOn="{StaticResource xLinkButton}"
        TargetType="Button">
        <Setter Property="BorderBrush" Value="{StaticResource KlaBorderStrongBrush}" />
    </Style>

    <!--  ======================================================================  -->
    <!--  Tool window read-only fields.  -->
    <!--  ======================================================================  -->
    <!--  x: read-only fields  -->

    <!--  xReadOnlyField: Muted read-only text field.  -->
    <!--  Only used in KLC-OptionsTemp (through xCompactReadOnlyField)  -->
    <Style
        x:Key="xReadOnlyField"
        BasedOn="{StaticResource klcFdnTextBoxInput}"
        TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColorMuted}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <!--  xCompactReadOnlyField: Read-only field at the compact field height.  -->
    <!--  Only used in KLC-OptionsTemp  -->
    <Style
        x:Key="xCompactReadOnlyField"
        BasedOn="{StaticResource xReadOnlyField}"
        TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource klcFieldHeightNormal}" />
    </Style>

    <!--  ======================================================================  -->
    <!--  Tool window exclusive choices.  -->
    <!--  ======================================================================  -->
    <!--  x: exclusive choices  -->

    <!--  xRadioButton: Foundation radio button alias.  -->
    <Style
        x:Key="xRadioButton"
        BasedOn="{StaticResource klaFoundationRadioButton}"
        TargetType="RadioButton" />
    <!--  xSegmentButton: Exclusive choice displayed as a pill segment.  -->
    <!--
        Segment: an exclusive choice drawn as a filled pill segment, not a radio circle (Family Studio's Families / Views,
        This Project / Library, List / Grid inside a KlaBorderStrongBrush pill).
    -->
    <Style
        x:Key="xSegmentButton"
        BasedOn="{StaticResource klaFoundationRadioButton}"
        TargetType="RadioButton">
        <Setter Property="Height" Value="{StaticResource klcButtonHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="SegmentBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent">
                        <Grid>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource KlaAccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource KlaTextOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource klcTextColorDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ======================================================================  -->
    <!--  Tool window field layouts.  -->
    <!--  ======================================================================  -->
    <!--  x: field layouts  -->

    <!--  xFilteredCheckList: Fixed layout for a filter and check list.  -->
    <!--  Only used in SteelPsfDialog  -->
    <Style x:Key="xFilteredCheckList" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource klcBodySpaceSmall}" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ======================================================================  -->
    <!--  Tool window data grid.  -->
    <!--  ======================================================================  -->
    <!--  x: data grid  -->
    <!--  Cell text follows the cell's foreground, so selected and disabled rows recolour it.  -->

    <!--  xDataGridText: Cell text that inherits its cell's foreground and trims overflow.  -->
    <!--  Only used in KLC-ReviewTemp  -->
    <Style x:Key="xDataGridText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!--  xDataGridCell: Foundation data grid cell alias.  -->
    <!--  Only used in KLC-ReviewTemp (through xDataGridStatusCell)  -->
    <Style
        x:Key="xDataGridCell"
        BasedOn="{StaticResource klaFoundationDataGridCell}"
        TargetType="DataGridCell" />
    <!--  xDataGridStatusCell: Data grid cell with centred content.  -->
    <!--  Only used in KLC-ReviewTemp  -->
    <Style
        x:Key="xDataGridStatusCell"
        BasedOn="{StaticResource xDataGridCell}"
        TargetType="DataGridCell">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!--  xDataGrid: Foundation data grid alias.  -->
    <Style
        x:Key="xDataGrid"
        BasedOn="{StaticResource klaFoundationDataGrid}"
        TargetType="DataGrid" />

    <!--  ======================================================================  -->
    <!--  Tool window splitter.  -->
    <!--  ======================================================================  -->
    <!--  x: splitter  -->

    <!--  xSplitter: Foundation grid splitter alias.  -->
    <!--  Only used in KLC-ReviewTemp  -->
    <Style
        x:Key="xSplitter"
        BasedOn="{StaticResource klaFoundationGridSplitter}"
        TargetType="GridSplitter" />

    <!--  ======================================================================  -->
    <!--  xx tier: used only by lib/GUI/_future windows, which no tool opens yet.  -->
    <!--  ======================================================================  -->

    <!--  xxToggle: Toggle button with an accent background when checked.  -->
    <!--  Checked fills the button's own Background, so the template's hover, pressed and disabled fills still take precedence over it.  -->
    <Style
        x:Key="xxToggle"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="ToggleButton">
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--  xxIconTextButton: Foundation button sized for an icon and text.  -->
    <Style
        x:Key="xxIconTextButton"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource xxIconTextButtonWidth}" />
    </Style>
    <!--  xxIconButton: Compact button sized for an icon.  -->
    <Style
        x:Key="xxIconButton"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource xxIconButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource klcButtonHeight}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--  ======================================================================  -->
    <!--  xxx tier: no consumer anywhere (Python, compiled C#, Gallery, future). Candidates for deletion, except the plain aliases  -->
    <!--  xxxLabel, xxxComboBoxItem, xxxDataGridHeader and xxxDataGridRow, which give their Foundation base its Components alias.  -->
    <!--  ======================================================================  -->

    <!--  xxxStatusReady: Status chip with a success-coloured border.  -->
    <Style
        x:Key="xxxStatusReady"
        BasedOn="{StaticResource xStatusChip}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource klcSuccessColor}" />
    </Style>
    <!--  xxxLabel: Foundation label alias.  -->
    <Style
        x:Key="xxxLabel"
        BasedOn="{StaticResource klcFdnLabel}"
        TargetType="Label" />
    <!--  xxxButtonClose: Close button alias.  -->
    <Style
        x:Key="xxxButtonClose"
        BasedOn="{StaticResource klcButtonClose}"
        TargetType="Button" />
    <!--  xxxComboBoxItem: Foundation combo box item alias.  -->
    <Style
        x:Key="xxxComboBoxItem"
        BasedOn="{StaticResource klaFoundationComboBoxItem}"
        TargetType="ComboBoxItem" />
    <!--  xxxDataGridHeader: Foundation data grid header alias.  -->
    <Style
        x:Key="xxxDataGridHeader"
        BasedOn="{StaticResource klaFoundationDataGridHeader}"
        TargetType="DataGridColumnHeader" />
    <!--  xxxDataGridRow: Foundation data grid row alias.  -->
    <Style
        x:Key="xxxDataGridRow"
        BasedOn="{StaticResource klaFoundationDataGridRow}"
        TargetType="DataGridRow" />
</ResourceDictionary>
