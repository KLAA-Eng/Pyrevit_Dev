<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="KLCodeFoundation.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="KlaSection" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KlaWindowBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KlaBorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource KlaHairline}"/>
        <Setter Property="CornerRadius" Value="{StaticResource KlaRadiusCard}"/>
        <Setter Property="Padding" Value="{StaticResource KlaSectionPadding}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="KlaSectionHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaTitleFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="KlaPromptText" TargetType="TextBlock" BasedOn="{StaticResource KlaSectionHeading}">
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="KlaFieldLabel" TargetType="Label" BasedOn="{StaticResource KlaFoundationLabel}"/>
    <Style x:Key="KlaCompactFieldLabel" TargetType="Label" BasedOn="{StaticResource KlaFieldLabel}">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="KlaCompactFieldInput" TargetType="TextBox" BasedOn="{StaticResource KlaFoundationInput}">
        <Setter Property="Height" Value="{StaticResource KlaCompactFieldHeight}"/>
    </Style>
    <!-- UIElement items remain their own containers. Names and event handlers
         stay in the window's namescope; only the repeated layout is shared. -->
    <Style x:Key="KlaFieldRows" TargetType="ItemsControl">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource KlaCompactFieldLabelColumn}"/>
                    <ColumnDefinition Width="{StaticResource KlaCompactFieldInputColumn}"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{StaticResource KlaCompactFieldRow}"/><RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                    <RowDefinition Height="{StaticResource KlaCompactFieldRow}"/><RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                    <RowDefinition Height="{StaticResource KlaCompactFieldRow}"/><RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                    <RowDefinition Height="{StaticResource KlaCompactFieldRow}"/>
                </Grid.RowDefinitions>
            </Grid>
        </ItemsPanelTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KlaFilteredCheckList" TargetType="ItemsControl">
        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{StaticResource KlaFilterRow}"/><RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="{StaticResource KlaGridSpace4}"/>
                    <RowDefinition Height="*"/><RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                    <RowDefinition Height="{StaticResource KlaControlRow}"/>
                </Grid.RowDefinitions>
            </Grid>
        </ItemsPanelTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KlaInfoText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource KlaMutedBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="KlaReadOnlyField" TargetType="TextBox" BasedOn="{StaticResource KlaFoundationInput}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource KlaMutedBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="KlaMultilineReadout" TargetType="TextBox" BasedOn="{StaticResource KlaFoundationInput}">
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="MinHeight" Value="{StaticResource KlaReadoutMinHeight}"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="{StaticResource KlaReadoutPadding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}"/>
    </Style>

    <Style x:Key="KlaCompactReadOnlyField" TargetType="TextBox" BasedOn="{StaticResource KlaReadOnlyField}">
        <Setter Property="Height" Value="{StaticResource KlaCompactFieldHeight}"/>
    </Style>

    <Style x:Key="KlaComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource KlaWindowBrush}"/>
        <Setter Property="Padding" Value="{StaticResource KlaCompactInset}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="{StaticResource KlaHairline}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource KlaPressedBrush}"/></Trigger>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource KlaFocusBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KlaComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}"/>
        <Setter Property="Height" Value="{StaticResource KlaControlHeight}"/>
        <Setter Property="MinWidth" Value="{StaticResource KlaButtonWidth}"/>
        <Setter Property="MaxDropDownHeight" Value="{StaticResource KlaDropDownMaxHeight}"/>
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource KlaWindowBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KlaBorderBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource KlaComboBoxItem}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                              Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="DropDownBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{StaticResource KlaHairline}" CornerRadius="{StaticResource KlaRadiusControl}">
                            <Path Data="M 0,0 L 8,0 L 4,4 Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{StaticResource KlaComboArrowInset}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DropDownBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="DropDownBorder" Property="Background" Value="{StaticResource KlaPressedBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="DropDownBorder" Property="Background" Value="{StaticResource KlaDisabledFillBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <!-- Selection text must not intercept clicks intended for the full-surface toggle. -->
                <ContentPresenter IsHitTestVisible="False" Margin="{StaticResource KlaComboTextInset}" VerticalAlignment="Center"
                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                <Border x:Name="ComboFocus" IsHitTestVisible="False" BorderThickness="{StaticResource KlaHairline}" BorderBrush="Transparent" CornerRadius="{StaticResource KlaRadiusControl}"/>
                <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True"
                       IsOpen="{TemplateBinding IsDropDownOpen}">
                    <Border Background="{StaticResource KlaWindowBrush}" BorderBrush="{StaticResource KlaBorderBrush}" BorderThickness="{StaticResource KlaHairline}"
                            MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFocus" Property="BorderBrush" Value="{StaticResource KlaFocusBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}"/>
                    <Setter Property="Background" Value="{StaticResource KlaDisabledFillBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="KlaCompactComboBox" TargetType="ComboBox" BasedOn="{StaticResource KlaComboBox}">
        <Setter Property="Height" Value="{StaticResource KlaCompactFieldHeight}"/>
    </Style>

    <Style x:Key="KlaRadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}"/>
        <Setter Property="MinHeight" Value="{StaticResource KlaCompactHeight}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource KlaGridSpace16}"/><ColumnDefinition Width="{StaticResource KlaGridSpace4}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="RadioBorder" Width="{StaticResource KlaCheckSize}" Height="{StaticResource KlaCheckSize}" CornerRadius="{StaticResource KlaRadiusRadio}" BorderThickness="{StaticResource KlaHairline}" BorderBrush="{StaticResource KlaBorderBrush}" Background="{StaticResource KlaWindowBrush}" VerticalAlignment="Center">
                    <Ellipse x:Name="RadioMark" Width="{StaticResource KlaRadioDotSize}" Height="{StaticResource KlaRadioDotSize}" Fill="{StaticResource KlaTextBrush}" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="RadioMark" Property="Visibility" Value="Visible"/><Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource KlaAccentBrush}"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource KlaPressedBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RadioBorder" Property="BorderBrush" Value="{StaticResource KlaFocusBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KlaToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource KlaButtonWidth}"/>
        <Setter Property="Height" Value="{StaticResource KlaCompactHeight}"/>
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}"/>
        <Setter Property="Padding" Value="{StaticResource KlaInputPadding}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" CornerRadius="{StaticResource KlaRadiusCard}" Padding="{TemplateBinding Padding}">
                <Grid>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    <Border x:Name="ToggleFocus" Height="{StaticResource KlaFocusMarkHeight}" Margin="{StaticResource KlaFocusMarkInset}" VerticalAlignment="Bottom" Background="{StaticResource KlaFocusBrush}" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource KlaAccentBrush}"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource KlaPressedBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleFocus" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource KlaDisabledFillBrush}"/><Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KlaSecondaryButton" TargetType="Button" BasedOn="{StaticResource KlaFoundationButton}">
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}"/>
    </Style>
    <!-- Link: a text action on the surface (Clear filters, Favorites, Recent) — transparent at rest, surface on hover, the same
         role width and focus mark as every button. Ghost: the same with a hairline border (Cancel beside a main action). -->
    <Style x:Key="KlaLinkButton" TargetType="Button" BasedOn="{StaticResource KlaFoundationButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="LinkBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{StaticResource KlaHairline}" CornerRadius="{StaticResource KlaRadiusCard}" Padding="{TemplateBinding Padding}">
                <Grid>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    <Border x:Name="FocusMark" Height="{StaticResource KlaFocusMarkHeight}" Margin="{StaticResource KlaFocusMarkInset}" VerticalAlignment="Bottom" Background="{StaticResource KlaFocusBrush}" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LinkBorder" Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="LinkBorder" Property="Background" Value="{StaticResource KlaPressedBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusMark" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KlaGhostButton" TargetType="Button" BasedOn="{StaticResource KlaLinkButton}">
        <Setter Property="BorderBrush" Value="{StaticResource KlaBorderStrongBrush}"/>
    </Style>
    <!-- Segment: an exclusive choice drawn as a filled pill segment, not a radio circle (Family Studio's Families / Views,
         This Project / Library, List / Grid inside a KlaBorderStrongBrush pill). -->
    <Style x:Key="KlaSegmentButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}"/>
        <Setter Property="Height" Value="{StaticResource KlaCompactHeight}"/>
        <Setter Property="Padding" Value="{StaticResource KlaInputPadding}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="SegmentBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
                <Grid>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    <Border x:Name="FocusMark" Height="{StaticResource KlaFocusMarkHeight}" Margin="{StaticResource KlaFocusMarkInset}" VerticalAlignment="Bottom" Background="{StaticResource KlaFocusBrush}" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource KlaAccentBrush}"/><Setter Property="Foreground" Value="{StaticResource KlaTextOnAccentBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusMark" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KlaIconTextButton" TargetType="Button" BasedOn="{StaticResource KlaFoundationButton}">
        <Setter Property="Width" Value="{StaticResource KlaIconTextButtonWidth}"/>
    </Style>
    <Style x:Key="KlaIconButton" TargetType="Button" BasedOn="{StaticResource KlaFoundationButton}">
        <Setter Property="Width" Value="{StaticResource KlaIconButtonWidth}"/><Setter Property="Height" Value="{StaticResource KlaCompactHeight}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="KlaStatusChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource KlaHairline}"/>
        <Setter Property="CornerRadius" Value="{StaticResource KlaRadiusChip}"/>
        <Setter Property="Padding" Value="{StaticResource KlaCompactInset}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="KlaTableStatusChip" TargetType="Border" BasedOn="{StaticResource KlaStatusChip}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="KlaStatusReady" TargetType="Border" BasedOn="{StaticResource KlaStatusChip}"><Setter Property="BorderBrush" Value="{StaticResource KlaReadyBrush}"/></Style>
    <Style x:Key="KlaStatusWarning" TargetType="Border" BasedOn="{StaticResource KlaStatusChip}"><Setter Property="BorderBrush" Value="{StaticResource KlaWarningBrush}"/></Style>
    <Style x:Key="KlaStatusError" TargetType="Border" BasedOn="{StaticResource KlaStatusChip}"><Setter Property="BorderBrush" Value="{StaticResource KlaErrorBrush}"/></Style>
    <Style x:Key="KlaStatusText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="KlaBanner" TargetType="Border" BasedOn="{StaticResource KlaSection}">
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}"/>
    </Style>

    <Style x:Key="KlaDataGridText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="KlaDataGridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="{StaticResource KlaHeaderCellInset}"/>
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource KlaAccentHoverBrush}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="KlaDataGridCell" TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="{StaticResource KlaHairline}"/>
        <Setter Property="Padding" Value="{StaticResource KlaCompactInset}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource KlaPressedBrush}"/><Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource KlaFocusBrush}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="KlaDataGridStatusCell" TargetType="DataGridCell" BasedOn="{StaticResource KlaDataGridCell}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="KlaDataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource KlaWindowBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource KlaPressedBrush}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="KlaDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource KlaWindowBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KlaBorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource KlaHairline}"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource KlaBorderStrongBrush}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource KlaDataGridHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource KlaDataGridCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource KlaDataGridRow}"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>
    <!-- Implicit-style policy (both hosts): a bare TextBox, ComboBox or CheckBox inside a shared-shell window takes the compact
         input, the compact dropdown and the foundation checkbox, so no control falls back to the native look. Every other control
         is opt-in by key. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource KlaCompactFieldInput}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource KlaCompactComboBox}"/>
    <Style TargetType="CheckBox" BasedOn="{StaticResource KlaFoundationCheckBox}"/>

    <!-- Compiled-host brush names (formerly KLCodeCompiledTokens.xaml): aliases of the shared brushes, so one token chain serves both hosts. -->
    <SolidColorBrush x:Key="KlaPanelBrush" Color="{Binding Color, Source={StaticResource KlaComponentSurfaceBrush}}"/>
    <SolidColorBrush x:Key="KlaMutedTextBrush" Color="{Binding Color, Source={StaticResource KlaMutedBrush}}"/>
    <SolidColorBrush x:Key="KlaSubtleTextBrush" Color="{Binding Color, Source={StaticResource KlaMutedBrush}}"/>
    <SolidColorBrush x:Key="KlaBlockingBrush" Color="{Binding Color, Source={StaticResource KlaErrorBrush}}"/>

    <!-- Role-named aliases (the names new XAML should use); the KlaFoundation* keys stay for existing consumers. -->
    <Style x:Key="KlaWindow" TargetType="Window" BasedOn="{StaticResource KlaFoundationWindow}"/>
    <Style x:Key="KlaButton" TargetType="Button" BasedOn="{StaticResource KlaFoundationButton}"/>
    <Style x:Key="KlaButtonPrimary" TargetType="Button" BasedOn="{StaticResource KlaFoundationMainButton}"/>
    <Style x:Key="KlaButtonSecondary" TargetType="Button" BasedOn="{StaticResource KlaSecondaryButton}"/>
    <Style x:Key="KlaButtonClose" TargetType="Button" BasedOn="{StaticResource KlaFoundationCloseButton}"/>
    <Style x:Key="KlaLabel" TargetType="Label" BasedOn="{StaticResource KlaFoundationLabel}"/>
    <Style x:Key="KlaPromptLabel" TargetType="Label" BasedOn="{StaticResource KlaFoundationPromptLabel}"/>
    <Style x:Key="KlaInput" TargetType="TextBox" BasedOn="{StaticResource KlaFoundationInput}"/>
    <Style x:Key="KlaInputCompact" TargetType="TextBox" BasedOn="{StaticResource KlaCompactFieldInput}"/>
    <Style x:Key="KlaFilter" TargetType="TextBox" BasedOn="{StaticResource KlaFoundationFilter}"/>
    <Style x:Key="KlaCheck" TargetType="CheckBox" BasedOn="{StaticResource KlaFoundationCheckBox}"/>
    <Style x:Key="KlaList" TargetType="ListBox" BasedOn="{StaticResource KlaFoundationList}"/>
    <Style x:Key="KlaListItem" TargetType="ListBoxItem" BasedOn="{StaticResource KlaFoundationListItem}"/>
    <Style x:Key="KlaLink" TargetType="Hyperlink" BasedOn="{StaticResource KlaFoundationLink}"/>

    <!-- Opt-in rows for the reusable dialogs; existing tool lists are unaffected. -->
    <Style x:Key="KlaTextPromptInput" TargetType="TextBox" BasedOn="{StaticResource KlaInput}">
        <Setter Property="Height" Value="{StaticResource KlaTextPromptInputHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaTextPromptInputFontSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style x:Key="KlaDialogDescription" TargetType="TextBlock" BasedOn="{StaticResource KlaInfoText}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="KlaDialogCheck" TargetType="CheckBox" BasedOn="{StaticResource KlaCheck}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
            <StackPanel>
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"/>
                <TextBlock Text="{Binding Description}" Style="{StaticResource KlaDialogDescription}"/>
            </StackPanel>
        </DataTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KlaDialogListItem" TargetType="ListBoxItem" BasedOn="{StaticResource KlaListItem}">
        <Setter Property="IsEnabled" Value="{Binding CanSelect}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="KlaSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource KlaComponentBorderBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="MinWidth" Value="{StaticResource KlaSplitterSize}"/><Setter Property="MinHeight" Value="{StaticResource KlaSplitterSize}"/>
        <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
        <Setter Property="KeyboardIncrement" Value="{StaticResource KlaSplitterSize}"/>
        <Setter Property="Focusable" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource KlaAccentHoverBrush}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{StaticResource KlaFocusBrush}"/></Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
