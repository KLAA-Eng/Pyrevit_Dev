<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="KLCodeFoundation.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Role-named styles the windows and dialogs apply, grouped by control family with each base before the styles that
        derive from it. The KlaFoundation* keys in KLCodeFoundation.xaml stay for existing consumers; new XAML uses the
        names here. The implicit TextBox / ComboBox / CheckBox styles apply in both hosts (Python and compiled C#).
    -->

    <!--  Window  -->
    <Style
        x:Key="klcWindow"
        BasedOn="{StaticResource klcFdnWindow}"
        TargetType="Window" />
    <!--  A frameless floating panel such as the Command Switch: the window is transparent and its panel draws the surface.  -->
    <Style
        x:Key="KlaFloatingWindow"
        BasedOn="{StaticResource klcFdnWindow}"
        TargetType="Window">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ShowInTaskbar" Value="False" />
    </Style>

    <!--  Section, banner and text  -->
    <Style x:Key="KlaSection" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource klcWindowColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource KlaRadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource KlaSectionPadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style
        x:Key="KlaBanner"
        BasedOn="{StaticResource KlaSection}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
    </Style>
    <!--  Text styles set only what differs from the window: klcFdnWindow already gives every TextBlock its font, body size and text colour.  -->
    <Style x:Key="KlaSectionHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource klcSectionTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="KlaInfoText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource KlaMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style
        x:Key="KlaDialogDescription"
        BasedOn="{StaticResource KlaInfoText}"
        TargetType="TextBlock">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Labels  -->
    <Style
        x:Key="KlaFieldLabel"
        BasedOn="{StaticResource KlaFoundationLabel}"
        TargetType="Label" />
    <Style
        x:Key="KlaCompactFieldLabel"
        BasedOn="{StaticResource KlaFieldLabel}"
        TargetType="Label">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style
        x:Key="KlaPromptLabel"
        BasedOn="{StaticResource KlaFoundationPromptLabel}"
        TargetType="Label" />

    <!--  Inputs and readouts  -->
    <Style
        x:Key="KlaInput"
        BasedOn="{StaticResource KlaFoundationInput}"
        TargetType="TextBox" />
    <Style
        x:Key="KlaCompactFieldInput"
        BasedOn="{StaticResource KlaFoundationInput}"
        TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource KlaCompactFieldHeight}" />
    </Style>
    <Style
        x:Key="KlaInputCompact"
        BasedOn="{StaticResource KlaCompactFieldInput}"
        TargetType="TextBox" />
    <Style
        x:Key="KlaFilter"
        BasedOn="{StaticResource KlaFoundationFilter}"
        TargetType="TextBox" />
    <!--  Opt-in rows for the reusable dialogs; existing tool lists are unaffected.  -->
    <Style
        x:Key="KlaTextPromptInput"
        BasedOn="{StaticResource KlaInput}"
        TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource KlaTextPromptInputHeight}" />
        <Setter Property="FontSize" Value="{StaticResource klcTextDialogFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style
        x:Key="KlaMultilineReadout"
        BasedOn="{StaticResource KlaFoundationInput}"
        TargetType="TextBox">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="{StaticResource KlaReadoutMinHeight}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource KlaReadoutPadding}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
    </Style>

    <!--  Dropdowns: item, dropdown, compact dropdown  -->
    <Style x:Key="KlaComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Background" Value="{StaticResource klcWindowColor}" />
        <Setter Property="Padding" Value="{StaticResource KlaCompactInset}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border
                        x:Name="ItemBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="{StaticResource klcBorderHairline}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource KlaPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource KlaFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KlaComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcBodyFontSize}" />
        <Setter Property="Height" Value="{StaticResource KlaControlHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource klcButtonWidth}" />
        <Setter Property="MaxDropDownHeight" Value="{StaticResource KlaDropDownMaxHeight}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Background" Value="{StaticResource klcWindowColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource klcBorderColor}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource KlaComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton
                            x:Name="DropDownToggle"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            ClickMode="Press"
                            Focusable="False"
                            Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border
                                        x:Name="DropDownBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{StaticResource klcBorderHairline}"
                                        CornerRadius="{StaticResource KlaRadiusControl}">
                                        <Path
                                            Margin="{StaticResource KlaComboArrowInset}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Data="M 0,0 L 8,0 L 4,4 Z"
                                            Fill="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="DropDownBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="DropDownBorder" Property="Background" Value="{StaticResource KlaPressedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="DropDownBorder" Property="Background" Value="{StaticResource KlaDisabledFillBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!--  Selection text must not intercept clicks intended for the full-surface toggle.  -->
                        <ContentPresenter
                            Margin="{StaticResource KlaComboTextInset}"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="ComboFocus"
                            BorderBrush="Transparent"
                            BorderThickness="{StaticResource klcBorderHairline}"
                            CornerRadius="{StaticResource KlaRadiusControl}"
                            IsHitTestVisible="False" />
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom">
                            <Border
                                MinWidth="{TemplateBinding ActualWidth}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Background="{StaticResource klcWindowColor}"
                                BorderBrush="{StaticResource klcBorderColor}"
                                BorderThickness="{StaticResource klcBorderHairline}">
                                <ScrollViewer
                                    CanContentScroll="True"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboFocus" Property="BorderBrush" Value="{StaticResource KlaFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                            <Setter Property="Background" Value="{StaticResource KlaDisabledFillBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="KlaCompactComboBox"
        BasedOn="{StaticResource KlaComboBox}"
        TargetType="ComboBox">
        <Setter Property="Height" Value="{StaticResource KlaCompactFieldHeight}" />
    </Style>

    <!--  Check boxes  -->
    <Style
        x:Key="KlaCheck"
        BasedOn="{StaticResource KlaFoundationCheckBox}"
        TargetType="CheckBox" />
    <Style
        x:Key="KlaDialogCheck"
        BasedOn="{StaticResource KlaCheck}"
        TargetType="CheckBox">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource KlaDialogDescription}" Text="{Binding Description}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Buttons  -->
    <Style
        x:Key="KlaButton"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button" />
    <Style
        x:Key="klcButtonDouble"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource klcDoubleButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource klcDoubleButtonHeight}" />
        <Setter Property="FontSize" Value="{StaticResource klcButtonFontSizeMain}" />
    </Style>
    <Style
        x:Key="KlaButtonSecondary"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
    </Style>
    
    <!--  Links  -->
    <Style
        x:Key="KlaLink"
        BasedOn="{StaticResource klcFdnLink}"
        TargetType="Hyperlink" />

    <!--  Lists and repeated rows  -->
    <Style
        x:Key="KlaListItem"
        BasedOn="{StaticResource KlaFoundationListItem}"
        TargetType="ListBoxItem" />
    <Style
        x:Key="KlaDialogListItem"
        BasedOn="{StaticResource KlaListItem}"
        TargetType="ListBoxItem">
        <Setter Property="IsEnabled" Value="{Binding CanSelect}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="KlaList"
        BasedOn="{StaticResource KlaFoundationList}"
        TargetType="ListBox" />
    <!--
        UIElement items remain their own containers. Names and event handlers
        stay in the window's namescope; only the repeated layout is shared.
    -->
    <Style x:Key="KlaFieldRows" TargetType="ItemsControl">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource KlaCompactFieldLabelColumn}" />
                            <ColumnDefinition Width="{StaticResource KlaCompactFieldInputColumn}" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                        </Grid.RowDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KlaFilteredCheckList" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource klcBodySpaceSmall}" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="{StaticResource klcBodyRowLarge}" />
                        </Grid.RowDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Details disclosure (Message, Action Choice)  -->
    <!--
        Details disclosure shared by Message and Action Choice: a chevron that turns down when
        expanded, the Expander's own foreground, no focus visual and no native circle.
        Template part names (DetailsToggle, DetailsChevron, DetailsContent) are used by code and probes.
    -->
    <Style x:Key="KlaDetailsToggle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Expander}}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl
                                x:Name="DetailsChevron"
                                Margin="{StaticResource KlaIconTextGap}"
                                VerticalContentAlignment="Center"
                                Content="{StaticResource kliconChevRight}"
                                Foreground="{TemplateBinding Foreground}"
                                Style="{StaticResource KlaGuiIcon}" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="DetailsChevron" Property="Content" Value="{StaticResource kliconChevDown}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KlaDetailsExpander" TargetType="Expander">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton
                            x:Name="DetailsToggle"
                            AutomationProperties.Name="Details"
                            Content="{TemplateBinding Header}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Style="{StaticResource KlaDetailsToggle}" />
                        <ContentPresenter x:Name="DetailsContent" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="DetailsContent" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  A multiline readout whose text aligns with the dialog body (Message Details); the input template comes from KlaFoundationInput.  -->
    <Style
        x:Key="KlaDetailsReadout"
        BasedOn="{StaticResource KlaMultilineReadout}"
        TargetType="TextBox">
        <Setter Property="Padding" Value="{StaticResource KlaDetailsReadoutPadding}" />
    </Style>

    <!--  Command link (Action Choice)  -->
    <!--  TaskDialog-style command link (Action Choice). A simple repo-native arrow; no upstream TaskDialog code or asset.  -->
    <PathGeometry x:Key="KlaCommandArrowGeometry" Figures="M4,12 L20,12 M14,6 L20,12 L14,18" />
    <Style
        x:Key="KlaCommandLink"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Style.Resources>
            <StaticResource x:Key="klcButtonHoverBrush" ResourceKey="KlaComponentSurfaceBrush" />
            <SolidColorBrush x:Key="klcButtonDisabledBrush" Color="Transparent" />
            <StaticResource x:Key="klcButtonRadius" ResourceKey="KlaRadiusControl" />
        </Style.Resources>
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="{StaticResource KlaCommandLinkMinHeight}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!--  Body size for the description; the label sets its own.  -->
        <Setter Property="FontSize" Value="{StaticResource klcBodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
        <Setter Property="Padding" Value="{StaticResource KlaCommandLinkPadding}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource KlaCommandLinkIconColumn}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            Margin="{StaticResource KlaCommandArrowInset}"
                            VerticalAlignment="Top"
                            Content="{StaticResource KlaCommandArrowGeometry}"
                            Style="{StaticResource KlaGuiIcon}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontSize="{StaticResource KlaSubheadingFontSize}"
                                FontWeight="SemiBold"
                                Text="{Binding Label}"
                                TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource KlaDialogDescription}" TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Description}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Command Switch pills  -->
    <Style
        x:Key="KlaCommandButton"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Style.Resources>
            <StaticResource x:Key="klcButtonRadius" ResourceKey="KlaCommandPillRadius" />
        </Style.Resources>
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="{StaticResource klcButtonHeight}" />
        <!--  Stretch: pills on one WrapPanel line share the tallest pill's height.  -->
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="{StaticResource klcBodyFontSize}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaAccentBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
        <Setter Property="Padding" Value="{StaticResource KlaCommandPillInset}" />
        <Setter Property="Margin" Value="{StaticResource KlaCommandPillGap}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock
                        Text="{Binding}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{StaticResource KlaDisabledFillBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="KlaCommandToggle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcBodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
        <Setter Property="Padding" Value="{StaticResource KlaCommandPillInset}" />
        <Setter Property="Margin" Value="{StaticResource KlaCommandPillGap}" />
        <Setter Property="MinHeight" Value="{StaticResource klcButtonHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource KlaCommandPillRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource KlaSwitchToggleColumn}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="SwitchTrack"
                                Width="{StaticResource KlaSwitchTrackWidth}"
                                Height="{StaticResource KlaSwitchTrackHeight}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{StaticResource KlaMutedBrush}"
                                CornerRadius="{StaticResource KlaSwitchTrackRadius}">
                                <Ellipse
                                    x:Name="SwitchThumb"
                                    Width="{StaticResource KlaSwitchThumbSize}"
                                    Height="{StaticResource KlaSwitchThumbSize}"
                                    HorizontalAlignment="Left"
                                    Fill="{StaticResource klcTextColor}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Content}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource klcBorderColor}" />
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <!--  No hover change on toggles (owner, 2026-10-31): the pill keeps its surface under the pointer.  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                            <Setter Property="Background" Value="{StaticResource KlaDisabledFillBrush}" />
                            <Setter TargetName="SwitchThumb" Property="Fill" Value="{StaticResource KlaDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Implicit styles: a bare TextBox, ComboBox or CheckBox in a shared-shell window takes the compact roles above  -->
    <Style BasedOn="{StaticResource KlaCompactFieldInput}" TargetType="TextBox" />
    <Style BasedOn="{StaticResource KlaCompactComboBox}" TargetType="ComboBox" />
    <Style BasedOn="{StaticResource KlaFoundationCheckBox}" TargetType="CheckBox" />

    <!--  ======================================================================  -->
    <!--  x  tier: used only by windows that are not shared dialogs (tool windows, templates, the Gallery, compiled C# hosts).  -->
    <!--  ======================================================================  -->

    <!--  x: text and readouts  -->
    <Style
        x:Key="xPromptText"
        BasedOn="{StaticResource KlaSectionHeading}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style
        x:Key="xReadOnlyField"
        BasedOn="{StaticResource KlaFoundationInput}"
        TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource KlaMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style
        x:Key="xCompactReadOnlyField"
        BasedOn="{StaticResource xReadOnlyField}"
        TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource KlaCompactFieldHeight}" />
    </Style>

    <!--  x: exclusive choices  -->
    <!--
        Mirrors KlaFoundationCheckBox with a round box and a dot. RadioButton is not a CheckBox, so it cannot be BasedOn it;
        keep the column layout, wrapping caption and state fills in step with the check box when either changes.
    -->
    <Style x:Key="xRadioButton" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcBodyFontSize}" />
        <Setter Property="MinHeight" Value="{StaticResource klcButtonHeight}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource klcBodySpaceLarge}" />
                            <ColumnDefinition Width="{StaticResource klcBodySpaceSmall}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="RadioBorder"
                            Width="{StaticResource KlaCheckSize}"
                            Height="{StaticResource KlaCheckSize}"
                            VerticalAlignment="Center"
                            Background="{StaticResource klcWindowColor}"
                            BorderBrush="{StaticResource klcBorderColor}"
                            BorderThickness="{StaticResource klcBorderHairline}"
                            CornerRadius="{StaticResource xRadiusRadio}">
                            <Ellipse
                                x:Name="RadioMark"
                                Width="{StaticResource xRadioDotSize}"
                                Height="{StaticResource xRadioDotSize}"
                                Fill="{StaticResource klcTextColor}"
                                Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RadioMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource KlaAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource KlaPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                            <Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource KlaDisabledFillBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--
        Segment: an exclusive choice drawn as a filled pill segment, not a radio circle (Family Studio's Families / Views,
        This Project / Library, List / Grid inside a KlaBorderStrongBrush pill).
    -->
    <Style x:Key="xSegmentButton" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcBodyFontSize}" />
        <Setter Property="Height" Value="{StaticResource klcButtonHeight}" />
        <Setter Property="Padding" Value="{StaticResource KlaInputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="SegmentBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent">
                        <Grid>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource KlaAccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource KlaTextOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  x: surface buttons  -->
    <!--
        Link: a text action on the surface (Clear filters, Favorites, Recent) — transparent at rest, surface on hover, the same
        role width and keyboard-only focus adorner as every button. Ghost: the same with a hairline border (Cancel beside a main action).
    -->
    <Style
        x:Key="xLinkButton"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Style.Resources>
            <StaticResource x:Key="klcButtonHoverBrush" ResourceKey="KlaComponentSurfaceBrush" />
            <SolidColorBrush x:Key="klcButtonDisabledBrush" Color="Transparent" />
        </Style.Resources>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
    </Style>
    <Style
        x:Key="xGhostButton"
        BasedOn="{StaticResource xLinkButton}"
        TargetType="Button">
        <Setter Property="BorderBrush" Value="{StaticResource KlaBorderStrongBrush}" />
    </Style>

    <!--  x: status chips  -->
    <Style x:Key="xStatusChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource xRadiusChip}" />
        <Setter Property="Padding" Value="{StaticResource KlaCompactInset}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style
        x:Key="xTableStatusChip"
        BasedOn="{StaticResource xStatusChip}"
        TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style
        x:Key="xStatusReady"
        BasedOn="{StaticResource xStatusChip}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource klcSuccessColor}" />
    </Style>
    <Style
        x:Key="xStatusWarning"
        BasedOn="{StaticResource xStatusChip}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource klcWarningColor}" />
    </Style>
    <Style
        x:Key="xStatusError"
        BasedOn="{StaticResource xStatusChip}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource klcErrorColor}" />
    </Style>
    <Style x:Key="xStatusText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  x: data grid  -->
    <Style x:Key="xDataGridText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="xDataGridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcBodyFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="{StaticResource xHeaderCellInset}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="xDataGridCell" TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
        <Setter Property="Padding" Value="{StaticResource KlaCompactInset}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaPressedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource KlaFocusBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="xDataGridStatusCell"
        BasedOn="{StaticResource xDataGridCell}"
        TargetType="DataGridCell">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="xDataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource klcWindowColor}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="xDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource klcWindowColor}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcBodyFontSize}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource KlaBorderStrongBrush}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource xDataGridHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource xDataGridCell}" />
        <Setter Property="RowStyle" Value="{StaticResource xDataGridRow}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    </Style>

    <!--  x: splitter  -->
    <Style x:Key="xSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource KlaComponentBorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinWidth" Value="{StaticResource xSplitterSize}" />
        <Setter Property="MinHeight" Value="{StaticResource xSplitterSize}" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="KeyboardIncrement" Value="{StaticResource xSplitterSize}" />
        <Setter Property="Focusable" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaFocusBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ======================================================================  -->
    <!--  xx tier: used only by lib/GUI/_future windows, which no tool opens yet.  -->
    <!--  ======================================================================  -->
    <!--  Checked fills the button's own Background, so the template's hover, pressed and disabled fills still take precedence over it.  -->
    <Style
        x:Key="xxToggle"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="ToggleButton">
        <Setter Property="FontSize" Value="{StaticResource klcBodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="xxIconTextButton"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource xxIconTextButtonWidth}" />
    </Style>
    <Style
        x:Key="xxIconButton"
        BasedOn="{StaticResource klcFdnButton}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource xxIconButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource klcButtonHeight}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--  ======================================================================  -->
    <!--  xxx tier: no consumer anywhere (Python, compiled C#, Gallery, future). Candidates for deletion.  -->
    <!--  ======================================================================  -->
    <Style
        x:Key="xxxButtonClose"
        BasedOn="{StaticResource klcCloseButton}"
        TargetType="Button" />
    <Style
        x:Key="xxxLabel"
        BasedOn="{StaticResource KlaFoundationLabel}"
        TargetType="Label" />

</ResourceDictionary>
