<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Role brushes: the names the foundation and components use. Each value is a KL&A brand colour. -->
    <SolidColorBrush x:Key="KlaWindowBrush" Color="#1A252B" />          <!-- KLCharcoal: window, chrome, fields, lists -->
    <SolidColorBrush x:Key="KlaTextBrush" Color="#E5E4E2" />            <!-- KLWhite: body text, labels, icons -->
    <SolidColorBrush x:Key="KlaTextMutedBrush" Color="#B5C2BD" />       <!-- muted text: footer version and links, captions (8.5:1 on KLCharcoal; Gray was 3.96:1) -->
    <SolidColorBrush x:Key="KlaTextOnAccentBrush" Color="White" />      <!-- labels on accent fills -->
    <SolidColorBrush x:Key="KlaAccentBrush" Color="#286048" />          <!-- KLGreen-dark: action and checked fills -->
    <SolidColorBrush x:Key="KlaAccentHoverBrush" Color="#407058" />     <!-- KLGreen-secondary: hover fills, footer links -->
    <SolidColorBrush x:Key="KlaBorderBrush" Color="#33714F" />          <!-- KLGreen: input and dropdown borders, wordmark slash, scrollbar thumb -->
    <SolidColorBrush x:Key="KlaBorderStrongBrush" Color="#286048" />    <!-- KLGreen-dark: sections, lists, grid lines -->

    <!-- Legacy aliases (2019 names). Consumers that still name these resolve to the role brushes above; new XAML uses the role names. -->
    <StaticResource x:Key="header_background" ResourceKey="KlaWindowBrush" />
    <StaticResource x:Key="text_white" ResourceKey="KlaTextBrush" />
    <StaticResource x:Key="text_gray" ResourceKey="KlaTextMutedBrush" />
    <StaticResource x:Key="text_green" ResourceKey="KlaBorderBrush" />
    <StaticResource x:Key="button_fg_normal" ResourceKey="KlaTextOnAccentBrush" />
    <StaticResource x:Key="button_bg_normal" ResourceKey="KlaAccentBrush" />
    <StaticResource x:Key="button_bg_hover" ResourceKey="KlaAccentHoverBrush" />
    <StaticResource x:Key="border_green_dark" ResourceKey="KlaBorderStrongBrush" />
    <StaticResource x:Key="border_green" ResourceKey="KlaBorderBrush" />
</ResourceDictionary>
