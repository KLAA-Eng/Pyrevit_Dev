<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <!--  Every shared design value: palette, tokens and chrome data (footer destinations and default labels).  -->
        <ResourceDictionary Source="KLCodeTokens.xaml" />
        <!--  Generated icon geometry and the klcLogo template; the KlaGuiIcon presenter below draws the icons.  -->
        <ResourceDictionary Source="klIcons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Base styles: one per control family, each derived style directly under its base. Role-named aliases for new XAML
        live in KLCodeComponents.xaml.
    -->

    <!--  ScrollBarThumb & ScrollBar: charcoal track, green thumb, both orientations  -->
    <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border
                        x:Name="rectangle"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{StaticResource klcBorderColor}"
                        CornerRadius="{StaticResource klcScrollThumbRadius}"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource klcWindowColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource klcWindowColor}" />
        <Setter Property="Opacity" Value="0.9" />
        <Setter Property="Margin" Value="{StaticResource KlaScrollBarMargin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Bg" SnapsToDevicePixels="true">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource KlaScrollBarRadius}" />
                        <!--  Vertical: the Track runs bottom-to-top, so it is reversed.  -->
                        <Track
                            x:Name="PART_Track"
                            IsDirectionReversed="true"
                            IsEnabled="{TemplateBinding IsMouseOver}">
                            <Track.Thumb>
                                <Thumb Margin="{StaticResource KlaScrollThumbMargin}" Style="{StaticResource ScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  Horizontal bars (xDataGrid, Recall's list) share the look; the Track runs left-to-right, so it is not reversed.  -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="false" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  HyperLink: [Enter Notes]  -->
    <!--  Footer links retain the original green and underline; hover/focus is supplied by the foundation link style.  -->
    <Style x:Key="klcFdnLink" TargetType="Hyperlink">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource KlaFocusBrush}" />
            </Trigger>
            <!--  Focus changes colour only (the default dotted focus visual marks it); a weight change would reflow the footer.  -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Foreground" Value="{StaticResource KlaFocusBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ContentControl (GUI icons): [Enter Notes]  -->
    <!-- KlaGuiIcon presents a klicon<Role> geometry at klcIconSize on the KlaIconCanvas with the klcIconStroke pen,
         inheriting the control's foreground; disabled icons take KlaDisabledTextBrush. It is the only way to draw a GUI icon.-->
    <Style x:Key="KlaGuiIcon" TargetType="ContentControl">
        <Setter Property="Width" Value="{StaticResource klcIconSize}" />
        <Setter Property="Height" Value="{StaticResource klcIconSize}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <!--  Rounding places the icon box on whole pixels; the strokes stay anti-aliased so curves and round caps stay smooth when the Viewbox scales them.  -->
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="{StaticResource KlaIconCanvas}" Height="{StaticResource KlaIconCanvas}">
                            <!--
                                Crucial Bindings Intact: Uses your template foreground for Stroke colors,
                                while mapping your global static stroke thickness profile.
                            -->
                            <Path
                                Data="{TemplateBinding Content}"
                                Stroke="{TemplateBinding Foreground}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="{StaticResource klcIconStroke}" />
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ButtonBase: [Enter Notes]  -->
    <!--
        One template for every button variant, ToggleButton included (hence ButtonBase). A variant re-points the klcButton* keys in
        its own Style.Resources rather than copying the template: the state triggers read them by DynamicResource, which resolves
        through the variant's resources before these defaults. Border brush and thickness are ordinary setters.
    -->
    <Style x:Key="klcFdnButton" TargetType="ButtonBase">
        <Style.Resources>
            <StaticResource x:Key="klcButtonHoverBrush" ResourceKey="KlaAccentHoverBrush" />
            <StaticResource x:Key="klcButtonDisabledBrush" ResourceKey="KlaDisabledFillBrush" />
            <StaticResource x:Key="klcButtonRadius" ResourceKey="KlaRadiusButton" />
        </Style.Resources>
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcButtonFontSize}" />
        <Setter Property="Width" Value="{StaticResource klcButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource klcButtonHeight}" />
        <Setter Property="Background" Value="{StaticResource KlaAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KlaTextOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border
                        x:Name="ButtonBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource klcButtonRadius}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource klcButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource KlaPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource klcButtonDisabledBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Label: [Enter Notes]  -->
    <Style x:Key="klcFdnLabel" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcBodyFontSize}" />
    </Style>

    <!--  TextBox: [Enter Notes]  -->
    <Style x:Key="KlaFoundationInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcBodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Background" Value="{StaticResource klcWindowColor}" />
        <Setter Property="CaretBrush" Value="{StaticResource klcTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource klcBorderColor}" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
        <Setter Property="Height" Value="{StaticResource KlaControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource KlaTextBoxPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="InputBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource KlaRadiusControl}">
                        <!--  TextBoxView already applies Padding; a host margin doubles it.  -->
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource KlaFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="KlaFoundationFilter"
        BasedOn="{StaticResource KlaFoundationInput}"
        TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource KlaCompactFieldHeight}" />
        <Setter Property="FontSize" Value="{StaticResource klcGroupSearchFontSize}" />
    </Style>

    <!--  CheckBox: [Enter Notes]  -->
    <Style x:Key="KlaFoundationCheckBox" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcBodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource klcBodySpaceLarge}" />
                            <ColumnDefinition Width="{StaticResource klcBodySpaceSmall}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="CheckBorder"
                            Width="{StaticResource KlaCheckSize}"
                            Height="{StaticResource KlaCheckSize}"
                            VerticalAlignment="Center"
                            Background="{StaticResource klcWindowColor}"
                            BorderBrush="{StaticResource klcBorderColor}"
                            BorderThickness="{StaticResource klcBorderHairline}"
                            CornerRadius="{StaticResource KlaRadiusCheck}">
                            <Grid>
                                <Path
                                    x:Name="CheckMark"
                                    Data="M 2,7 L 5,10 L 12,3"
                                    Stroke="{StaticResource klcTextColor}"
                                    StrokeThickness="{StaticResource KlaCheckStroke}"
                                    Visibility="Collapsed" />
                                <Path
                                    x:Name="IndeterminateMark"
                                    Data="M 3,7 L 11,7"
                                    Stroke="{StaticResource klcTextColor}"
                                    StrokeThickness="{StaticResource KlaCheckStroke}"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaDisabledFillBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ListBoxItem & ListBox: item first, then the list that applies it  -->
    <Style x:Key="KlaFoundationListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Padding" Value="{StaticResource KlaItemPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!--  Keep the native WPF row template used by SelectFromDict, including its blue hover/selection.  -->
    </Style>
    <Style x:Key="KlaFoundationList" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource klcWindowColor}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcBodyFontSize}" />
        <Setter Property="Padding" Value="{StaticResource KlaListPadding}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource KlaFoundationListItem}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{StaticResource KlaBorderStrongBrush}"
                        BorderThickness="{StaticResource klcBorderHairline}"
                        CornerRadius="{StaticResource KlaRadiusButton}">
                        <ScrollViewer
                            CanContentScroll="True"
                            Focusable="False"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--  Window: [Enter Notes]  -->
    <Style x:Key="klcFdnWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource klcWindowColor}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcBodyFontSize}" />
        <!--  Borderless: no non-client frame, so a resizable window must set ResizeMode="CanResizeWithGrip" (CanResize alone has no edge to grab).  -->
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!--  Tag is presentation metadata; Content/DataContext remain workflow-owned.  -->
</ResourceDictionary>
