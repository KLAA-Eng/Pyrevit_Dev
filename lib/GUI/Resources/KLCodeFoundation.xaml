<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <!--  Shared data-only primitives load in loose Python XAML and compiled WPF.  -->
        <ResourceDictionary Source="KLCodeSharedPrimitives.xaml" />
        <ResourceDictionary Source="KLCodeFoundationTokens.xaml" />
        <!--  Footer destinations and default chrome labels, read by both adapters; labels are DynamicResource so locale dictionaries override.  -->
        <ResourceDictionary Source="KLCodeChrome.xaml" />
        <!--  Geometry-only leaf (generated); the KlaGuiIcon presenter below draws it with the tokens.  -->
        <ResourceDictionary Source="../../_icons/gui/KLCodeIcons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- GUI icons: KlaGuiIcon presents a klgeo<Role> geometry at KlaIconSize on the KlaIconCanvas with the KlaIconStroke pen,
         inheriting the control's foreground; disabled icons take KlaDisabledTextBrush. It is the only way to draw a GUI icon.-->
    <Style x:Key="KlaGuiIcon" TargetType="ContentControl">
        <Setter Property="Width" Value="{StaticResource KlaIconSize}" />
        <Setter Property="Height" Value="{StaticResource KlaIconSize}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="{StaticResource KlaIconCanvas}" Height="{StaticResource KlaIconCanvas}">
                            <Path
                                Data="{TemplateBinding Content}"
                                Stroke="{TemplateBinding Foreground}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="{StaticResource KlaIconStroke}" />
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="KlaFoundationWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource KlaWindowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}" />
        <!--  Borderless: no non-client frame, so a resizable window must set ResizeMode="CanResizeWithGrip" (CanResize alone has no edge to grab).  -->
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="KlaFoundationButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}" />
        <Setter Property="Width" Value="{StaticResource KlaButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource KlaCompactHeight}" />
        <Setter Property="Background" Value="{StaticResource KlaAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KlaTextOnAccentBrush}" />
        <Setter Property="Padding" Value="{StaticResource KlaInputPadding}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="ButtonBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="{StaticResource KlaHairline}"
                        CornerRadius="{StaticResource KlaRadiusCard}">
                        <Grid>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource KlaPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource KlaDisabledFillBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="KlaFoundationMainButton"
        BasedOn="{StaticResource KlaFoundationButton}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource KlaMainButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource KlaControlHeight}" />
        <Setter Property="FontSize" Value="{StaticResource KlaTitleFontSize}" />
    </Style>
    <Style
        x:Key="KlaFoundationCloseButton"
        BasedOn="{StaticResource KlaFoundationButton}"
        TargetType="Button">
        <!--  Chrome is the deliberate compact exception to form control sizes.  -->
        <Setter Property="Width" Value="{StaticResource KlaCloseWidth}" />
        <Setter Property="Height" Value="{StaticResource KlaCloseHeight}" />
        <Setter Property="FontSize" Value="{StaticResource KlaCloseFontSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!--
                        Segoe UI's line box is centered, but its visible glyphs sit lower in this 18-unit control: a 2-unit bottom margin lifts
                        the centered block by one unit in layout (DPI-safe), where a RenderTransform would not.
                    -->
                    <TextBlock
                        Margin="{StaticResource KlaCloseGlyphLift}"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Text="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KlaFoundationLabel" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}" />
        <Setter Property="Padding" Value="{StaticResource KlaLabelPadding}" />
    </Style>
    <Style
        x:Key="KlaFoundationPromptLabel"
        BasedOn="{StaticResource KlaFoundationLabel}"
        TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource KlaTitleFontSize}" />
    </Style>
    <Style x:Key="KlaFoundationInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="Background" Value="{StaticResource KlaWindowBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource KlaHairline}" />
        <Setter Property="Height" Value="{StaticResource KlaControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource KlaTextBoxPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="InputBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource KlaRadiusControl}">
                        <!--  TextBoxView already applies Padding; a host margin doubles it.  -->
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource KlaFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="KlaFoundationFilter"
        BasedOn="{StaticResource KlaFoundationInput}"
        TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource KlaFilterHeight}" />
        <Setter Property="FontSize" Value="{StaticResource KlaTitleFontSize}" />
    </Style>
    <Style x:Key="KlaFoundationCheckBox" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"
                        Text="{Binding}"
                        TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource KlaGridSpace16}" />
                            <ColumnDefinition Width="{StaticResource KlaGridSpace4}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="CheckBorder"
                            Width="{StaticResource KlaCheckSize}"
                            Height="{StaticResource KlaCheckSize}"
                            VerticalAlignment="Center"
                            Background="{StaticResource KlaWindowBrush}"
                            BorderBrush="{StaticResource KlaBorderBrush}"
                            BorderThickness="{StaticResource KlaHairline}"
                            CornerRadius="{StaticResource KlaRadiusCheck}">
                            <Grid>
                                <Path
                                    x:Name="CheckMark"
                                    Data="M 2,7 L 5,10 L 12,3"
                                    Stroke="{StaticResource KlaTextBrush}"
                                    StrokeThickness="{StaticResource KlaCheckStroke}"
                                    Visibility="Collapsed" />
                                <Path
                                    x:Name="IndeterminateMark"
                                    Data="M 3,7 L 11,7"
                                    Stroke="{StaticResource KlaTextBrush}"
                                    StrokeThickness="{StaticResource KlaCheckStroke}"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}" />
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaDisabledFillBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KlaFoundationListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="Padding" Value="{StaticResource KlaItemPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!--  Keep the native WPF row template used by SelectFromDict, including its blue hover/selection.  -->
    </Style>
    <Style x:Key="KlaFoundationList" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource KlaWindowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}" />
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}" />
        <Setter Property="Padding" Value="{StaticResource KlaListPadding}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource KlaFoundationListItem}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{StaticResource KlaBorderStrongBrush}"
                        BorderThickness="{StaticResource KlaHairline}"
                        CornerRadius="{StaticResource KlaRadiusCard}">
                        <ScrollViewer
                            CanContentScroll="True"
                            Focusable="False"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="KlaFoundationLink"
        BasedOn="{StaticResource KLCodeFooterLink}"
        TargetType="Hyperlink">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}" />
            </Trigger>
            <!--  Focus changes colour only (the default dotted focus visual marks it); a weight change would reflow the footer.  -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Foreground" Value="{StaticResource KlaFocusBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Tag is presentation metadata; Content/DataContext remain workflow-owned.  -->
    <Style x:Key="KlaWindowShell" TargetType="ContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Background="{StaticResource KlaWindowBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{StaticResource KlaChromeRow}" />
                            <RowDefinition Height="*" />
                            <RowDefinition x:Name="PART_FooterRow" Height="{StaticResource KlaChromeRow}" />
                        </Grid.RowDefinitions>
                        <!--
                            The body is declared first so keyboard order and initial focus start in the body, then Close, then the footer links;
                            Grid.Row places it visually between the two chrome bands.
                        -->
                        <ContentPresenter
                            x:Name="PART_Body"
                            Grid.Row="1"
                            Margin="{StaticResource KlaBodyInset}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <Grid x:Name="PART_Header" Background="{StaticResource KlaWindowBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource KlaHeaderSideColumn}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource KlaHeaderSideColumn}" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                Width="{StaticResource KlaWordmarkWidth}"
                                Height="{StaticResource KlaWordmarkHeight}"
                                Margin="{StaticResource KlaBrandInset}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                ContentTemplate="{StaticResource KLCodeWordmark}"
                                Focusable="False"
                                IsHitTestVisible="False" />
                            <TextBlock
                                x:Name="PART_Title"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource KlaTitleFontSize}"
                                Text="{Binding Tag.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="PART_Close"
                                Grid.Column="2"
                                AutomationProperties.Name="Close window"
                                Content="{DynamicResource CloseLabel}"
                                Style="{StaticResource KlaFoundationCloseButton}" />
                        </Grid>
                        <Grid
                            x:Name="PART_Footer"
                            Grid.Row="2"
                            Margin="{StaticResource KlaFooterInset}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource KlaFooterSideColumn}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource KlaFooterSideColumn}" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"><Hyperlink
                                    x:Name="PART_Prototype"
                                    NavigateUri="{StaticResource KlaPrototypeUri}"
                                    Style="{StaticResource KlaFoundationLink}">
                                    <Run Text="{DynamicResource PrototypeLabel}" />
                                </Hyperlink></TextBlock>
                            <TextBlock
                                x:Name="PART_Version"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Tool version"
                                Foreground="{StaticResource KlaFooterVersionBrush}"
                                Text="{Binding Tag.VersionText, RelativeSource={RelativeSource TemplatedParent}}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"><Hyperlink
                                    x:Name="PART_Outreach"
                                    NavigateUri="{StaticResource KlaOutreachUri}"
                                    Style="{StaticResource KlaFoundationLink}">
                                    <Run Text="{DynamicResource OutreachLabel}" />
                                </Hyperlink></TextBlock>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
