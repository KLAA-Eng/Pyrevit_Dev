<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <!-- Shared data-only primitives load in loose Python XAML and compiled WPF. -->
        <ResourceDictionary Source="KLCodeSharedPrimitives.xaml"/>
        <ResourceDictionary Source="KLCodeFoundationTokens.xaml"/>
        <!-- Footer destinations and default chrome labels, read by both adapters; labels are DynamicResource so locale dictionaries override. -->
        <ResourceDictionary Source="KLCodeChrome.xaml"/>
        <!-- Geometry-only leaf (generated); the presenter, pen and ImageSources below bind it to the tokens. -->
        <ResourceDictionary Source="../../_icons/gui/KLCodeIcons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- GUI icons: KlaGuiIcon presents a Kla<Role>Geometry at KlaIconSize on the KlaIconCanvas with the KlaIconStroke pen,
         inheriting the control's foreground; disabled icons take KlaDisabledTextBrush. KlaIcon<Role> are the same drawings as
         ImageSources for Image.Source consumers. -->
    <Pen x:Key="KlaGuiIconPen" Brush="{StaticResource KlaTextBrush}" Thickness="{StaticResource KlaIconStroke}" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
    <Style x:Key="KlaGuiIcon" TargetType="ContentControl">
        <Setter Property="Width" Value="{StaticResource KlaIconSize}"/>
        <Setter Property="Height" Value="{StaticResource KlaIconSize}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
            <Viewbox Stretch="Uniform">
                <Canvas Width="{StaticResource KlaIconCanvas}" Height="{StaticResource KlaIconCanvas}">
                    <Path Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" StrokeThickness="{StaticResource KlaIconStroke}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Canvas>
            </Viewbox>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}"/></Trigger>
        </Style.Triggers>
    </Style>
