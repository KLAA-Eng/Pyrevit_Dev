    <Style x:Key="KlaFoundationWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource KlaWindowBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}"/>
        <!-- Borderless: no non-client frame, so a resizable window must set ResizeMode="CanResizeWithGrip" (CanResize alone has no edge to grab). -->
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="KlaFoundationButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}"/>
        <Setter Property="Width" Value="{StaticResource KlaButtonWidth}"/>
        <Setter Property="Height" Value="{StaticResource KlaCompactHeight}"/>
        <Setter Property="Background" Value="{StaticResource KlaAccentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource KlaTextOnAccentBrush}"/>
        <Setter Property="Padding" Value="{StaticResource KlaInputPadding}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="Transparent" BorderThickness="{StaticResource KlaHairline}" CornerRadius="{StaticResource KlaRadiusCard}"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource KlaPressedBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource KlaDisabledFillBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KlaFoundationMainButton" TargetType="Button" BasedOn="{StaticResource KlaFoundationButton}">
        <Setter Property="Width" Value="{StaticResource KlaMainButtonWidth}"/>
        <Setter Property="Height" Value="{StaticResource KlaControlHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaTitleFontSize}"/>
    </Style>
    <Style x:Key="KlaFoundationCloseButton" TargetType="Button" BasedOn="{StaticResource KlaFoundationButton}">
        <!-- Chrome is the deliberate compact exception to form control sizes. -->
        <Setter Property="Width" Value="{StaticResource KlaCloseWidth}"/><Setter Property="Height" Value="{StaticResource KlaCloseHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaCloseFontSize}"/><Setter Property="Padding" Value="0"/>
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
            <!-- Segoe UI's line box is centered, but its visible glyphs sit lower in this 18-unit control: a 2-unit bottom margin lifts
                 the centered block by one unit in layout (DPI-safe), where a RenderTransform would not. -->
            <TextBlock Text="{Binding}" Margin="{StaticResource KlaCloseGlyphLift}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </DataTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KlaFoundationLabel" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}"/>
        <Setter Property="Padding" Value="{StaticResource KlaLabelPadding}"/>
    </Style>
    <Style x:Key="KlaFoundationPromptLabel" TargetType="Label" BasedOn="{StaticResource KlaFoundationLabel}">
        <Setter Property="FontSize" Value="{StaticResource KlaTitleFontSize}"/>
    </Style>
    <Style x:Key="KlaFoundationInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource KlaWindowBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KlaBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource KlaHairline}"/>
        <Setter Property="Height" Value="{StaticResource KlaControlHeight}"/>
        <Setter Property="Padding" Value="{StaticResource KlaInputPadding}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
            <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource KlaRadiusControl}">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource KlaFocusBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KlaFoundationFilter" TargetType="TextBox" BasedOn="{StaticResource KlaFoundationInput}">
        <Setter Property="Height" Value="{StaticResource KlaFilterHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaTitleFontSize}"/>
    </Style>
    <Style x:Key="KlaFoundationCheckBox" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"/>
        </DataTemplate></Setter.Value></Setter>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource KlaGridSpace16}"/><ColumnDefinition Width="{StaticResource KlaGridSpace4}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="CheckBorder" Width="{StaticResource KlaCheckSize}" Height="{StaticResource KlaCheckSize}" BorderThickness="{StaticResource KlaHairline}" BorderBrush="{StaticResource KlaBorderBrush}" Background="{StaticResource KlaWindowBrush}" CornerRadius="{StaticResource KlaRadiusCheck}" VerticalAlignment="Center">
                    <Grid>
                        <Path x:Name="CheckMark" Visibility="Collapsed" Data="M 2,7 L 5,10 L 12,3" Stroke="{StaticResource KlaTextBrush}" StrokeThickness="{StaticResource KlaCheckStroke}"/>
                        <Path x:Name="IndeterminateMark" Visibility="Collapsed" Data="M 3,7 L 11,7" Stroke="{StaticResource KlaTextBrush}" StrokeThickness="{StaticResource KlaCheckStroke}"/>
                    </Grid>
                </Border>
                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/><Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaAccentBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible"/><Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaAccentBrush}"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaPressedBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}"/><Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaDisabledFillBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KlaFoundationListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="Padding" Value="{StaticResource KlaItemPadding}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <!-- Keep the native WPF row template used by SelectFromDict, including its blue hover/selection. -->
    </Style>
    <Style x:Key="KlaFoundationList" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource KlaWindowBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}"/>
        <Setter Property="Padding" Value="{StaticResource KlaListPadding}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource KlaFoundationListItem}"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
            <Border BorderThickness="{StaticResource KlaHairline}" BorderBrush="{StaticResource KlaBorderStrongBrush}" Background="{TemplateBinding Background}" CornerRadius="{StaticResource KlaRadiusCard}" Padding="{TemplateBinding Padding}">
                <ScrollViewer Focusable="False" CanContentScroll="True"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"><ItemsPresenter/></ScrollViewer>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KlaFoundationLink" TargetType="Hyperlink" BasedOn="{StaticResource KLCodeFooterLink}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/></Trigger>
            <!-- Focus changes colour only (the default dotted focus visual marks it); a weight change would reflow the footer. -->
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource KlaFocusBrush}"/></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tag is presentation metadata; Content/DataContext remain workflow-owned. -->
    <Style x:Key="KlaWindowShell" TargetType="ContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
            <Grid Background="{StaticResource KlaWindowBrush}">
                <Grid.RowDefinitions><RowDefinition Height="{StaticResource KlaChromeRow}"/><RowDefinition Height="*"/><RowDefinition x:Name="PART_FooterRow" Height="{StaticResource KlaChromeRow}"/></Grid.RowDefinitions>
                <!-- The body is declared first so keyboard order and initial focus start in the body, then Close, then the footer links;
                     Grid.Row places it visually between the two chrome bands. -->
                <ContentPresenter x:Name="PART_Body" Grid.Row="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{StaticResource KlaBodyInset}"/>
                <Grid x:Name="PART_Header" Background="{StaticResource KlaWindowBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource KlaHeaderSideColumn}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="{StaticResource KlaHeaderSideColumn}"/></Grid.ColumnDefinitions>
                    <ContentControl ContentTemplate="{StaticResource KLCodeWordmark}" Width="{StaticResource KlaWordmarkWidth}" Height="{StaticResource KlaWordmarkHeight}" Margin="{StaticResource KlaBrandInset}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False"/>
                    <TextBlock x:Name="PART_Title" Grid.Column="1" Text="{Binding Tag.Title, RelativeSource={RelativeSource TemplatedParent}}" TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{StaticResource KlaTitleFontSize}"/>
                    <Button x:Name="PART_Close" Grid.Column="2" Content="{DynamicResource CloseLabel}" Style="{StaticResource KlaFoundationCloseButton}" AutomationProperties.Name="Close window"/>
                </Grid>
                <Grid x:Name="PART_Footer" Grid.Row="2" Margin="{StaticResource KlaFooterInset}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource KlaFooterSideColumn}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="{StaticResource KlaFooterSideColumn}"/></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"><Hyperlink x:Name="PART_Prototype" NavigateUri="{StaticResource KlaPrototypeUri}" Style="{StaticResource KlaFoundationLink}"><Run Text="{DynamicResource PrototypeLabel}"/></Hyperlink></TextBlock>
                    <TextBlock x:Name="PART_Version" Grid.Column="1" Text="{Binding Tag.VersionText, RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.Name="Tool version" Foreground="{StaticResource KlaFooterVersionBrush}" TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"><Hyperlink x:Name="PART_Outreach" NavigateUri="{StaticResource KlaOutreachUri}" Style="{StaticResource KlaFoundationLink}"><Run Text="{DynamicResource OutreachLabel}"/></Hyperlink></TextBlock>
                </Grid>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
