<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <!--  Every shared design value: palette, tokens and chrome data (footer destinations and default labels).  -->
        <ResourceDictionary Source="KLCodeTokens.xaml" />
        <!--  Generated icon geometry and the klcLogo template; the klcFdnIcon presenter below draws the icons.  -->
        <ResourceDictionary Source="klIcons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Base styles: one per control family, each part style directly above the style that applies it. Windows never use these
        keys; KLCodeComponents.xaml gives each one an alias that changes nothing, plus the variants.
    -->

    <!--  ======================================================================  -->
    <!--  Window: Shared window appearance and text defaults.  -->
    <!--  ======================================================================  -->
    <!--  Window: borderless and transparent on the charcoal surface; every TextBlock inherits its font, body size and colour.  -->

    <!--  klcFdnWindow: Base window surface and inherited text properties.  -->
    <Style x:Key="klcFdnWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource klcBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeBody}" />
        <!--  Borderless: resizable window must set ResizeMode="CanResizeWithGrip"  -->
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--  ======================================================================  -->
    <!--  ScrollBar: Shared track and thumb templates.  -->
    <!--  ======================================================================  -->
    <!--  ScrollBarThumb & ScrollBar: charcoal track, green thumb, both orientations  -->

    <!--  ScrollBarThumb: Thumb template shared by the scrollbar orientations.  -->
    <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border
                        x:Name="rectangle"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{StaticResource klcColorGreen}"
                        CornerRadius="{StaticResource klcScrollThumbRadius}"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  ScrollBar: Implicit scrollbar template for vertical and horizontal tracks.  -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource klcBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource klcBackgroundColor}" />
        <Setter Property="Opacity" Value="0.9" />
        <Setter Property="Margin" Value="{StaticResource KlaScrollBarMargin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Bg" SnapsToDevicePixels="true">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource KlaScrollBarRadius}" />
                        <!--  Vertical: the Track runs bottom-to-top, so it is reversed.  -->
                        <Track
                            x:Name="PART_Track"
                            IsDirectionReversed="true"
                            IsEnabled="{TemplateBinding IsMouseOver}">
                            <!--  The thumb only drags while the pointer is over the bar.  -->
                            <Track.Thumb>
                                <Thumb Margin="{StaticResource KlaScrollThumbMargin}" Style="{StaticResource ScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  Horizontal bars (xDataGrid, Recall's list) share the look; the Track runs left-to-right, so it is not reversed.  -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="false" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ======================================================================  -->
    <!--  TextBlock: Shared text behaviour.  -->
    <!--  ======================================================================  -->
    <!--  TextBlock: wraps; font, size and colour come from klcFdnWindow  -->

    <!--  klcFdnTextBlock: Base wrapping text style.  -->
    <Style x:Key="klcFdnTextBlock" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  ======================================================================  -->
    <!--  Label: Field captions and access keys.  -->
    <!--  ======================================================================  -->
    <!--  Label: a field caption drawn as wrapping AccessText with no padding; Target names the input and "_" marks its Alt key  -->

    <!--  klcFdnLabel: Wrapping access-key label with no padding.  -->
    <Style x:Key="klcFdnLabel" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeBody}" />
        <!--  Not a no-op: WPF's own Label style pads 5 on every side.  -->
        <Setter Property="Padding" Value="0" />
        <!--
            AccessText is what WPF draws a text Label with; declaring it adds wrapping and keeps the Alt shortcut ("_Find").
            Label content is therefore text only, and a tool-supplied caption escapes "_" as "__" (GUI.window_chrome.access_text).
        -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <AccessText Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ======================================================================  -->
    <!--  Hyperlink: Shared link interaction states.  -->
    <!--  ======================================================================  -->
    <!--  Hyperlink: white on hover and keyboard focus; colour and weight at rest come from the variant  -->
    <!--  Footer links retain the original green and underline; hover/focus is supplied by the foundation link style.  -->

    <!--  klcFdnLink: Base hyperlink with hover and keyboard-focus states.  -->
    <Style x:Key="klcFdnLink" TargetType="Hyperlink">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource KlaFocusBrush}" />
            </Trigger>
            <!--  Focus changes colour only (the default dotted focus visual marks it); a weight change would reflow the footer.  -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Foreground" Value="{StaticResource KlaFocusBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ======================================================================  -->
    <!--  Icon: Shared geometry presenter.  -->
    <!--  ======================================================================  -->
    <!--  ContentControl (GUI icons): the one icon presenter; windows apply it through the klaIcon<size> styles in Components  -->
    <!-- klcFdnIcon presents a klicon<Role> geometry at klcIconSize on the KlaIconCanvas with the klcIconStroke pen,
         inheriting the control's foreground; disabled icons take klcTextColorDisabled. It is the only way to draw a GUI icon.-->

    <!--  klcFdnIcon: Icon presenter that draws a supplied geometry.  -->
    <Style x:Key="klcFdnIcon" TargetType="ContentControl">
        <Setter Property="Width" Value="{StaticResource klcIconSize}" />
        <Setter Property="Height" Value="{StaticResource klcIconSize}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <!--  Rounding places the icon box on whole pixels; the strokes stay anti-aliased so curves and round caps stay smooth when the Viewbox scales them.  -->
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="{StaticResource KlaIconCanvas}" Height="{StaticResource KlaIconCanvas}">
                            <!--
                                Crucial Bindings Intact: Uses your template foreground for Stroke colors,
                                while mapping your global static stroke thickness profile.
                            -->
                            <Path
                                Data="{TemplateBinding Content}"
                                Stroke="{TemplateBinding Foreground}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="{StaticResource klcIconStroke}" />
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource klcTextColorDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ======================================================================  -->
    <!--  Border: Shared field group border.  -->
    <!--  ======================================================================  -->
    <!--  Border: bordered field group  -->

    <!--  klcFdnBorder: Base bordered field group.  -->
    <Style x:Key="klcFdnBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource klcBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource klcRadButton}" />
        <Setter Property="Padding" Value="{StaticResource klcSectionPadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!--  ======================================================================  -->
    <!--  Button: Shared button and toggle template.  -->
    <!--  ======================================================================  -->
    <!--  ButtonBase: the one template behind every button and toggle variant  -->
    <!--
        One template for every button variant, ToggleButton included (hence ButtonBase). A variant re-points the klcButton* keys in
        its own Style.Resources rather than copying the template: the state triggers read them by DynamicResource, which resolves
        through the variant's resources before these defaults. Border brush and thickness are ordinary setters.
    -->

    <!--  klcFdnButton: Shared template for buttons and toggles.  -->
    <Style x:Key="klcFdnButton" TargetType="ButtonBase">
        <!--  Typed resources work in both compiled BAML and loose Python XAML.
              StaticResource aliases here lose their dictionary keys in compiled WPF.  -->
        <Style.Resources>
            <SolidColorBrush x:Key="klcButtonHoverBrush" Color="{Binding Color, Source={StaticResource KlaAccentHoverBrush}}" />
            <SolidColorBrush x:Key="klcButtonDisabledBrush" Color="{Binding Color, Source={StaticResource KlaDisabledFillBrush}}" />
            <Style x:Key="klcButtonBorderShape" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource klcRadButton}" />
            </Style>
        </Style.Resources>
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeButton}" />
        <Setter Property="Width" Value="{StaticResource klcButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource klcButtonHeight}" />
        <Setter Property="Background" Value="{StaticResource KlaAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KlaTextOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border
                        x:Name="ButtonBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Style="{DynamicResource klcButtonBorderShape}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True">
                            <!--
                                A text caption becomes AccessText; this wraps and centres it for every variant. A ContentTemplate would
                                also capture icon content, so the caption is styled here instead. Tool captions escape "_" as "__".
                            -->
                            <ContentPresenter.Resources>
                                <Style TargetType="AccessText">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource klcButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource KlaPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource klcButtonDisabledBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource klcTextColorDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ======================================================================  -->
    <!--  Switch: Track and thumb toggle.  -->
    <!--  ======================================================================  -->
    <!--  ToggleButton (switch): a track and thumb beside the caption (Command Switch)  -->

    <!--  klcFoundationSwitch: Toggle switch with a track and sliding thumb.  -->
    <Style x:Key="klcFdnSwitch" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
        <Setter Property="Padding" Value="{StaticResource klcCommandPillInset}" />

        <Setter Property="Height" Value="{StaticResource klcButtonHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource KlaCommandPillRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="SwitchTrack"
                                Width="{StaticResource klcSwitchTrackWidth}"
                                Height="{StaticResource klcSwitchTrackHeight}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{StaticResource klcTextColorDisabled}"
                                CornerRadius="{StaticResource KlaSwitchTrackRadius}">
                                <Ellipse
                                    x:Name="SwitchThumb"
                                    Width="{StaticResource klcSwitchThumbSize}"
                                    Height="{StaticResource klcSwitchThumbSize}"
                                    HorizontalAlignment="Left"
                                    Fill="{StaticResource klcTextColor}" />
                            </Border>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center" Padding="{StaticResource klcSwitchCaptionInset}"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Content}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource klcColorGreen}" />
                            <!--  Checked: the track turns green and the thumb slides right.  -->
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <!--  UnChecked: the thumb slides left.  -->
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Left" />
                        </Trigger>
                        <!--  No hover change on toggles (owner, 2026-10-31): the pill keeps its surface under the pointer.  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource klcTextColorDisabled}" />
                            <Setter Property="Background" Value="{StaticResource KlaDisabledFillBrush}" />
                            <Setter TargetName="SwitchThumb" Property="Fill" Value="{StaticResource klcTextColorDisabled}" />
                            <Setter Property="BorderBrush" Value="{StaticResource KlaDisabledFillBrush}" />
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Left" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ======================================================================  -->
    <!--  TextBox: Shared input template.  -->
    <!--  ======================================================================  -->
    <!--  TextBox: charcoal field with a hairline green border that turns white with focus; the Tag watermark shows while the text is empty  -->

    <!--  klcFdnTextBoxInput: Text input template with focus border and watermark.  -->
    <Style x:Key="klcFdnTextBoxInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeTextBox}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Background" Value="{StaticResource klcBackgroundColor}" />
        <Setter Property="CaretBrush" Value="{StaticResource klcTextColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource klcColorGreen}" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
        <Setter Property="Height" Value="{StaticResource klcFieldHeightNormal}" />
        <Setter Property="Padding" Value="{StaticResource klcPadTextBoxInput}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="InputBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource klcRadTextBox}">
                        <Grid>
                            <!--  TextBoxView already applies Padding; a host margin doubles it.  -->
                            <ScrollViewer x:Name="PART_ContentHost" />
                            <!--
                                Watermark: the TextBox's Tag, shown while the box is empty, in the box's own font, size, weight and
                                alignment so it sits where typed text starts. No Tag, no watermark. A component may give a default
                                Tag; a window that sets Tag replaces it.
                            -->
                            <Border Padding="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <TextBlock
                                    x:Name="Watermark"
                                    Margin="0,0,0,0"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Foreground="{StaticResource klcTextColorWaterMark}"
                                    Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                    TextAlignment="{TemplateBinding TextAlignment}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="Collapsed" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource KlaFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource klcTextColorDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ======================================================================  -->
    <!--  ComboBox: Drop-down items and control.  -->
    <!--  ======================================================================  -->
    <!--  ComboBoxItem & ComboBox: item first, then the box that applies it  -->

    <!--  klaFoundationComboBoxItem: Drop-down item appearance and interaction states.  -->
    <Style x:Key="klaFoundationComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Background" Value="{StaticResource klcBackgroundColor}" />
        <Setter Property="Padding" Value="{StaticResource KlaCompactInset}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border
                        x:Name="ItemBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="{StaticResource klcBorderHairline}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource KlaPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource KlaFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource klcTextColorDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  klaFoundationComboBox: Combo box template using the foundation item style.  -->
    <Style x:Key="klaFoundationComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeBody}" />
        <Setter Property="Height" Value="{StaticResource KlaControlHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource klcButtonWidth}" />
        <Setter Property="MaxDropDownHeight" Value="{StaticResource KlaDropDownMaxHeight}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Background" Value="{StaticResource klcBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource klcColorGreen}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource klaFoundationComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton
                            x:Name="DropDownToggle"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            ClickMode="Press"
                            Focusable="False"
                            Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border
                                        x:Name="DropDownBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{StaticResource klcBorderHairline}"
                                        CornerRadius="{StaticResource klcRadTextBox}">
                                        <Path
                                            Margin="{StaticResource KlaComboArrowInset}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Data="M 0,0 L 8,0 L 4,4 Z"
                                            Fill="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="DropDownBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="DropDownBorder" Property="Background" Value="{StaticResource KlaPressedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="DropDownBorder" Property="Background" Value="{StaticResource KlaDisabledFillBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!--  Selection text must not intercept clicks intended for the full-surface toggle.  -->
                        <ContentPresenter
                            Margin="{StaticResource KlaComboTextInset}"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                            IsHitTestVisible="False" />
                        <!--  The focus ring sits above the toggle, so the hover and pressed fills never hide it.  -->
                        <Border
                            x:Name="ComboFocus"
                            BorderBrush="Transparent"
                            BorderThickness="{StaticResource klcBorderHairline}"
                            CornerRadius="{StaticResource klcRadTextBox}"
                            IsHitTestVisible="False" />
                        <!--  The drop-down is at least as wide as the box.  -->
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom">
                            <Border
                                MinWidth="{TemplateBinding ActualWidth}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Background="{StaticResource klcBackgroundColor}"
                                BorderBrush="{StaticResource klcColorGreen}"
                                BorderThickness="{StaticResource klcBorderHairline}">
                                <ScrollViewer
                                    CanContentScroll="True"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboFocus" Property="BorderBrush" Value="{StaticResource KlaFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource klcTextColorDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ======================================================================  -->
    <!--  CheckBox: Shared check box template.  -->
    <!--  ======================================================================  -->
    <!--  CheckBox: a 16 box in the first column, a wrapping caption in the third; checked, indeterminate, hover, pressed and disabled fills  -->

    <!--  klcFdnCheckBox: Check box template with caption and interaction states.  -->
    <Style x:Key="klcFdnCheckBox" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="CheckBorder"
                            Width="{StaticResource klcCheckBoxSize}"
                            Height="{StaticResource klcCheckBoxSize}"
                            VerticalAlignment="Center"
                            Background="{StaticResource klcBackgroundColor}"
                            BorderBrush="{StaticResource klcColorGreen}"
                            BorderThickness="{StaticResource klcBorderHairline}"
                            CornerRadius="{StaticResource klcRadCheck}">
                            <Grid>
                                <Path
                                    x:Name="CheckMark"
                                    Data="M 2,7 L 5,10 L 12,3"
                                    Stroke="{StaticResource klcTextColor}"
                                    StrokeThickness="{StaticResource klcCheckStroke}"
                                    Visibility="Collapsed" />
                                <Path
                                    x:Name="IndeterminateMark"
                                    Data="M 3,7 L 11,7"
                                    Stroke="{StaticResource klcTextColor}"
                                    StrokeThickness="{StaticResource klcCheckStroke}"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource klcTextColorDisabled}" />
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KlaDisabledFillBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ======================================================================  -->
    <!--  RadioButton: Shared exclusive-choice template.  -->
    <!--  ======================================================================  -->
    <!--  RadioButton: a round box and a dot  -->
    <!--
        Mirrors klcFdnCheckBox. RadioButton is not a CheckBox, so it cannot be BasedOn it; keep the column layout,
        wrapping caption and state fills in step with the check box when either changes.
    -->

    <!--  klaFoundationRadioButton: Radio button template with a circular selection indicator.  -->
    <Style x:Key="klaFoundationRadioButton" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeBody}" />
        <Setter Property="MinHeight" Value="{StaticResource klcButtonHeight}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource klcBodySpaceLarge}" />
                            <ColumnDefinition Width="{StaticResource klcBodySpaceSmall}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="RadioBorder"
                            Width="{StaticResource klcCheckBoxSize}"
                            Height="{StaticResource klcCheckBoxSize}"
                            VerticalAlignment="Center"
                            Background="{StaticResource klcBackgroundColor}"
                            BorderBrush="{StaticResource klcColorGreen}"
                            BorderThickness="{StaticResource klcBorderHairline}"
                            CornerRadius="{StaticResource xRadiusRadio}">
                            <Ellipse
                                x:Name="RadioMark"
                                Width="{StaticResource xRadioDotSize}"
                                Height="{StaticResource xRadioDotSize}"
                                Fill="{StaticResource klcTextColor}"
                                Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RadioMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource KlaAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource KlaPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource klcTextColorDisabled}" />
                            <Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource KlaDisabledFillBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ======================================================================  -->
    <!--  Expander: Details toggle and container.  -->
    <!--  ======================================================================  -->
    <!--  Expander: details disclosure (Message, Action Choice)  -->
    <!--
        The toggle is the expander's header: a chevron that turns down when expanded, in the Expander's own foreground, with no
        focus visual and no native circle. Code and probes use the DetailsToggle, DetailsChevron and DetailsContent part names.
    -->

    <!--  klcFdnExpanderToggle: Toggle that draws the details disclosure chevron.  -->
    <Style x:Key="klcFdnExpanderToggle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Expander}}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl
                                x:Name="DetailsChevron"
                                Margin="{StaticResource KlaIconTextGap}"
                                VerticalContentAlignment="Center"
                                Content="{StaticResource kliconChevRight}"
                                Foreground="{TemplateBinding Foreground}"
                                Style="{StaticResource klcFdnIcon}" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="DetailsChevron" Property="Content" Value="{StaticResource kliconChevDown}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource klcTextColorDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  klcFdnExpander: Expander template using the foundation disclosure toggle.  -->
    <Style x:Key="klcFdnExpander" TargetType="Expander">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton
                            x:Name="DetailsToggle"
                            AutomationProperties.Name="Details"
                            Content="{TemplateBinding Header}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Style="{StaticResource klcFdnExpanderToggle}" />
                        <ContentPresenter x:Name="DetailsContent" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="DetailsContent" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ======================================================================  -->
    <!--  ListBox: List items and container.  -->
    <!--  ======================================================================  -->
    <!--  ListBoxItem & ListBox: item first, then the list that applies it  -->

    <!--  KlaFoundationListItem: List item retaining the native WPF row template.  -->
    <Style x:Key="KlaFoundationListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Padding" Value="{StaticResource KlaItemPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!--  Keep the native WPF row template used by SelectFromDict, including its blue hover/selection.  -->
    </Style>
    <!--  KlaFoundationList: List box template and scrolling behaviour.  -->
    <Style x:Key="KlaFoundationList" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource klcBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeBody}" />
        <Setter Property="Padding" Value="{StaticResource KlaListPadding}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource KlaFoundationListItem}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{StaticResource KlaBorderStrongBrush}"
                        BorderThickness="{StaticResource klcBorderHairline}"
                        CornerRadius="{StaticResource klcRadButton}">
                        <ScrollViewer
                            CanContentScroll="True"
                            Focusable="False"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ======================================================================  -->
    <!--  DataGrid: Headers, cells, rows and grid.  -->
    <!--  ======================================================================  -->
    <!--  DataGrid: header, cell and row first, then the read-only grid that applies them  -->

    <!--  klaFoundationDataGridHeader: Data grid column header appearance.  -->
    <Style x:Key="klaFoundationDataGridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="{StaticResource xHeaderCellInset}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--  klaFoundationDataGridCell: Data grid cell appearance and interaction states.  -->
    <Style x:Key="klaFoundationDataGridCell" TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
        <Setter Property="Padding" Value="{StaticResource KlaCompactInset}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!--  A plain bordered presenter: Padding applies and the native dotted cell focus rectangle is gone.  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaPressedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource KlaFocusBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource klcTextColorDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--  klaFoundationDataGridRow: Data grid row appearance and interaction states.  -->
    <Style x:Key="klaFoundationDataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource klcBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource klcTextColorDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--  klaFoundationDataGrid: Read-only data grid using the foundation header, cell and row styles.  -->
    <Style x:Key="klaFoundationDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource klcBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource klcTextColor}" />
        <Setter Property="FontFamily" Value="{StaticResource klcFont}" />
        <Setter Property="FontSize" Value="{StaticResource klcFontSizeBody}" />
        <Setter Property="BorderBrush" Value="{StaticResource KlaBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource klcBorderHairline}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource KlaBorderStrongBrush}" />
        <!--  The header, cell and row styles above.  -->
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource klaFoundationDataGridHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource klaFoundationDataGridCell}" />
        <Setter Property="RowStyle" Value="{StaticResource klaFoundationDataGridRow}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    </Style>

    <!--  ======================================================================  -->
    <!--  GridSplitter: Review-pane divider.  -->
    <!--  ======================================================================  -->
    <!--  GridSplitter: review-pane divider  -->

    <!--  klaFoundationGridSplitter: Review-pane divider and interaction states.  -->
    <Style x:Key="klaFoundationGridSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource KlaComponentBorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="MinWidth" Value="{StaticResource xSplitterSize}" />
        <Setter Property="MinHeight" Value="{StaticResource xSplitterSize}" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="KeyboardIncrement" Value="{StaticResource xSplitterSize}" />
        <Setter Property="Focusable" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaAccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource KlaFocusBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
