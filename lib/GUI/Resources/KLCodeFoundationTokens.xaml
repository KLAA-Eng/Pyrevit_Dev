<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../_icons/gui/KLCodeIcons.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Shared WPF values; no Python, Revit, or compiled-add-in dependency. The spacing scale is 4 / 8 / 12 / 16 / 24; XAML
         consumes it through the typed GridLength / Thickness keys below, so no Double spacing tokens exist. -->
    <!-- GridLength is required for row/column definitions; WPF does not coerce Double resources. -->
    <GridLength x:Key="KlaChromeRow">24</GridLength>
    <GridLength x:Key="KlaControlRow">32</GridLength>
    <GridLength x:Key="KlaCompactRow">28</GridLength>
    <GridLength x:Key="KlaFilterRow">24</GridLength>
    <GridLength x:Key="KlaGridSpace4">4</GridLength>
    <GridLength x:Key="KlaGridSpace8">8</GridLength>
    <GridLength x:Key="KlaGridSpace16">16</GridLength>
    <Thickness x:Key="KlaBodyInset">16,8,16,8</Thickness>
    <Thickness x:Key="KlaLabelPadding">0</Thickness>
    <Thickness x:Key="KlaPairGap">0,0,8,0</Thickness>
    <Thickness x:Key="KlaInputPadding">8,0</Thickness>
    <Thickness x:Key="KlaListPadding">1</Thickness>
    <Thickness x:Key="KlaItemPadding">4,1</Thickness>
    <Thickness x:Key="KlaBrandInset">8,0,0,0</Thickness>
    <Thickness x:Key="KlaFooterInset">12,0</Thickness>
    <sys:Double x:Key="KlaControlHeight">32</sys:Double>
    <sys:Double x:Key="KlaCompactHeight">28</sys:Double>
    <sys:Double x:Key="KlaFilterHeight">24</sys:Double>
    <sys:Double x:Key="KlaButtonWidth">104</sys:Double>
    <sys:Double x:Key="KlaMainButtonWidth">216</sys:Double>
    <sys:Double x:Key="KlaIconSize">16</sys:Double>
    <sys:Double x:Key="KlaBodyFontSize">12</sys:Double>
    <sys:Double x:Key="KlaTitleFontSize">14</sys:Double>
    <FontFamily x:Key="KlaBodyFont">Segoe UI</FontFamily>
    <SolidColorBrush x:Key="KlaFocusBrush" Color="#E5E4E2"/>
    <SolidColorBrush x:Key="KlaPressedBrush" Color="#204D3A"/>
    <SolidColorBrush x:Key="KlaDisabledFillBrush" Color="#303C40"/>
    <SolidColorBrush x:Key="KlaDisabledTextBrush" Color="#A6B0AD"/>
    <!-- Component roles supplement the shared brand palette; all styles are opt-in. -->
    <GridLength x:Key="KlaFieldLabelColumn">112</GridLength>
    <GridLength x:Key="KlaCompactFieldLabelColumn">60</GridLength>
    <GridLength x:Key="KlaCompactFieldInputColumn">240</GridLength>
    <GridLength x:Key="KlaCompactFieldRow">24</GridLength>
    <sys:Double x:Key="KlaCompactFieldHeight">24</sys:Double>
    <GridLength x:Key="KlaActionColumn">104</GridLength>
    <SolidColorBrush x:Key="KlaComponentSurfaceBrush" Color="#22303A"/>
    <SolidColorBrush x:Key="KlaComponentBorderBrush" Color="#52675D"/>
    <SolidColorBrush x:Key="KlaMutedBrush" Color="#B5C2BD"/>
    <SolidColorBrush x:Key="KlaInfoBrush" Color="#A3C3E8"/>
    <SolidColorBrush x:Key="KlaReadyBrush" Color="#91C8A6"/>
    <SolidColorBrush x:Key="KlaWarningBrush" Color="#E8C66A"/>
    <SolidColorBrush x:Key="KlaErrorBrush" Color="#E89E96"/>

    <!-- Typed layout tokens for the values the design rules name. WPF resolves CornerRadius / Thickness / GridLength resources
         directly, so the foundation and components reference these instead of literals (scripts/check_ui_scale.py keeps it so). -->
    <Thickness x:Key="KlaHairline">1</Thickness>
    <CornerRadius x:Key="KlaRadiusCard">8</CornerRadius>
    <CornerRadius x:Key="KlaRadiusControl">6</CornerRadius>
    <CornerRadius x:Key="KlaRadiusChip">4</CornerRadius>
    <CornerRadius x:Key="KlaRadiusCheck">2</CornerRadius>
    <CornerRadius x:Key="KlaRadiusRadio">8</CornerRadius>
    <GridLength x:Key="KlaHeaderSideColumn">86</GridLength>
    <GridLength x:Key="KlaFooterSideColumn">100</GridLength>
    <sys:Double x:Key="KlaWordmarkWidth">70</sys:Double>
    <sys:Double x:Key="KlaWordmarkHeight">12</sys:Double>
    <sys:Double x:Key="KlaCloseWidth">60</sys:Double>
    <sys:Double x:Key="KlaCloseHeight">18</sys:Double>
    <sys:Double x:Key="KlaCloseFontSize">10</sys:Double>
    <Thickness x:Key="KlaCloseGlyphLift">0,0,0,2</Thickness>
    <sys:Double x:Key="KlaFocusMarkHeight">2</sys:Double>
    <Thickness x:Key="KlaFocusMarkInset">8,0,8,0</Thickness>
    <sys:Double x:Key="KlaCheckSize">16</sys:Double>
    <sys:Double x:Key="KlaCheckStroke">2</sys:Double>
    <sys:Double x:Key="KlaRadioDotSize">6</sys:Double>
    <sys:Double x:Key="KlaIconTextButtonWidth">128</sys:Double>
    <sys:Double x:Key="KlaIconButtonWidth">28</sys:Double>
    <sys:Double x:Key="KlaDropDownMaxHeight">260</sys:Double>
    <Thickness x:Key="KlaComboTextInset">8,0,28,0</Thickness>
    <Thickness x:Key="KlaComboArrowInset">0,0,8,0</Thickness>
    <Thickness x:Key="KlaSectionPadding">12</Thickness>
    <Thickness x:Key="KlaCompactInset">8,4</Thickness>
    <Thickness x:Key="KlaHeaderCellInset">8,6</Thickness>
    <Thickness x:Key="KlaReadoutPadding">8</Thickness>
    <sys:Double x:Key="KlaReadoutMinHeight">64</sys:Double>
    <sys:Double x:Key="KlaSplitterSize">4</sys:Double>

</ResourceDictionary>
