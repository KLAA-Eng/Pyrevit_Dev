<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:system="clr-namespace:System;assembly=System">
    <!--
        Every shared design value in one place: brand colours, sizes, spacing, radii, state colours and the window
        chrome data. Order matters: WPF resolves StaticResource only against keys already defined, so values come
        before anything that refers to them. Styles live in KLCodeFoundation.xaml and KLCodeComponents.xaml.
    -->

    <!--  Palette  -->
    <!--  Role brushes: the names the foundation and components use. Each value is a KL&A brand colour.  -->
    <!--  KLCharcoal: window, chrome, fields, lists  -->
    <SolidColorBrush x:Key="KlaWindowBrush" Color="#1A252B" />
    <!--  KLWhite: body text, labels, icons  -->
    <SolidColorBrush x:Key="KlaTextBrush" Color="#E5E4E2" />
    <!--  muted text: captions and secondary information  -->
    <SolidColorBrush x:Key="KlaTextMutedBrush" Color="#B5C2BD" />
    <!--  original Prototype/Outreach green  -->
    <SolidColorBrush x:Key="KlaFooterLinkBrush" Color="#407058" />
    <!--  original footer version gray  -->
    <SolidColorBrush x:Key="KlaFooterVersionBrush" Color="#808080" />
    <!--  placeholder text (Text entry watermark, Command Switch search hint); the same gray as the footer version by owner decision, test-enforced  -->
    <SolidColorBrush x:Key="KlaPlaceholderBrush" Color="#808080" />
    <!--  labels on accent fills  -->
    <SolidColorBrush x:Key="KlaTextOnAccentBrush" Color="White" />
    <!--  KLGreen-dark: action and checked fills  -->
    <SolidColorBrush x:Key="KlaAccentBrush" Color="#286048" />
    <!--  KLGreen-secondary: hover fills  -->
    <SolidColorBrush x:Key="KlaAccentHoverBrush" Color="#407058" />
    <!--  KLGreen: input and dropdown borders, wordmark slash, scrollbar thumb  -->
    <SolidColorBrush x:Key="KlaBorderBrush" Color="#33714F" />
    <!--  KLGreen-dark: sections, lists, grid lines  -->
    <SolidColorBrush x:Key="KlaBorderStrongBrush" Color="#286048" />

    <!--  Foundation tokens  -->
    <!--
         Shared WPF values; no Python, Revit, or compiled-add-in dependency. The spacing scale is 4 / 8 / 12 / 16 / 24; XAML
         consumes it through the typed GridLength / Thickness keys below, so no Double spacing tokens exist.
    -->
    <!--  GridLength is required for row/column definitions; WPF does not coerce Double resources.  -->
    <GridLength x:Key="KlaChromeRow">24</GridLength>
    <GridLength x:Key="KlaControlRow">32</GridLength>
    <GridLength x:Key="KlaCompactRow">28</GridLength>
    <GridLength x:Key="KlaFilterRow">24</GridLength>
    <GridLength x:Key="KlaGridSpace4">4</GridLength>
    <GridLength x:Key="KlaGridSpace8">8</GridLength>
    <GridLength x:Key="KlaGridSpace16">16</GridLength>
    <Thickness x:Key="KlaBodyInset">16,8,16,8</Thickness>
    <Thickness x:Key="KlaLabelPadding">0</Thickness>
    <Thickness x:Key="KlaPairGap">0,0,8,0</Thickness>
    <Thickness x:Key="KlaInputPadding">8,0</Thickness>
    <!--
         Native TextBoxView adds two units and the border one: five yields
         the same eight-unit rendered text inset as ComboBox selection text.
    -->
    <Thickness x:Key="KlaTextBoxPadding">5,0</Thickness>
    <Thickness x:Key="KlaActionTopGap">0,8,0,0</Thickness>
    <Thickness x:Key="KlaListPadding">1</Thickness>
    <Thickness x:Key="KlaItemPadding">4,1</Thickness>
    <Thickness x:Key="KlaBrandInset">8,0,0,0</Thickness>
    <Thickness x:Key="KlaFooterInset">12,0</Thickness>
    <sys:Double x:Key="KlaControlHeight">32</sys:Double>
    <sys:Double x:Key="KlaCompactHeight">28</sys:Double>
    <sys:Double x:Key="KlaFilterHeight">24</sys:Double>
    <sys:Double x:Key="KlaButtonWidth">104</sys:Double>
    <sys:Double x:Key="KlaMainButtonWidth">216</sys:Double>
    <sys:Double x:Key="KlaIconSize">16</sys:Double>
    <sys:Double x:Key="KlaIconCanvas">24</sys:Double>
    <sys:Double x:Key="KlaIconStroke">1.5</sys:Double>
    <sys:Double x:Key="KlaBodyFontSize">12</sys:Double>
    <sys:Double x:Key="KlaTextPromptInputHeight">36</sys:Double>
    <sys:Double x:Key="KlaTextPromptInputFontSize">24</sys:Double>
    <sys:Double x:Key="KlaTitleFontSize">14</sys:Double>
    <FontFamily x:Key="KlaBodyFont">Segoe UI</FontFamily>
    <SolidColorBrush x:Key="KlaFocusBrush" Color="#E5E4E2" />
    <SolidColorBrush x:Key="KlaPressedBrush" Color="#204D3A" />
    <SolidColorBrush x:Key="KlaDisabledFillBrush" Color="#303C40" />
    <SolidColorBrush x:Key="KlaDisabledTextBrush" Color="#A6B0AD" />
    <!--  Component roles supplement the shared brand palette; all styles are opt-in.  -->
    <GridLength x:Key="KlaFieldLabelColumn">112</GridLength>
    <GridLength x:Key="KlaCompactFieldLabelColumn">60</GridLength>
    <GridLength x:Key="KlaCompactFieldInputColumn">240</GridLength>
    <GridLength x:Key="KlaCompactFieldRow">24</GridLength>
    <sys:Double x:Key="KlaCompactFieldHeight">24</sys:Double>
    <GridLength x:Key="KlaActionColumn">104</GridLength>
    <SolidColorBrush x:Key="KlaComponentSurfaceBrush" Color="#22303A" />
    <SolidColorBrush x:Key="KlaComponentBorderBrush" Color="#52675D" />
    <SolidColorBrush x:Key="KlaMutedBrush" Color="#B5C2BD" />
    <SolidColorBrush x:Key="KlaInfoBrush" Color="#A3C3E8" />
    <SolidColorBrush x:Key="KlaReadyBrush" Color="#91C8A6" />
    <SolidColorBrush x:Key="KlaWarningBrush" Color="#E8C66A" />
    <SolidColorBrush x:Key="KlaErrorBrush" Color="#E89E96" />
    <SolidColorBrush x:Key="KlaPreviewSurfaceBrush" Color="#10171B" />

    <!--
         Typed layout tokens for the values the design rules name. WPF resolves CornerRadius / Thickness / GridLength resources
         directly, so the foundation and components reference these instead of literals (scripts/check_ui_scale.py keeps it so).
    -->
    <Thickness x:Key="KlaHairline">1</Thickness>
    <CornerRadius x:Key="KlaRadiusCard">8</CornerRadius>
    <CornerRadius x:Key="KlaRadiusControl">6</CornerRadius>
    <CornerRadius x:Key="KlaRadiusChip">4</CornerRadius>
    <CornerRadius x:Key="KlaRadiusCheck">2</CornerRadius>
    <CornerRadius x:Key="KlaRadiusRadio">8</CornerRadius>
    <!--  8 brand inset + the 128-wide logo; both side columns match so the title stays centred.  -->
    <GridLength x:Key="KlaHeaderSideColumn">136</GridLength>
    <GridLength x:Key="KlaFooterSideColumn">100</GridLength>
    <sys:Double x:Key="klcLogoWidth">128</sys:Double>
    <sys:Double x:Key="klcLogoHeight">18</sys:Double>
    <sys:Double x:Key="KlaCloseWidth">60</sys:Double>
    <sys:Double x:Key="KlaCloseHeight">18</sys:Double>
    <sys:Double x:Key="KlaCloseFontSize">10</sys:Double>
    <Thickness x:Key="KlaCloseGlyphLift">0,0,0,0.3</Thickness>
    <sys:Double x:Key="KlaCheckSize">16</sys:Double>
    <sys:Double x:Key="KlaCheckStroke">2</sys:Double>
    <sys:Double x:Key="KlaRadioDotSize">6</sys:Double>
    <sys:Double x:Key="KlaIconTextButtonWidth">128</sys:Double>
    <sys:Double x:Key="KlaIconButtonWidth">28</sys:Double>
    <sys:Double x:Key="KlaDropDownMaxHeight">260</sys:Double>
    <Thickness x:Key="KlaComboTextInset">8,0,28,0</Thickness>
    <Thickness x:Key="KlaComboArrowInset">0,0,8,0</Thickness>
    <Thickness x:Key="KlaSectionPadding">12</Thickness>
    <Thickness x:Key="KlaCompactInset">8,4</Thickness>
    <Thickness x:Key="KlaHeaderCellInset">8,6</Thickness>
    <Thickness x:Key="KlaReadoutPadding">8</Thickness>
    <sys:Double x:Key="KlaReadoutMinHeight">64</sys:Double>
    <sys:Double x:Key="KlaSplitterSize">4</sys:Double>
    <!--  Shared dialog values the dialog bodies used to write as literals (Review II cleanup, 2026-10-31).  -->
    <Thickness x:Key="KlaStackGap">0,8,0,0</Thickness>
    <Thickness x:Key="KlaStackGapBelow">0,0,0,8</Thickness>
    <Thickness x:Key="KlaIconTextGap">0,0,4,0</Thickness>
    <!--  Deliberate 2-unit optical lift for large single-line text beside an input.  -->
    <Thickness x:Key="KlaOpticalTextInset">0,0,0,2</Thickness>
    <Thickness x:Key="KlaFloatingMargin">16</Thickness>
    <CornerRadius x:Key="KlaRadiusFloating">12</CornerRadius>
    <sys:Double x:Key="KlaSeverityIconSize">32</sys:Double>
    <sys:Double x:Key="KlaDialogHeadingFontSize">22</sys:Double>
    <sys:Double x:Key="KlaSubheadingFontSize">16</sys:Double>
    <sys:Double x:Key="KlaDetailsHeight">128</sys:Double>
    <sys:Double x:Key="KlaOptionMaxHeight">80</sys:Double>
    <sys:Double x:Key="KlaCommandLinkMinHeight">40</sys:Double>
    <Thickness x:Key="KlaCommandLinkPadding">8</Thickness>
    <Thickness x:Key="KlaCommandArrowInset">0,4,8,0</Thickness>
    <GridLength x:Key="KlaCommandLinkIconColumn">24</GridLength>
    <!--  Ten plus the TextBoxView's two-unit inset and the hairline aligns readout text with the body at 13.  -->
    <Thickness x:Key="KlaDetailsReadoutPadding">10,8</Thickness>
    <GridLength x:Key="KlaRenameLabelColumn">52</GridLength>
    <sys:Double x:Key="KlaSwitchPromptMaxWidth">180</sys:Double>

    <!--  Command Switch pills (KlaCommandButton / KlaCommandToggle in KLCodeComponents.xaml).  -->
    <CornerRadius x:Key="KlaCommandPillRadius">12</CornerRadius>
    <Thickness x:Key="KlaCommandPillGap">0,0,8,8</Thickness>
    <Thickness x:Key="KlaCommandPillInset">12,4</Thickness>
    <GridLength x:Key="KlaSwitchToggleColumn">28</GridLength>
    <sys:Double x:Key="KlaSwitchTrackWidth">24</sys:Double>
    <sys:Double x:Key="KlaSwitchTrackHeight">12</sys:Double>
    <CornerRadius x:Key="KlaSwitchTrackRadius">6</CornerRadius>
    <sys:Double x:Key="KlaSwitchThumbSize">12</sys:Double>

    <!--  Scrollbar (implicit ScrollBar style in KLCodeFoundation.xaml): track inset and corners, thumb inset and corners.  -->
    <Thickness x:Key="KlaScrollBarMargin">3</Thickness>
    <CornerRadius x:Key="KlaScrollBarRadius">10</CornerRadius>
    <Thickness x:Key="KlaScrollThumbMargin">2</Thickness>
    <CornerRadius x:Key="KlaScrollThumbRadius">8</CornerRadius>

    <!--  Window chrome data  -->
    <!--
        Shared by the Python and C# adapters: the two footer destinations and the default (en_us) labels. The shell
        reads the labels with DynamicResource, so a dictionary merged after this one (the compiled
        Strings/ResourceDictionary.<locale>.xaml, or a Python window's own locale dictionary) overrides them.
    -->
    <system:Uri x:Key="KlaPrototypeUri">https://forms.cloud.microsoft/r/HjuggSZqyU</system:Uri>
    <system:Uri x:Key="KlaOutreachUri">https://forms.microsoft.com/Pages/ResponsePage.aspx?id=Bfmd9K3MFkqVWdMqprbPvvfxx29Ur-NGhLTDKxuFAqVUMU1OMUpRWDRKUDBMNEFEMlQ2SEJJNFdCUi4u</system:Uri>
    <sys:String x:Key="CloseLabel">Close</sys:String>
    <sys:String x:Key="PrototypeLabel">Prototype</sys:String>
    <sys:String x:Key="OutreachLabel">Outreach</sys:String>
</ResourceDictionary>
