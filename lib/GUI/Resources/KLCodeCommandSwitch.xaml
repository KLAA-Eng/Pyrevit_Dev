<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="KLCodeComponents.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Compact floating chooser roles. Existing window/button styles remain unchanged. -->
    <CornerRadius x:Key="KlaCommandPillRadius">12</CornerRadius>
    <Thickness x:Key="KlaCommandPillGap">0,0,8,8</Thickness>
    <Thickness x:Key="KlaCommandPillInset">12,4</Thickness>
    <Style x:Key="KlaCommandButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource KlaTextOnAccentBrush}"/>
        <Setter Property="Background" Value="{StaticResource KlaAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KlaAccentBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource KlaHairline}"/>
        <Setter Property="Padding" Value="{StaticResource KlaCommandPillInset}"/>
        <Setter Property="Margin" Value="{StaticResource KlaCommandPillGap}"/>
        <Setter Property="MinHeight" Value="{StaticResource KlaCompactHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </DataTemplate></Setter.Value></Setter>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource KlaCommandPillRadius}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource KlaAccentHoverBrush}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource KlaPressedBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}"/>
                    <Setter Property="Background" Value="{StaticResource KlaDisabledFillBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource KlaDisabledFillBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KlaCommandToggle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource KlaBodyFont}"/>
        <Setter Property="FontSize" Value="{StaticResource KlaBodyFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource KlaTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource KlaComponentSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KlaComponentBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource KlaHairline}"/>
        <Setter Property="Padding" Value="{StaticResource KlaCommandPillInset}"/>
        <Setter Property="Margin" Value="{StaticResource KlaCommandPillGap}"/>
        <Setter Property="MinHeight" Value="{StaticResource KlaCompactHeight}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource KlaCommandPillRadius}"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="SwitchTrack" Height="12" Width="24" CornerRadius="6"
                            VerticalAlignment="Center" HorizontalAlignment="Left" Background="{StaticResource KlaMutedBrush}">
                        <Ellipse x:Name="SwitchThumb" Width="12" Height="12" Fill="{StaticResource KlaTextBrush}" HorizontalAlignment="Left"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{TemplateBinding Foreground}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource KlaBorderBrush}"/>
                    <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource KlaAccentHoverBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource KlaDisabledTextBrush}"/>
                    <Setter Property="Background" Value="{StaticResource KlaDisabledFillBrush}"/>
                    <Setter TargetName="SwitchThumb" Property="Fill" Value="{StaticResource KlaDisabledTextBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
