<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KLCode Review Template" Width="960" Height="660" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Style="{StaticResource KlaFoundationWindow}">
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource KlaFilterRow}"/><RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                <RowDefinition Height="*"/><RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                <RowDefinition Height="{StaticResource KlaControlRow}"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image Source="{StaticResource KlaIconSearch}" Width="16" Height="16" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBox x:Name="review_search" Grid.Column="2" Style="{StaticResource KlaFoundationFilter}" TextChanged="review_filter_changed" AutomationProperties.Name="Search sample review items"/>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="8"/><ColumnDefinition Width="272" MinWidth="200"/></Grid.ColumnDefinitions>
                <DataGrid x:Name="review_grid" Style="{StaticResource KlaDataGrid}" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False" SelectionChanged="review_selection_changed" AutomationProperties.Name="Sample review items">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Use" Width="40">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanUse}" Style="{StaticResource KlaFoundationCheckBox}" Checked="review_checked_changed" Unchecked="review_checked_changed" AutomationProperties.Name="Include review item"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Width="2*" MinWidth="140" Binding="{Binding Name}" ElementStyle="{StaticResource KlaDataGridText}" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Status" Width="100" CellStyle="{StaticResource KlaDataGridStatusCell}">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Border>
                                    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource KlaStatusReady}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter Property="BorderBrush" Value="{StaticResource KlaWarningBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Blocked"><Setter Property="BorderBrush" Value="{StaticResource KlaErrorBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style></Border.Style>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource KlaStatusText}"/>
                                </Border>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Detail" Width="3*" MinWidth="180" Binding="{Binding Detail}" ElementStyle="{StaticResource KlaDataGridText}" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
                <GridSplitter Grid.Column="1" Style="{StaticResource KlaSplitter}" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
                <Border Grid.Column="2" Style="{StaticResource KlaSection}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="{StaticResource KlaGridSpace8}"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Label Content="Selected Item" Target="{Binding ElementName=review_detail}" Style="{StaticResource KlaFoundationPromptLabel}"/>
                        <TextBox x:Name="review_detail" Grid.Row="2" Style="{StaticResource KlaMultilineReadout}" AutomationProperties.Name="Selected review item details"/>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="4" Style="{StaticResource KlaBanner}">
                <TextBlock x:Name="review_summary" Style="{StaticResource KlaInfoText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </Border>
            <Grid Grid.Row="6">
                <Button Content="Check All" Click="review_check_all" Style="{StaticResource KlaSecondaryButton}" HorizontalAlignment="Left"/>
                <Button x:Name="primary_action" Content="Apply Checked" Click="apply_review" Style="{StaticResource KlaFoundationMainButton}" HorizontalAlignment="Right" IsDefault="True"/>
            </Grid>
        </Grid>
    </ContentControl>
</Window>
