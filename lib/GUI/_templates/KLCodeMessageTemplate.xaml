<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KLCode Message Template" Width="560" Height="288" MinWidth="500" MinHeight="288" MaxHeight="640"
        SizeChanged="message_window_size_changed"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Style="{StaticResource KlaFoundationWindow}">
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource KlaControlRow}"/>
                <RowDefinition Height="{StaticResource KlaGridSpace16}"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource KlaGridSpace16}"/>
                <RowDefinition Height="{StaticResource KlaControlRow}"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource KlaFieldLabelColumn}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Content="Message Type" Target="{Binding ElementName=message_severity}" Style="{StaticResource KlaFieldLabel}"/>
                <ComboBox x:Name="message_severity" Grid.Column="1" Style="{StaticResource KlaComboBox}" SelectionChanged="message_kind_changed" AutomationProperties.Name="Message type"/>
            </Grid>
            <Border x:Name="message_banner" Grid.Row="2" Style="{StaticResource KlaBanner}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="{StaticResource KlaGridSpace8}"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ContentControl x:Name="message_icon" Style="{StaticResource KlaGuiIcon}" Content="{StaticResource KlaInformationGeometry}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="message_heading" Grid.Column="2" Text="Information" Style="{StaticResource KlaSectionHeading}" TextWrapping="Wrap"/>
                    </Grid>
                    <ScrollViewer x:Name="message_scroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" AutomationProperties.Name="Message content">
                        <TextBlock x:Name="message_body" Style="{StaticResource KlaInfoText}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Expander x:Name="message_expander" Grid.Row="4" Header="Details" Foreground="{StaticResource text_white}" IsExpanded="False" Expanded="message_details_changed" Collapsed="message_details_changed" AutomationProperties.Name="Message details">
                <TextBox x:Name="message_details" Style="{StaticResource KlaMultilineReadout}" Height="128" MaxHeight="160" Margin="0,8,0,0" AutomationProperties.Name="Detailed message"/>
            </Expander>
            <Button x:Name="primary_action" Grid.Row="6" Content="Close" Click="dismiss_template" Style="{StaticResource KlaFoundationMainButton}" IsDefault="True"/>
        </Grid>
    </ContentControl>
</Window>
