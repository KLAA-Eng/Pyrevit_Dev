<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KLCode Form Template" Width="360" Height="352" MinWidth="360" MinHeight="352"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Style="{StaticResource KlaFoundationWindow}">
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                <RowDefinition Height="{StaticResource KlaControlRow}"/>
            </Grid.RowDefinitions>
            <Label x:Name="form_prompt" Content="Edit Naming Rules" Target="{Binding ElementName=input_find}" Style="{StaticResource KlaFoundationPromptLabel}"/>
            <Border x:Name="naming_group" Grid.Row="2" Style="{StaticResource KlaSection}">
                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource KlaCompactFieldLabelColumn}"/><ColumnDefinition Width="{StaticResource KlaCompactFieldInputColumn}"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{StaticResource KlaCompactFieldRow}"/><RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                        <RowDefinition Height="{StaticResource KlaCompactFieldRow}"/><RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                        <RowDefinition Height="{StaticResource KlaCompactFieldRow}"/><RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                        <RowDefinition Height="{StaticResource KlaCompactFieldRow}"/>
                    </Grid.RowDefinitions>
                    <Label Content="Find:" Target="{Binding ElementName=input_find}" Style="{StaticResource KlaCompactFieldLabel}"/>
                    <TextBox x:Name="input_find" Grid.Column="1" Style="{StaticResource KlaCompactFieldInput}" AutomationProperties.Name="Find text"/>
                    <Label Grid.Row="2" Content="Replace:" Target="{Binding ElementName=input_replace}" Style="{StaticResource KlaCompactFieldLabel}"/>
                    <TextBox x:Name="input_replace" Grid.Row="2" Grid.Column="1" Style="{StaticResource KlaCompactFieldInput}" AutomationProperties.Name="Replacement text"/>
                    <Label Grid.Row="4" Content="Prefix:" Target="{Binding ElementName=input_prefix}" Style="{StaticResource KlaCompactFieldLabel}"/>
                    <TextBox x:Name="input_prefix" Grid.Row="4" Grid.Column="1" Style="{StaticResource KlaCompactFieldInput}" AutomationProperties.Name="Name prefix"/>
                    <Label Grid.Row="6" Content="Suffix:" Target="{Binding ElementName=input_suffix}" Style="{StaticResource KlaCompactFieldLabel}"/>
                    <TextBox x:Name="input_suffix" Grid.Row="6" Grid.Column="1" Style="{StaticResource KlaCompactFieldInput}" AutomationProperties.Name="Name suffix"/>
                </Grid>
            </Border>
            <Border Grid.Row="4" Style="{StaticResource KlaBanner}">
                <TextBlock x:Name="form_feedback" Style="{StaticResource KlaInfoText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </Border>
            <Grid Grid.Row="6">
                <Button Content="Reset" Click="reset_form" Style="{StaticResource KlaSecondaryButton}" HorizontalAlignment="Left"/>
                <Button x:Name="primary_action" Content="Apply Rules" Click="apply_form" Style="{StaticResource KlaFoundationMainButton}" HorizontalAlignment="Right" IsDefault="True"/>
            </Grid>
        </Grid>
    </ContentControl>
</Window>
