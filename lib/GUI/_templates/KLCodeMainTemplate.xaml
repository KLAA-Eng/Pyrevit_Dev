<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="KLCode Main Template"
    Height="576" Width="432"
    MinWidth="432"
    MinHeight="576" MaxHeight="576"
    WindowStartupLocation="CenterScreen"
    HorizontalAlignment="Center"
    ShowInTaskbar="True"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="#FF131313">

    <!-- Editable SelectFromDict baseline. This file is previewed from UI Gallery only. -->
    <Grid Background="#FF131313">
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="32"/>
            <RowDefinition/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Grid MouseDown="header_drag"
              Background="#FF131313"
              Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="66"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left">
                <TextBlock Margin="5,0,0,0"
                           FontFamily="../../_logos/_font/Audiowide-Regular.ttf#Audiowide"
                           FontSize="16px"
                           FontWeight="Normal">
                    <Run Foreground="{StaticResource text_green}">/</Run><Run Foreground="{StaticResource text_white}">KLCode</Run>
                </TextBlock>
            </DockPanel>

            <TextBlock x:Name="main_title"
                       Text="Select From Dict"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource text_white}"
                       FontSize="14"
                       MaxWidth="200"
                       TextTrimming="CharacterEllipsis"/>

            <Button Content="Close"
                    Grid.Column="2"
                    Width="60" Height="18"
                    FontSize="10"
                    Click="button_close"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="TextElement.FontFamily" Value="Arial"/>
                        <Setter Property="Background" Value="{StaticResource button_bg_normal}"/>
                        <Setter Property="Foreground" Value="{StaticResource button_fg_normal}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="6"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"
                                                          HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource button_bg_hover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Filter -->
        <DockPanel Grid.Row="1">
            <!-- Matches lib/_icons/search_24px_light.svg; inline vector keeps pyRevit WPF-compatible rendering. -->
            <Viewbox Width="24"
                     Height="24"
                     VerticalAlignment="Center"
                     Margin="8,4,6,4">
                <Canvas Width="24" Height="24">
                    <Path Data="M21,21 L16.66,16.66"
                          Stroke="{StaticResource text_white}"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"/>
                    <Ellipse Width="16"
                             Height="16"
                             Canvas.Left="3"
                             Canvas.Top="3"
                             Stroke="{StaticResource text_white}"
                             StrokeThickness="3"/>
                </Canvas>
            </Viewbox>

            <TextBox x:Name="textbox_filter"
                     Text=""
                     Height="24" VerticalAlignment="Center"
                     Foreground="{StaticResource text_white}"
                     Background="#FF131313"
                     Margin="0,4,12,4" FontSize="14"
                     BorderBrush="{StaticResource border_green_dark}"
                     TextChanged="text_filter_updated">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Style.Resources>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </DockPanel>

        <!-- Selectable list -->
        <StackPanel Grid.Row="2"
                    VerticalAlignment="Top"
                    Margin="12,6,12,6">
            <Separator Background="{StaticResource border_green_dark}"/>

            <Label x:Name="text_label"
                   Content="Select elements:"
                   Foreground="{StaticResource text_green}"
                   FontSize="14"/>

            <ListBox x:Name="main_ListBox"
                     Height="360"
                     Background="#FF131313"
                     SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderBrush="{StaticResource border_green_dark}">
                <ListBox.Resources>
                    <!-- Template-specific scrolling treatment. -->
                    <Style x:Key="TemplateScrollBarThumbVertical" TargetType="Thumb">
                        <Setter Property="OverridesDefaultStyle" Value="true"/>
                        <Setter Property="IsTabStop" Value="false"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Border x:Name="rectangle"
                                            Background="{StaticResource text_green}"
                                            Height="{TemplateBinding Height}"
                                            SnapsToDevicePixels="True"
                                            Width="{TemplateBinding Width}"
                                            CornerRadius="8"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="#1A252B"/>
                        <Setter Property="Foreground" Value="#1A252B"/>
                        <Setter Property="BorderBrush" Value="#FF131313"/>
                        <Setter Property="Opacity" Value="0.9"/>
                        <Setter Property="Margin" Value="3"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid x:Name="Bg" SnapsToDevicePixels="true">
                                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Background="{TemplateBinding Background}"
                                                Grid.Row="1"
                                                CornerRadius="10"/>
                                        <Track x:Name="PART_Track"
                                               IsDirectionReversed="true"
                                               IsEnabled="{TemplateBinding IsMouseOver}"
                                               Grid.Row="1">
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource TemplateScrollBarThumbVertical}"
                                                       Margin="2"/>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="ListBox">
                        <Style.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Style.Resources>
                    </Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="SnapsToDevicePixels" Value="true"/>
                        <Setter Property="OverridesDefaultStyle" Value="true"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <BulletDecorator Background="Transparent">
                                        <BulletDecorator.Bullet>
                                            <Border x:Name="Border"
                                                    Width="16"
                                                    Height="16"
                                                    CornerRadius="2"
                                                    BorderThickness="1"
                                                    BorderBrush="{StaticResource text_green}"
                                                    Background="#FF131313">
                                                <Path Width="9"
                                                      Height="9"
                                                      x:Name="CheckMark"
                                                      SnapsToDevicePixels="False"
                                                      Stroke="#E5E4E2"
                                                      StrokeThickness="2"
                                                      Data="M 0 4 L 3 8 8 0"/>
                                            </Border>
                                        </BulletDecorator.Bullet>
                                        <ContentPresenter Margin="4,0,0,0"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          RecognizesAccessKey="True"/>
                                    </BulletDecorator>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="false">
                                            <Setter TargetName="CheckMark"
                                                    Property="Visibility"
                                                    Value="Collapsed"/>
                                            <Setter TargetName="Border"
                                                    Property="Background"
                                                    Value="#FF131313"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="true">
                                            <Setter TargetName="Border"
                                                    Property="Background"
                                                    Value="{StaticResource checkbox_checked_colour}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="{x:Null}">
                                            <Setter TargetName="CheckMark"
                                                    Property="Data"
                                                    Value="M 0 8 L 8 0"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter TargetName="Border"
                                                    Property="Background"
                                                    Value="{StaticResource button_bg_hover}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="false">
                                            <Setter TargetName="CheckMark"
                                                    Property="Stroke"
                                                    Value="#FF6C6C6C"/>
                                            <Setter Property="Foreground" Value="Gray"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.Resources>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Background="#286048"
                                  Foreground="{StaticResource text_white}"
                                  IsChecked="{Binding IsChecked}"
                                  Checked="UIe_ItemChecked"
                                  FontSize="12">
                            <TextBlock Text="{Binding Name}"/>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        x:Name="UI_Buttons_all_none">
                <Button Content="Select All"
                        Click="button_select_all"
                        Height="24"
                        Width="108"
                        FontSize="12"
                        Margin="6"/>
                <Button Content="Select None"
                        Click="button_select_none"
                        Height="24"
                        Width="108"
                        FontSize="12"
                        Margin="6"/>
            </StackPanel>

            <Button x:Name="button_main"
                    Content="Select"
                    Click="button_select"
                    Height="32"
                    Width="216"
                    FontSize="14"
                    Margin="6"/>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="3" Background="#FF131313">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="10,0,0,0">
                <Hyperlink NavigateUri="https://forms.cloud.microsoft/r/HjuggSZqyU"
                           RequestNavigate="Hyperlink_RequestNavigate"
                           FontWeight="Medium"
                           Foreground="{StaticResource button_bg_hover}">
                    Prototype
                </Hyperlink>
            </TextBlock>

            <TextBlock x:Name="footer_version"
                       Text="Template preview"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Stretch"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="4,0"
                       Foreground="{StaticResource text_gray}"/>

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,10,0">
                <Hyperlink RequestNavigate="Hyperlink_RequestNavigate"
                           NavigateUri="https://forms.microsoft.com/Pages/ResponsePage.aspx?id=Bfmd9K3MFkqVWdMqprbPvvfxx29Ur-NGhLTDKxuFAqVUMU1OMUpRWDRKUDBMNEFEMlQ2SEJJNFdCUi4u"
                           FontWeight="Medium"
                           Foreground="{StaticResource button_bg_hover}">
                    Outreach
                </Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
