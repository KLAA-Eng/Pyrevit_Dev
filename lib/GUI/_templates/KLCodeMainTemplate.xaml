.5298,-2.57348 1.65211,-1.71565 2.47816,-4.19382 2.47816,-7.43449 V 64.616159 h 24.78163 z m 134.48796,-34.1224 c 0,3.4313 -0.60366,7.14854 -1.81097,11.15173 -1.20731,3.93965 -3.17713,7.62512 -5.90946,11.05642 -2.66879,3.36776 -6.19541,6.19541 -10.57985,8.48295 -4.3209,2.28753 -9.59494,3.4313 -15.82212,3.4313 H 913.1776 v -23.54255 h 44.70225 c 3.36776,0 5.97301,-1.01668 7.81574,-3.05005 1.84274,-2.09691 2.76411,-4.67038 2.76411,-7.72043 0,-3.24067 -1.04845,-5.78238 -3.14536,-7.62512 -2.03337,-1.84273 -4.51153,-2.7641 -7.43449,-2.7641 H 913.1776 c -3.36776,0 -5.97301,1.04845 -7.81575,3.14536 -1.84273,2.03337 -2.7641,4.57507 -2.7641,7.62512 v 34.59897 c 0,3.30421 1.01668,5.87769 3.05005,7.72043 2.09691,1.84273 4.67038,2.7641 7.72043,2.7641 h 44.51162 v 23.63787 H 913.1776 c -3.43131,0 -7.14855,-0.60366 -11.15174,-1.81097 -3.93964,-1.20731 -7.62511,-3.14536 -11.05642,-5.81415 -3.36776,-2.73233 -6.19541,-6.25895 -8.48294,-10.57985 -2.28753,-4.38444 -3.4313,-9.69025 -3.4313,-15.91743 v -34.7896 c 0,-3.43131 0.60365,-7.11678 1.81096,-11.05642 1.20731,-4.00319 3.14537,-7.68866 5.81416,-11.05642 2.73233,-3.43131 6.25895,-6.29073 10.57985,-8.57826 4.38444,-2.287534 9.69025,-3.431301 15.91743,-3.431301 h 44.70225 c 3.4313,0 7.11677,0.603654 11.05642,1.810961 4.00319,1.20731 7.68866,3.17714 11.05642,5.90947 3.4313,2.66879 6.29072,6.19541 8.57826,10.57985 2.28753,4.3209 3.4313,9.59494 3.4313,15.82212 z">
                        <Path.RenderTransform>
                            <TranslateTransform X="-32" Y="-64"/>
                        </Path.RenderTransform>
                    </Path>
                </Canvas>
            </Viewbox>

            <TextBlock x:Name="main_title"
                       Text="Select From Dict"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource text_white}"
                       FontSize="14"
                       MaxWidth="180"
                       TextTrimming="CharacterEllipsis"/>

            <Button Content="Close"
                    Grid.Column="2"
                    Click="button_close"
                    Style="{StaticResource KLCodeCloseButton}"/>
        </Grid>

        <!-- Filter -->
        <Grid Grid.Row="1" Margin="8,4,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Image x:Name="filter_icon"
                   Grid.Column="0"
                   Width="16"
                   Height="16"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Stretch="None"
                   SnapsToDevicePixels="True"/>
            <Border x:Name="template_filter_border"
                    Grid.Column="2"
                    Background="#1A252B"
                    BorderBrush="{StaticResource text_green}"
                    BorderThickness="1"
                    CornerRadius="6"
                    SnapsToDevicePixels="True">
                <TextBox x:Name="textbox_filter"
                         Text=""
                         TextChanged="text_filter_updated"
                         Style="{StaticResource KLCodeFilterTextBox}"/>
            </Border>
        </Grid>

        <!-- Selectable list -->
        <StackPanel Grid.Row="2"
                    VerticalAlignment="Top"
                    Margin="12,6,12,6">
            <Separator Background="{StaticResource border_green_dark}"/>

            <Label x:Name="text_label"
                   Content="Select elements:"
                   Foreground="{StaticResource text_white}"
                   FontSize="14"/>

            <ListBox x:Name="main_ListBox"
                     Height="360"
                     Background="#1A252B"
                     SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderBrush="{StaticResource border_green_dark}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Background="#286048"
                                  Foreground="{StaticResource text_white}"
                                  IsChecked="{Binding IsChecked}"
                                  Checked="UIe_ItemChecked"
                                  FontSize="12">
                            <TextBlock Text="{Binding Name}"/>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0"
                        x:Name="UI_Buttons_all_none">
                <Button Content="Select All"
                        Click="button_select_all"
                        Style="{StaticResource KLCodeActionButton}"
                        Height="26"
                        Width="104"
                        FontSize="12"
                        Margin="0,0,8,0"/>
                <Button Content="Select None"
                        Click="button_select_none"
                        Style="{StaticResource KLCodeActionButton}"
                        Height="26"
                        Width="104"
                        FontSize="12"
                        Margin="0"/>
            </StackPanel>

            <Button x:Name="button_main"
                    Content="Select"
                    Click="button_select"
                    Style="{StaticResource KLCodeActionButton}"
                    Height="32"
                    Width="216"
                    FontSize="14"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,16"/>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="3" Background="#1A252B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="10,0,0,0">
                <Hyperlink NavigateUri="https://forms.cloud.microsoft/r/HjuggSZqyU"
                           RequestNavigate="Hyperlink_RequestNavigate"
                           FontWeight="Medium"
                           Foreground="{StaticResource button_bg_hover}">
                    Prototype
                </Hyperlink>
            </TextBlock>

            <TextBlock x:Name="footer_version"
                       Text="Template preview"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Stretch"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="4,0"
                       Foreground="{StaticResource text_gray}"/>

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,10,0">
                <Hyperlink RequestNavigate="Hyperlink_RequestNavigate"
                           NavigateUri="https://forms.microsoft.com/Pages/ResponsePage.aspx?id=Bfmd9K3MFkqVWdMqprbPvvfxx29Ur-NGhLTDKxuFAqVUMU1OMUpRWDRKUDBMNEFEMlQ2SEJJNFdCUi4u"
                           FontWeight="Medium"
                           Foreground="{StaticResource button_bg_hover}">
                    Outreach
                </Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
