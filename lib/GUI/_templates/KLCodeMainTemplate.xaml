            <Viewbox Grid.Column="0"
                     Width="70"
                     Height="12"
                     Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Left"
                     Stretch="Uniform"
                     SnapsToDevicePixels="True">
                <Canvas Width="961" Height="138" ClipToBounds="True">
