<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KLCode Main Template" Width="432" Height="576" MinWidth="432" MinHeight="576"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Style="{StaticResource KlaFoundationWindow}">
    <!-- Load with GUI.window_chrome.load_window; only the workflow body belongs here. -->
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource KlaControlRow}"/>
                <RowDefinition Height="{StaticResource KlaGridSpace16}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{StaticResource KlaGridSpace4}"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                <RowDefinition Height="{StaticResource KlaCompactRow}"/>
                <RowDefinition Height="{StaticResource KlaGridSpace8}"/>
                <RowDefinition Height="{StaticResource KlaControlRow}"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource KlaGridSpace16}"/><ColumnDefinition Width="{StaticResource KlaGridSpace8}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image Source="{StaticResource KlaIconSearch}" Width="{StaticResource KlaIconSize}" Height="{StaticResource KlaIconSize}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBox x:Name="textbox_filter" Grid.Column="2" Style="{StaticResource KlaFoundationInput}" TextChanged="text_filter_updated" AutomationProperties.Name="Search sample items"/>
            </Grid>
            <Label x:Name="text_label" Grid.Row="2" Content="Select elements:" Target="{Binding ElementName=main_ListBox}" Style="{StaticResource KlaFoundationLabel}"/>
            <ListBox x:Name="main_ListBox" Grid.Row="4" Style="{StaticResource KlaFoundationList}" SelectionMode="Single" AutomationProperties.Name="Sample items">
                <ListBox.ItemTemplate><DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Checked="UIe_ItemChecked" Style="{StaticResource KlaFoundationCheckBox}"/>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="UI_Buttons_all_none" Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Select All" Click="button_select_all" Style="{StaticResource KlaFoundationButton}" Margin="{StaticResource KlaPairGap}"/>
                <Button Content="Select None" Click="button_select_none" Style="{StaticResource KlaFoundationButton}"/>
            </StackPanel>
            <Button x:Name="button_main" Grid.Row="8" Content="Select" Click="button_select" Style="{StaticResource KlaFoundationMainButton}" IsDefault="True"/>
        </Grid>
    </ContentControl>
</Window>
