<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KLCode Review Template"
    Width="960"
    Height="660"
    MinWidth="760"
    MinHeight="500"
    ResizeMode="CanResizeWithGrip"
    Style="{StaticResource klcFdnWindow}"
    WindowStartupLocation="CenterScreen">
    <ContentControl x:Name="window_shell" Style="{StaticResource klcWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                <RowDefinition Height="*" />
                <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                <RowDefinition Height="{StaticResource klcBodyRowLarge}" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Search"
                    Content="{StaticResource kliconSearch}"
                    Style="{StaticResource KlaGuiIcon}" />
                <TextBox
                    x:Name="review_search"
                    Grid.Column="2"
                    AutomationProperties.Name="Search sample review items"
                    Style="{StaticResource KlaFoundationFilter}"
                    TextChanged="review_filter_changed" />
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="272" MinWidth="200" />
                </Grid.ColumnDefinitions>
                <DataGrid
                    x:Name="review_grid"
                    AutoGenerateColumns="False"
                    AutomationProperties.Name="Sample review items"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    SelectionChanged="review_selection_changed"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    Style="{StaticResource xDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="40" Header="Use">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        AutomationProperties.Name="Include review item"
                                        Checked="review_checked_changed"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding CanUse}"
                                        Style="{StaticResource KlaFoundationCheckBox}"
                                        Unchecked="review_checked_changed" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="2*"
                            MinWidth="140"
                            Binding="{Binding Name}"
                            ElementStyle="{StaticResource xDataGridText}"
                            Header="Name"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn
                            Width="100"
                            CellStyle="{StaticResource xDataGridStatusCell}"
                            Header="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style BasedOn="{StaticResource xStatusReady}" TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                        <Setter Property="BorderBrush" Value="{StaticResource klcWarningColor}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Blocked">
                                                        <Setter Property="BorderBrush" Value="{StaticResource klcErrorColor}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Style="{StaticResource xStatusText}" Text="{Binding Status}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="3*"
                            MinWidth="180"
                            Binding="{Binding Detail}"
                            ElementStyle="{StaticResource xDataGridText}"
                            Header="Detail"
                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
                <GridSplitter
                    Grid.Column="1"
                    Width="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns"
                    Style="{StaticResource xSplitter}" />
                <Border Grid.Column="2" Style="{StaticResource KlaSection}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Label
                            Content="Selected Item"
                            Style="{StaticResource klcLabelPrompt}"
                            Target="{Binding ElementName=review_detail}" />
                        <TextBox
                            x:Name="review_detail"
                            Grid.Row="2"
                            AutomationProperties.Name="Selected review item details"
                            Style="{StaticResource KlaMultilineReadout}" />
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="4" Style="{StaticResource KlaBanner}">
                <TextBlock
                    x:Name="review_summary"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource KlaInfoText}"
                    TextWrapping="Wrap" />
            </Border>
            <Grid Grid.Row="6">
                <Button
                    HorizontalAlignment="Left"
                    Click="review_check_all"
                    Content="Check All"
                    Style="{StaticResource KlaButtonSecondary}" />
                <Button
                    x:Name="primary_action"
                    HorizontalAlignment="Right"
                    Click="apply_review"
                    Content="Apply Checked"
                    IsDefault="True"
                    Style="{StaticResource klcButtonDouble}" />
            </Grid>
        </Grid>
    </ContentControl>
</Window>
