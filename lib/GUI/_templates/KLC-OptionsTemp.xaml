<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KLCode Options Template"
    Width="640"
    Height="620"
    MinWidth="600"
    MinHeight="540"
    ResizeMode="CanResizeWithGrip"
    Style="{StaticResource klcWindow}"
    WindowStartupLocation="CenterScreen">
    <ContentControl x:Name="window_shell" Style="{StaticResource klcWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <!--  Fixed parts are separated by token spacer rows, as in the shared dialogs; nothing here carries a margin.  -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{StaticResource klcBodySpaceLarge}" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{StaticResource klcBodySpaceLarge}" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="options_prompt"
                        Style="{StaticResource klaPromptText}"
                        Text="Configure Sample Options" />
                    <Border Grid.Row="2" Style="{StaticResource KlaSection}">
                        <Grid x:Name="options_fields">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource KlaCompactFieldLabelColumn}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                                <RowDefinition Height="{StaticResource klcBodySpaceLarge}" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{StaticResource klcBodySpaceLarge}" />
                                <RowDefinition Height="{StaticResource xCompactRow}" />
                                <RowDefinition Height="{StaticResource klcBodySpaceLarge}" />
                                <RowDefinition Height="{StaticResource klcBodyRowNormal}" />
                            </Grid.RowDefinitions>
                            <Label
                                Content="Category"
                                Style="{StaticResource klcLabelCentered}"
                                Target="{Binding ElementName=option_category}" />
                            <ComboBox
                                x:Name="option_category"
                                Grid.Column="1"
                                Style="{StaticResource KlaCompactComboBox}" />
                            <!--  Scope names a group of two radio buttons, not one input, so it is text rather than a Label.  -->
                            <TextBlock
                                Grid.Row="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource xText}"
                                Text="Scope" />
                            <RadioButton
                                x:Name="scope_selected"
                                Grid.Row="2"
                                Grid.Column="1"
                                Content="Selected Items"
                                GroupName="Scope"
                                IsChecked="True"
                                Style="{StaticResource xRadioButton}" />
                            <RadioButton
                                x:Name="scope_all"
                                Grid.Row="4"
                                Grid.Column="1"
                                Content="All Available Items"
                                GroupName="Scope"
                                Style="{StaticResource xRadioButton}" />
                            <CheckBox
                                x:Name="option_include_existing"
                                Grid.Row="6"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="Include Existing"
                                Style="{StaticResource KlaCheck}" />
                            <Label
                                Grid.Row="8"
                                Content="Offset"
                                Style="{StaticResource klcLabelCentered}"
                                Target="{Binding ElementName=option_offset}" />
                            <Grid Grid.Row="8" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="option_offset"
                                    HorizontalContentAlignment="Right"
                                    Style="{StaticResource KlaCompactFieldInput}"
                                    Text="0" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource KlaInfoText}"
                                    Text="mm" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Label
                        x:Name="output_prompt"
                        Grid.Row="4"
                        Content="Output Location"
                        Style="{StaticResource klcLabelPrompt}"
                        Target="{Binding ElementName=option_path}" />
                    <Border Grid.Row="6" Style="{StaticResource KlaSection}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                                <ColumnDefinition Width="{StaticResource KlaActionColumn}" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="option_path"
                                Style="{StaticResource xCompactReadOnlyField}" />
                            <Button
                                Grid.Column="2"
                                AutomationProperties.Name="Choose a fictional sample location"
                                Click="browse_sample"
                                Content="Browse"
                                Style="{StaticResource KlaButtonSecondary}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="8" Style="{StaticResource KlaBanner}">
                        <TextBlock
                            x:Name="options_feedback"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource KlaInfoText}" />
                    </Border>
                </Grid>
            </ScrollViewer>
            <Button
                x:Name="primary_action"
                Grid.Row="2"
                Click="apply_options"
                Content="Apply Options"
                IsDefault="True"
                Style="{StaticResource klcButtonDouble}" />
        </Grid>
    </ContentControl>
</Window>
