            <Grid Margin="0,0,0,25">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Label Content="Include Elements"
                           Margin="0, -25,0,0 "
       
                           Foreground="{StaticResource text_white}"/>
                <Border BorderBrush="{DynamicResource border_green}"
                        BorderThickness="1,1,1,1" CornerRadius="10">


                    <Grid Margin="20,5,20,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="25"/>

                        </Grid.RowDefinitions>

                        <Grid.Resources>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="Foreground" Value="{StaticResource text_white}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>
                        </Grid.Resources>


                        <CheckBox  x:Name = "UI_checkbox_views"
                                    Grid.Column="1"
                                    Grid.Row="0"
                    Content="Views"
                    IsChecked="True"
                    Foreground="{DynamicResource text_white}"
                    Background="{DynamicResource checkbox_checked_colour}"
                    VerticalAlignment="Top"
                    FontSize="12"
                    FontWeight="Medium"
                    Margin="0,0,0,0"
                    >

                        </CheckBox>
                        <CheckBox  x:Name = "UI_checkbox_legends"
                                     Grid.Column="2"
                                    Grid.Row="0"
                    Content="Legends"
                    IsChecked="True"
                    Foreground="{DynamicResource text_white}"
                   
                    VerticalAlignment="Top"
                    FontSize="12"
                    FontWeight="Medium"
                    Margin="0,0,0,0"
                    />
                        <CheckBox  x:Name = "UI_checkbox_schedules"
                                    Grid.Column="3"
                                    Grid.Row="0"
                    Content="Schedules"
                    IsChecked="True"
                    Foreground="{DynamicResource text_white}"
                    Background="{DynamicResource checkbox_checked_colour}"
                    VerticalAlignment="Top"
                    FontSize="12"
                    FontWeight="Medium"
                     Margin="0,0,10,0"
                    />
                        <CheckBox  x:Name = "UI_checkbox_images"
                                     Grid.Column="4"
                                    Grid.Row="0"
                    Content="Images"
                    IsChecked="True"
                    Foreground="{DynamicResource text_white}"
                    Background="{DynamicResource checkbox_checked_colour}"
                    VerticalAlignment="Top"
                    FontSize="12"
                    FontWeight="Medium"
                     Margin="0,0,10,0"
                    />
                        <CheckBox  x:Name = "UI_checkbox_lines"
                                     Grid.Column="5"
                                    Grid.Row="0"
                    Content="Lines"
                    IsChecked="True"
                    Foreground="{DynamicResource text_white}"
                    Background="{DynamicResource checkbox_checked_colour}"
                    VerticalAlignment="Top"
                    FontSize="12"
                    FontWeight="Medium"
                     Margin="0,0,10,0"
                    />
                        <CheckBox  x:Name = "UI_checkbox_text"
                                     Grid.Column="6"
                                    Grid.Row="0"
                    Content="Text"
                    IsChecked="True"
                    Foreground="{DynamicResource text_white}"
                    Background="{DynamicResource checkbox_checked_colour}"
                    VerticalAlignment="Top"
                    FontSize="12"
                    FontWeight="Medium"
                     Margin="0,0,10,0"
                    />




                        <CheckBox x:Name = "UI_checkbox_clouds"
                                     Grid.Column="1"
                                    Grid.Row="2"
                    Content="Clouds"
                    IsChecked="False"
                    Foreground="{DynamicResource text_white}"
                    Background="{DynamicResource checkbox_checked_colour}"
                    VerticalAlignment="Top"
                    FontSize="12"
                    FontWeight="Medium"
                     Margin="0,5,10,0"
                    />
                        <CheckBox x:Name = "UI_checkbox_dwgs"
                                             Grid.Column="2"
                                    Grid.Row="2"
                    Content="DWGs"
                    IsChecked="False"
                    Foreground="{DynamicResource text_white}"
                    Background="{DynamicResource checkbox_checked_colour}"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="Medium"
                     Margin="0,5,10,0"
                    />
                        <CheckBox x:Name = "UI_checkbox_symbols"
                                             Grid.Column="3"
                                    Grid.Row="2"
                    Content="Symbols"
                    IsChecked="False"
                    Foreground="{DynamicResource text_white}"
                    Background="{DynamicResource checkbox_checked_colour}"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="Medium"
                     Margin="0,5,10,0"
                    />
                        <CheckBox x:Name = "UI_checkbox_dimensions"
                                             Grid.Column="4"
                                    Grid.Row="2"
                    Content="Dimensions"
                    IsChecked="False"
                    Foreground="{DynamicResource text_white}"
                    Background="{DynamicResource checkbox_checked_colour}"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="Medium"
                     Margin="0,5,10,0"
                    />
                        <CheckBox x:Name = "UI_checkbox_additional_revisions"
                                             Grid.Column="5"
                                    Grid.Row="2"
                            Grid.ColumnSpan="2"
                    Content="Additional revisions"
                    IsChecked="False"
                    Foreground="{DynamicResource text_white}"
                    Background="{DynamicResource checkbox_checked_colour}"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="Medium"
                     Margin="0,5,10,0"
                    />










                    </Grid>




                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="15*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>


                <StackPanel Grid.Column="0"
                                    Margin="5" 
                            >
                    <Label Content="Use Existing [True] / Duplicate [False] "
                           Margin="0, -25,0,0 "
                           Foreground="{StaticResource text_white}"/>
                    <Border  Height="75"
                          BorderBrush="{DynamicResource border_green_dark}"
                         BorderThickness="1,1,1,1" CornerRadius="10" HorizontalAlignment="Stretch" Width="Auto">



                        <StackPanel Grid.Row="2"
                                   
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Margin="10">




                            <StackPanel Orientation="Vertical">

                                <CheckBox
                                     x:Name = "UI_checkbox_use_existing_legend"
                                    Content="Legends"
                                    IsChecked="True"
                                    Foreground="{DynamicResource text_white}"
                                    Background="{DynamicResource checkbox_checked_colour}"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Medium"
                                     Margin="0,0,10,0"
                                    />
                                <CheckBox
                                    x:Name = "UI_checkbox_use_existing_schedules"
                                    Content="Schedules"
                                    IsChecked="True"
                                    Foreground="{DynamicResource text_white}"
                                    Background="{DynamicResource checkbox_checked_colour}"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Medium"
                                     Margin="0,0,10,0"
                                    />

                            </StackPanel>

                        </StackPanel>

                    </Border>



                </StackPanel>


                <StackPanel Grid.Column="1"
                                    Margin="5">
                    <Label Content="View Duplicate Opions"
                           Margin="0, -25,0,0 "
                           Foreground="{StaticResource text_white}"/>
                    <Border  
                        Height="75"
                          BorderBrush="{DynamicResource border_green_dark}"
                         BorderThickness="1,1,1,1" CornerRadius="10">



                        <StackPanel Grid.Row="2"
                                    Grid.RowSpan="2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Margin="10">




                            <StackPanel Orientation="Vertical">

                                <RadioButton Content="Duplicate" 
                                             Foreground="{StaticResource text_white}"
                                             Checked="radiobutton_duplicate_option"
                                             IsChecked="True"/>

                                <RadioButton Content="Duplicate detailing" 
                                             Foreground="{StaticResource text_white}"
                                             Checked="radiobutton_duplicate_option"/>


                                <RadioButton Content="Duplicate Dependent" 
                                             Foreground="{StaticResource text_white}"
                                             Checked="radiobutton_duplicate_option"/>


                            </StackPanel>

                        </StackPanel>

                    </Border>

                </StackPanel>



            </Grid>



            <Button 
                    Content="Duplicate selected sheets"
                    Foreground="{DynamicResource text_white}"
                    FontSize="14"
                    FontWeight="Medium"
                    Click="button_run"
                    Margin="0,8,0,16"
                    Height="32"
                    Style="{StaticResource KLCodeActionButton}"/>

        </StackPanel>

        <Grid Grid.Row="2" Style="{StaticResource KLCodeFooterGrid}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"><Hyperlink NavigateUri="https://forms.cloud.microsoft/r/HjuggSZqyU" RequestNavigate="Hyperlink_RequestNavigate" Style="{StaticResource KLCodeFooterLink}">Prototype</Hyperlink></TextBlock>
            <TextBlock Grid.Column="1" Text="Duplicate sheets" Style="{StaticResource KLCodeFooterVersion}"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"><Hyperlink NavigateUri="https://forms.microsoft.com/Pages/ResponsePage.aspx?id=Bfmd9K3MFkqVWdMqprbPvvfxx29Ur-NGhLTDKxuFAqVUMU1OMUpRWDRKUDBMNEFEMlQ2SEJJNFdCUi4u" RequestNavigate="Hyperlink_RequestNavigate" Style="{StaticResource KLCodeFooterLink}">Outreach</Hyperlink></TextBlock>
        </Grid>
    </Grid>



</Window>
