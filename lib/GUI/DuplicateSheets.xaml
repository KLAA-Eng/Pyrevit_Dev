<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"

    Title="Views: Find and Replace"
    Height="491" Width="800"
    WindowStartupLocation="CenterScreen"
    HorizontalAlignment="Center"
    ShowInTaskbar="False"

    WindowStyle="None"
    ResizeMode="NoResize"


    Background="#1A252B"
    >




    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="24"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="24"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>


        <Grid Grid.Row="0"
                MouseDown="header_drag"
                Background="{StaticResource header_background}"
                Grid.ColumnSpan="2"
              >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="86"/>


            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Width="70" Height="12" Margin="8,0,0,0"
                            VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                            ContentTemplate="{StaticResource KLCodeWordmark}"/>
            <DockPanel Grid.Column="0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       Visibility="Collapsed">
                


               
                <TextBlock
                    FontSize="14px"
                    FontWeight="Heavy"
                    Foreground="{StaticResource text_white}">
                    KLCode
                </TextBlock>
            </DockPanel>
            


            <TextBlock x:Name="main_title"
                Text="__title__"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Foreground="{StaticResource text_white}"
                MaxWidth="180"
                TextTrimming="CharacterEllipsis"
                />


            <Button Grid.Column="2"
                    Content="Close"
                    Click="button_close"
                    Style="{StaticResource KLCodeCloseButton}"/>

        </Grid>







        <StackPanel Grid.Row="1"
                    VerticalAlignment="Top"
                    Margin="16,16,16,0">







            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="139*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0"
                           Content="Naming"
                           Margin="0"
                           Background="{StaticResource header_background}"
                           Foreground="{StaticResource text_white}"
                           Grid.ColumnSpan="2"/>

                <Border Grid.Row="1"
                            
                        BorderBrush="{DynamicResource border_green}"
                            BorderThickness="1,1,1,1"
                            CornerRadius="10" Grid.ColumnSpan="2"
                            >




                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>

                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <Label Content="ViewName"
                               Foreground="{StaticResource text_white}"
                               FontSize="12"
                               HorizontalAlignment="left"
                               FontWeight="Medium"
                                   Margin="50,0,0,0"/>

                            <DockPanel Margin="5,0,0,5">

                                <TextBlock Text="Find"
                                           Foreground="{StaticResource text_white}"
                                           FontWeight="Medium"
                                           Width="50"/>

                                <TextBox   x:Name = "UI_view_find"
                                           Background="{StaticResource header_background}"
                                           Foreground="{StaticResource text_white}"/>
                            </DockPanel>

                            <DockPanel Margin="5,0,0,5">
                                <TextBlock Text="Replace"

                                    Foreground="{DynamicResource text_white}"
                                   FontWeight="Medium"

                                   Width="50"/>
                                <TextBox  Background="{StaticResource header_background}"
                                          Foreground="{DynamicResource text_white}"
                                           x:Name = "UI_view_replace"/>
                            </DockPanel>

                            <DockPanel Margin="5,0,0,5">
                                <TextBlock Text="Prefix"

                                   Foreground="{DynamicResource text_white}"
                                   FontWeight="Medium"

                                   Width="50"/>
                                <TextBox  Background="{StaticResource header_background}"
                                          Foreground="{DynamicResource text_white}"
                                          x:Name = "UI_view_prefix"/>
                            </DockPanel>

                            <DockPanel Margin="5,0,0,5">
                                <TextBlock Text="Suffix"

                                    Foreground="{DynamicResource text_white}"
                                   FontWeight="Medium"

                                   Width="50"/>
                                <TextBox  Background="{StaticResource header_background}"
                                          Foreground="{DynamicResource text_white}"
                                          x:Name = "UI_view_suffix"/>
                            </DockPanel>



                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="0">
                            <Label Content="SheetNumber"
                               Foreground="{DynamicResource text_white}"
                               FontSize="12"
                               HorizontalAlignment="Left"
                                   Margin="50,0,0,0"
                               FontWeight="Medium"/>

                            <DockPanel Margin="5,0,0,5">

                                <TextBlock Text="Find"
                                           
                                   Foreground="{DynamicResource text_white}"
                                   FontWeight="Medium"
                                   Width="50"/>
                                <TextBox  
                                    x:Name = "UI_sheet_number_find"
                                    Background="{StaticResource header_background}"
                                          Foreground="{DynamicResource text_white}"
                                          />
                            </DockPanel>

                            <DockPanel Margin="5,0,0,5">
                                <TextBlock Text="Replace"
                                           
                                   Foreground="{DynamicResource text_white}"
                                   FontWeight="Medium"

                                   Width="50"/>
                                <TextBox  
                                    x:Name = "UI_sheet_number_replace"
                                    Foreground="{DynamicResource text_white}"
                                    Background="{StaticResource header_background}"/>
                            </DockPanel>

                            <DockPanel Margin="5,0,0,5">
                                <TextBlock Text="Prefix"
                                           
                                   Foreground="{DynamicResource text_white}"
                                   FontWeight="Medium"

                                   Width="50"/>
                                <TextBox  Background="{StaticResource header_background}"
                                          x:Name = "UI_sheet_number_prefix"
                                          Foreground="{DynamicResource text_white}"
                                          />
                            </DockPanel>

                            <DockPanel Margin="5,0,0,5">
                                <TextBlock Text="Suffix"
                                          
                                   Foreground="{DynamicResource text_white}"
                                   FontWeight="Medium"

                                   Width="50"/>
                                <TextBox  Background="{StaticResource header_background}"
                                          Foreground="{DynamicResource text_white}"
                                           x:Name = "UI_sheet_number_suffix"
                                          />
                            </DockPanel>



                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="0"
                                Margin="10,0,0,0">
                            <Label Content="SheetName"
                               Foreground="{DynamicResource text_white}"
                               FontSize="12"
                               FontWeight="Medium"
                                   Margin="50,0,0,0"
                               HorizontalAlignment="Left"/>

                            <DockPanel Margin="5,0,0,5">
                                <TextBlock Text="Find"
                                          
                                   Foreground="{DynamicResource text_white}"
                                   FontWeight="Medium"
                                   Width="50"/>
                                <TextBox  Background="{StaticResource header_background}"
                                           x:Name = "UI_sheet_name_find"
                                          Foreground="{DynamicResource text_white}"
                                          />
                            </DockPanel>

                            <DockPanel Margin="5,0,0,5">
                                <TextBlock Text="Replace"
                                            
                                   Foreground="{DynamicResource text_white}"
                                   FontWeight="Medium"

                                   Width="50"/>
                                <TextBox  Background="{StaticResource header_background}"
                                          Foreground="{DynamicResource text_white}"
                                          x:Name = "UI_sheet_name_replace"
                                          />
                            </DockPanel>

                            <DockPanel Margin="5,0,0,5">
                                <TextBlock Text="Prefix"
                                            
                                   Foreground="{DynamicResource text_white}"
                                   FontWeight="Medium"

                                   Width="50"/>
                                <TextBox  Background="{StaticResource header_background}"
                                          x:Name = "UI_sheet_name_prefix"
                                           Foreground="{DynamicResource text_white}"
                                          />
                            </DockPanel>

                            <DockPanel Margin="5,0,0,5">
                                <TextBlock Text="Suffix"
                                           
                                   Foreground="{DynamicResource text_white}"
                                   FontWeight="Medium"

                                   Width="50"/>
                                <TextBox  Background="{StaticResource header_background}"
                                           x:Name = "UI_sheet_name_suffix"
                                          Foreground="{DynamicResource text_white}"
                                          />
                            </DockPanel>



                        </StackPanel>


                    </Grid>



                </Border>
            </Grid>








            <!--<Grid Margin="0,0,0,25">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Label Content="Project Browser"
