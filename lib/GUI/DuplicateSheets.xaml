<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Duplicate Sheets"
    Width="1050"
    Height="688"
    MinWidth="1050"
    MinHeight="480"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    Style="{StaticResource klcWindow}"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="DuplicateSectionHeading" BasedOn="{StaticResource klcTextBlockHeading}" TargetType="TextBlock">
            <Setter Property="Margin" Value="{StaticResource klcStackGapBelow}" />
        </Style>
        <Style x:Key="DuplicateElementOption" BasedOn="{StaticResource klcCheckBox}" TargetType="CheckBox">
            <Setter Property="MinHeight" Value="{StaticResource klcButtonHeight}" />
        </Style>
    </Window.Resources>
    <ContentControl x:Name="window_shell" Style="{StaticResource klcWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource klcTextBlockHeading}" Text="Naming" />
                    <Border Grid.Row="2" Style="{StaticResource klcBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    Style="{StaticResource DuplicateSectionHeading}"
                                    Text="View Name" />
                                <ItemsControl Style="{StaticResource klcRenameRows}">
                                    <Label
                                        Grid.Row="0"
                                        Content="Find:"
                                        Style="{StaticResource klcLabelCentered}"
                                        Target="{Binding ElementName=UI_view_find}" />
                                    <TextBox
                                        x:Name="UI_view_find"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        AutomationProperties.Name="View name find"
                                        Style="{StaticResource klcTextBox}" />
                                    <Label
                                        Grid.Row="2"
                                        Content="Replace:"
                                        Style="{StaticResource klcLabelCentered}"
                                        Target="{Binding ElementName=UI_view_replace}" />
                                    <TextBox
                                        x:Name="UI_view_replace"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        AutomationProperties.Name="View name replace"
                                        Style="{StaticResource klcTextBox}" />
                                    <Label
                                        Grid.Row="4"
                                        Content="Prefix:"
                                        Style="{StaticResource klcLabelCentered}"
                                        Target="{Binding ElementName=UI_view_prefix}" />
                                    <TextBox
                                        x:Name="UI_view_prefix"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        AutomationProperties.Name="View name prefix"
                                        Style="{StaticResource klcTextBox}" />
                                    <Label
                                        Grid.Row="6"
                                        Content="Suffix:"
                                        Style="{StaticResource klcLabelCentered}"
                                        Target="{Binding ElementName=UI_view_suffix}" />
                                    <TextBox
                                        x:Name="UI_view_suffix"
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        AutomationProperties.Name="View name suffix"
                                        Style="{StaticResource klcTextBox}" />
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Style="{StaticResource DuplicateSectionHeading}"
                                    Text="Sheet Number" />
                                <ItemsControl Style="{StaticResource klcRenameRows}">
                                    <Label
                                        Grid.Row="0"
                                        Content="Find:"
                                        Style="{StaticResource klcLabelCentered}"
                                        Target="{Binding ElementName=UI_sheet_number_find}" />
                                    <TextBox
                                        x:Name="UI_sheet_number_find"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        AutomationProperties.Name="Sheet number find"
                                        Style="{StaticResource klcTextBox}" />
                                    <Label
                                        Grid.Row="2"
                                        Content="Replace:"
                                        Style="{StaticResource klcLabelCentered}"
                                        Target="{Binding ElementName=UI_sheet_number_replace}" />
                                    <TextBox
                                        x:Name="UI_sheet_number_replace"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        AutomationProperties.Name="Sheet number replace"
                                        Style="{StaticResource klcTextBox}" />
                                    <Label
                                        Grid.Row="4"
                                        Content="Prefix:"
                                        Style="{StaticResource klcLabelCentered}"
                                        Target="{Binding ElementName=UI_sheet_number_prefix}" />
                                    <TextBox
                                        x:Name="UI_sheet_number_prefix"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        AutomationProperties.Name="Sheet number prefix"
                                        Style="{StaticResource klcTextBox}" />
                                    <Label
                                        Grid.Row="6"
                                        Content="Suffix:"
                                        Style="{StaticResource klcLabelCentered}"
                                        Target="{Binding ElementName=UI_sheet_number_suffix}" />
                                    <TextBox
                                        x:Name="UI_sheet_number_suffix"
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        AutomationProperties.Name="Sheet number suffix"
                                        Style="{StaticResource klcTextBox}" />
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock
                                    Style="{StaticResource DuplicateSectionHeading}"
                                    Text="Sheet Name" />
                                <ItemsControl Style="{StaticResource klcRenameRows}">
                                    <Label
                                        Grid.Row="0"
                                        Content="Find:"
                                        Style="{StaticResource klcLabelCentered}"
                                        Target="{Binding ElementName=UI_sheet_name_find}" />
                                    <TextBox
                                        x:Name="UI_sheet_name_find"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        AutomationProperties.Name="Sheet name find"
                                        Style="{StaticResource klcTextBox}" />
                                    <Label
                                        Grid.Row="2"
                                        Content="Replace:"
                                        Style="{StaticResource klcLabelCentered}"
                                        Target="{Binding ElementName=UI_sheet_name_replace}" />
                                    <TextBox
                                        x:Name="UI_sheet_name_replace"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        AutomationProperties.Name="Sheet name replace"
                                        Style="{StaticResource klcTextBox}" />
                                    <Label
                                        Grid.Row="4"
                                        Content="Prefix:"
                                        Style="{StaticResource klcLabelCentered}"
                                        Target="{Binding ElementName=UI_sheet_name_prefix}" />
                                    <TextBox
                                        x:Name="UI_sheet_name_prefix"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        AutomationProperties.Name="Sheet name prefix"
                                        Style="{StaticResource klcTextBox}" />
                                    <Label
                                        Grid.Row="6"
                                        Content="Suffix:"
                                        Style="{StaticResource klcLabelCentered}"
                                        Target="{Binding ElementName=UI_sheet_name_suffix}" />
                                    <TextBox
                                        x:Name="UI_sheet_name_suffix"
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        AutomationProperties.Name="Sheet name suffix"
                                        Style="{StaticResource klcTextBox}" />
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock
                        Grid.Row="4"
                        Style="{StaticResource klcTextBlockHeading}"
                        Text="Include Elements" />
                    <Border Grid.Row="6" Style="{StaticResource klcBorder}">
                        <UniformGrid Columns="4" Rows="3">
                            <CheckBox
                                x:Name="UI_checkbox_views"
                                Content="Views"
                                IsChecked="True"
                                Style="{StaticResource DuplicateElementOption}" />
                            <CheckBox
                                x:Name="UI_checkbox_legends"
                                Content="Legends"
                                IsChecked="True"
                                Style="{StaticResource DuplicateElementOption}" />
                            <CheckBox
                                x:Name="UI_checkbox_schedules"
                                Content="Schedules"
                                IsChecked="True"
                                Style="{StaticResource DuplicateElementOption}" />
                            <CheckBox
                                x:Name="UI_checkbox_images"
                                Content="Images"
                                IsChecked="True"
                                Style="{StaticResource DuplicateElementOption}" />
                            <CheckBox
                                x:Name="UI_checkbox_lines"
                                Content="Lines"
                                IsChecked="True"
                                Style="{StaticResource DuplicateElementOption}" />
                            <CheckBox
                                x:Name="UI_checkbox_text"
                                Content="Text"
                                IsChecked="True"
                                Style="{StaticResource DuplicateElementOption}" />
                            <CheckBox
                                x:Name="UI_checkbox_clouds"
                                Content="Clouds"
                                IsChecked="False"
                                Style="{StaticResource DuplicateElementOption}" />
                            <CheckBox
                                x:Name="UI_checkbox_dwgs"
                                Content="DWGs"
                                IsChecked="False"
                                Style="{StaticResource DuplicateElementOption}" />
                            <CheckBox
                                x:Name="UI_checkbox_symbols"
                                Content="Symbols"
                                IsChecked="False"
                                Style="{StaticResource DuplicateElementOption}" />
                            <CheckBox
                                x:Name="UI_checkbox_dimensions"
                                Content="Dimensions"
                                IsChecked="False"
                                Style="{StaticResource DuplicateElementOption}" />
                            <CheckBox
                                x:Name="UI_checkbox_additional_revisions"
                                Content="Additional Revisions"
                                IsChecked="False"
                                Style="{StaticResource DuplicateElementOption}" />
                        </UniformGrid>
                    </Border>
                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource klcBodySpaceNormal}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource klcTextBlockHeading}" Text="Use Existing" ToolTip="Checked items reuse existing views. Unchecked items create duplicates." />
                            <Border Grid.Row="2" Style="{StaticResource klcBorder}">
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <CheckBox
                                        x:Name="UI_checkbox_use_existing_legend"
                                        Content="Legends"
                                        IsChecked="True"
                                        Style="{StaticResource DuplicateElementOption}" />
                                    <CheckBox
                                        x:Name="UI_checkbox_use_existing_schedules"
                                        Content="Schedules"
                                        IsChecked="True"
                                        Style="{StaticResource DuplicateElementOption}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{StaticResource klcBodySpaceNormal}" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource klcTextBlockHeading}" Text="View Duplicate Options" />
                            <Border Grid.Row="2" Style="{StaticResource klcBorder}">
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <RadioButton
                                        Checked="radiobutton_duplicate_option"
                                        Content="Duplicate"
                                        IsChecked="True"
                                        Style="{StaticResource xRadioButton}" />
                                    <RadioButton
                                        Checked="radiobutton_duplicate_option"
                                        Content="Duplicate detailing"
                                        Style="{StaticResource xRadioButton}" />
                                    <RadioButton
                                        Checked="radiobutton_duplicate_option"
                                        Content="Duplicate Dependent"
                                        Style="{StaticResource xRadioButton}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
            <Button
                x:Name="primary_action"
                Grid.Row="2"
                Click="button_run"
                Content="Duplicate Selected Sheets"
                IsDefault="True"
                Style="{StaticResource klcButtonDouble}" />
        </Grid>
    </ContentControl>
</Window>
