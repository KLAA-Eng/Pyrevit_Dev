<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Match Properties Recall" Width="448" Height="540" MinWidth="448" MinHeight="360"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" ResizeMode="CanResizeWithGrip"
        Style="{StaticResource KlaFoundationWindow}">
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid x:Name="window_body"><ContentControl x:Name="content_host"/></Grid>
    </ContentControl>
</Window>
