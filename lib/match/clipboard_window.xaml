<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Match Properties – Recall"
        Width="420"
        SizeToContent="Height"
        MinWidth="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#1A252B">

    <Border Background="#1A252B" BorderBrush="{StaticResource border_green_dark}" BorderThickness="1">
        <Grid Background="#1A252B">
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
                <RowDefinition Height="25" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource header_background}" MouseDown="header_drag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>
                <ContentControl Grid.Column="0" Width="70" Height="12" Margin="8,0,0,0"
                                VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                ContentTemplate="{StaticResource KLCodeWordmark}"/>
                <DockPanel Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                    <TextBlock Margin="5,0,0,0"
                               FontSize="14px"
                               FontWeight="Heavy"
                               Foreground="{StaticResource text_white}">
                        KLCode
                    </TextBlock>
                </DockPanel>
                <TextBlock Text="Match Properties Recall"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource text_white}"
                           MaxWidth="180"
                           TextTrimming="CharacterEllipsis" />
                <Button Content="Close"
                        Grid.Column="2"
                        Click="button_close"
                        Style="{StaticResource KLCodeCloseButton}" />
            </Grid>

            <ContentControl x:Name="content_host"
                            Grid.Row="1"
                            Margin="10" />

            <Grid Grid.Row="2" Background="{StaticResource header_background}">
                <TextBlock Text="KLCode"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource text_gray}" />
            </Grid>
        </Grid>
    </Border>
</Window>
