<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevSandbox UI Gallery" Height="520" Width="900"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Open representative pyRevit and KL&amp;A dialogs with fictional sample data. Gallery previews never modify the Revit document."
                       TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBox x:Name="FilterBox" Height="25" TextChanged="filter_changed"
                     ToolTip="Filter by dialog family, title, or description" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="LaunchButton" Content="Open Selected Window" Width="155" Margin="0,0,8,0" Click="launch_selected" />
            <Button Content="Close" Width="80" Click="close_window" />
        </StackPanel>
        <DataGrid x:Name="EntriesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="selection_changed" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Family" Binding="{Binding Category}" Width="140" />
                <DataGridTextColumn Header="Window" Binding="{Binding Title}" Width="2*" />
                <DataGridTextColumn Header="Data" Binding="{Binding SampleData}" Width="135" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
