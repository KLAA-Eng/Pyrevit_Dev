<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="KLA.ModelStartupImporter.UI.Views.BlockingIssuesWindow" Title="{StaticResource StartupImportReviewTitle}" Width="560" Height="520" Style="{StaticResource KlaWindowStyle}" WindowStartupLocation="CenterOwner">
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{StaticResource KlaWarningBrush}" BorderThickness="1" CornerRadius="8" Margin="0,8,0,4" Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{StaticResource klgeoErrorAlert}" Style="{StaticResource KlaGuiIcon}" Foreground="{StaticResource KlaBlockingBrush}" />
                    <TextBlock Grid.Column="1" Text="{StaticResource ResolveIssuesInstruction}" FontSize="12" TextWrapping="Wrap" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12,4">
                    <Border BorderBrush="{StaticResource KlaBlockingBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding UnknownHeading}" Foreground="{StaticResource KlaBlockingBrush}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding UnknownItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{StaticResource KlaWarningBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding DuplicateHeading}" Foreground="{StaticResource KlaWarningBrush}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding DuplicateItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Margin="0,2" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KlaGroupBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding ImportableHeading}" Foreground="{StaticResource KlaInfoBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{StaticResource CleanMatchesBlockedLabel}" Style="{StaticResource KlaMutedTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,8">
                <Button Content="{StaticResource CopyIssueReportLabel}" Style="{StaticResource KlaButtonStyle}" HorizontalAlignment="Left" Click="OnCopyIssueReportClick" />
                <Button Content="{StaticResource ImportBlockedLabel}" Style="{StaticResource KlaFoundationMainButton}" HorizontalAlignment="Right" IsEnabled="False" />
            </Grid>
        </Grid>
    </ContentControl>
</Window>
