<Window x:Class="KLA.ModelStartupImporter.UI.Views.BlockingIssuesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource StartupImportReviewTitle}"
        Width="560" Height="520"
        Style="{StaticResource KlaWindowStyle}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="64" /><RowDefinition Height="*" /><RowDefinition Height="46" /><RowDefinition Height="24" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{StaticResource header_background}" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource KlaHeaderBrandStyle}"><Run Text="{StaticResource BrandSlash}" Foreground="{StaticResource text_green}" /><Run Text="{StaticResource BrandName}" /></TextBlock>
            <TextBlock Grid.ColumnSpan="3" Text="{StaticResource ReviewStartupImportTitle}" Style="{StaticResource KlaHeaderTitleStyle}" MaxWidth="348" />
            <Button Grid.Column="2" Content="{StaticResource CloseLabel}" Style="{StaticResource KlaCloseButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnCloseClick" />
        </Grid>
        <Border Grid.Row="1" BorderBrush="{StaticResource KlaWarningBrush}" BorderThickness="1" CornerRadius="8" Margin="12,8,12,4" Padding="10,7">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="!" Foreground="{StaticResource KlaWarningBrush}" FontSize="16" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="{StaticResource ResolveIssuesInstruction}" FontSize="12" TextWrapping="Wrap" />
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,4">
                <Border BorderBrush="{StaticResource KlaBlockingBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                    <StackPanel><TextBlock Text="{Binding UnknownHeading}" Foreground="{StaticResource KlaBlockingBrush}" FontWeight="SemiBold" Margin="0,0,0,6" /><ItemsControl ItemsSource="{Binding UnknownItems}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource KlaWarningBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                    <StackPanel><TextBlock Text="{Binding DuplicateHeading}" Foreground="{StaticResource KlaWarningBrush}" FontWeight="SemiBold" Margin="0,0,0,6" /><ItemsControl ItemsSource="{Binding DuplicateItems}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Margin="0,2" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </Border>
                <Border Style="{StaticResource KlaGroupBorderStyle}">
                    <StackPanel><TextBlock Text="{Binding ImportableHeading}" Foreground="{StaticResource KlaInfoBrush}" FontWeight="SemiBold" /><TextBlock Text="{StaticResource CleanMatchesBlockedLabel}" Style="{StaticResource KlaMutedTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="3" Margin="12,8">
            <Button Content="{StaticResource CopyIssueReportLabel}" Style="{StaticResource KlaButtonStyle}" HorizontalAlignment="Left" Click="OnCopyIssueReportClick" />
            <Button Width="180" Height="30" Content="{StaticResource ImportBlockedLabel}" Style="{StaticResource KlaButtonStyle}" HorizontalAlignment="Right" IsEnabled="False" />
        </Grid>
        <Grid Grid.Row="4">
            <TextBlock Text="{StaticResource PrototypeLabel}" Style="{StaticResource KlaFooterTextStyle}" HorizontalAlignment="Left" Margin="10,0,0,0" />
            <TextBlock Text="{StaticResource VersionLabel}" Foreground="{StaticResource KlaMutedTextBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="{StaticResource OutreachLabel}" Style="{StaticResource KlaFooterTextStyle}" HorizontalAlignment="Right" Margin="0,0,10,0" />
        </Grid>
    </Grid>
</Window>
