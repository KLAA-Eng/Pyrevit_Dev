<Window x:Class="KLA.ModelStartupImporter.UI.Views.StartupImportReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource StartupImportReviewTitle}"
        Width="860" Height="640"
        Style="{StaticResource KlaWindowStyle}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="38" /><RowDefinition Height="*" /><RowDefinition Height="46" /><RowDefinition Height="24" /></Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource header_background}" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource KlaHeaderBrandStyle}"><Run Text="{StaticResource BrandSlash}" Foreground="{StaticResource text_green}" /><Run Text="{StaticResource BrandName}" /></TextBlock>
            <TextBlock Grid.ColumnSpan="3" Text="{StaticResource ReviewStartupImportTitle}" Style="{StaticResource KlaHeaderTitleStyle}" MaxWidth="648" />
            <Button Grid.Column="2" Content="{StaticResource CloseLabel}" Style="{StaticResource KlaCloseButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnCancelClick" />
        </Grid>

        <Grid Grid.Row="1" Margin="12,8,12,4">
            <WrapPanel>
                <Border Style="{StaticResource KlaInfoChipStyle}" Margin="0,0,6,0"><TextBlock Text="{Binding MatchedSummary}" FontSize="11" Foreground="{StaticResource KlaInfoBrush}" /></Border>
                <Border Style="{StaticResource KlaNeutralChipStyle}" Margin="0,0,6,0"><TextBlock Text="{Binding ExistingSummary}" FontSize="11" Foreground="{StaticResource KlaMutedTextBrush}" /></Border>
                <Border Style="{StaticResource KlaNeutralChipStyle}"><TextBlock Text="{Binding UncheckedSummary}" FontSize="11" Foreground="{StaticResource KlaMutedTextBrush}" /></Border>
            </WrapPanel>
            <Border Style="{StaticResource KlaNeutralChipStyle}" HorizontalAlignment="Right"><TextBlock Text="{Binding CatalogSummary}" FontSize="11" Foreground="{StaticResource KlaSubtleTextBrush}" /></Border>
        </Grid>

        <Grid Grid.Row="2" Margin="12,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{StaticResource border_green_dark}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="{StaticResource KlaPanelBrush}" Margin="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{StaticResource ItemIdLabel}" Foreground="{StaticResource text_green}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{StaticResource ItemTitleLabel}" Foreground="{StaticResource text_green}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{StaticResource ItemCategoryLabel}" Foreground="{StaticResource text_green}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{StaticResource ItemStatusLabel}" Foreground="{StaticResource text_green}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" Padding="2"
                             ItemContainerStyle="{StaticResource KlaListBoxItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Visible">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid MinHeight="30">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsActionable}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ItemId}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="3" Text="{Binding Category}" FontSize="11" Foreground="{StaticResource KlaMutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="4" x:Name="StatusBorder" Style="{StaticResource KlaNeutralChipStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="10" Foreground="{StaticResource KlaMutedTextBrush}" />
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding StatusTone}" Value="Matched"><Setter TargetName="StatusBorder" Property="BorderBrush" Value="{StaticResource KlaInfoBrush}" /><Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource KlaInfoBrush}" /></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource text_green}" FontSize="12" Margin="0,0,0,8"><Run Text="{StaticResource SelectedItemPrefix}" /><Run Text="{Binding SelectedRow.ItemId}" /></TextBlock>
                    <Border Height="210" Style="{StaticResource KlaPreviewBorderStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedRow.SourceName}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource KlaMutedTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{StaticResource SeedPreviewPlaceholderLabel}" FontSize="11" Foreground="{StaticResource KlaMutedTextBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding SelectedRow.Title}" FontSize="12" Margin="0,8,0,8" TextWrapping="Wrap" />
                    <Grid Margin="0,4,0,10">
                        <Border Style="{StaticResource KlaGroupBorderStyle}">
                            <StackPanel Margin="0,2,0,0">
                                <Border BorderBrush="{StaticResource border_green_dark}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource button_bg_normal}" Padding="4"><TextBlock Text="{Binding SelectedRow.TargetKind}" FontSize="11" HorizontalAlignment="Center" /></Border>
                                        <TextBlock Grid.Column="1" Text="{StaticResource SheetTargetLabel}" Foreground="{StaticResource KlaSubtleTextBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"><Run Text="{StaticResource NewTargetPrefix}" Foreground="{StaticResource KlaMutedTextBrush}" /><Run Text="{Binding SelectedRow.TargetName}" /></TextBlock>
                                <TextBlock Text="{StaticResource NativeEditableLabel}" Style="{StaticResource KlaMutedTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{StaticResource PlacementTargetGroupLabel}" Style="{StaticResource KlaGroupCaptionStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-8,0,0" />
                    </Grid>
                    <TextBlock FontSize="11" TextWrapping="Wrap"><Run Text="{StaticResource RequiresPrefix}" Foreground="{StaticResource KlaMutedTextBrush}" /><Run Text="{Binding SelectedRow.Requirements}" Foreground="{StaticResource KlaSubtleTextBrush}" /></TextBlock>
                    <TextBlock Text="{StaticResource RequirementsPreflightLabel}" Foreground="{StaticResource KlaInfoBrush}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="3" Margin="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{StaticResource SelectAllLabel}" Style="{StaticResource KlaButtonStyle}" Margin="0,0,8,0" Click="OnSelectAllClick" />
                <Button Content="{StaticResource SelectNoneLabel}" Style="{StaticResource KlaButtonStyle}" Margin="0,0,12,0" Click="OnSelectNoneClick" />
                <TextBlock Text="{Binding SelectionStatus}" Style="{StaticResource KlaMutedTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="80" Content="{StaticResource CancelLabel}" Style="{StaticResource KlaGhostButtonStyle}" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick" />
                <Button Width="180" Height="30" Content="{Binding ImportButtonLabel}" Style="{StaticResource KlaButtonStyle}" IsDefault="True" IsEnabled="{Binding CanImport}" Click="OnImportClick" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4">
            <TextBlock Text="{StaticResource PrototypeLabel}" Style="{StaticResource KlaFooterTextStyle}" HorizontalAlignment="Left" Margin="10,0,0,0" />
            <TextBlock Text="{StaticResource VersionLabel}" Foreground="{StaticResource KlaMutedTextBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="{StaticResource OutreachLabel}" Style="{StaticResource KlaFooterTextStyle}" HorizontalAlignment="Right" Margin="0,0,10,0" />
        </Grid>
    </Grid>
</Window>
