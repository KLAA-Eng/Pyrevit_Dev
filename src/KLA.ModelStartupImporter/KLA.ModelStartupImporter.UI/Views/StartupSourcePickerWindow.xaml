<Window x:Class="KLA.ModelStartupImporter.UI.Views.StartupSourcePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource SourcePickerTitle}"
        Width="560" Height="470"
        Style="{StaticResource KlaWindowStyle}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource header_background}" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource KlaHeaderBrandStyle}"><Run Text="{StaticResource BrandSlash}" Foreground="{StaticResource text_green}" /><Run Text="{StaticResource BrandName}" /></TextBlock>
            <TextBlock Grid.ColumnSpan="3" Text="{StaticResource StartupImporterWindowTitle}" Style="{StaticResource KlaHeaderTitleStyle}" MaxWidth="348" />
            <Button Grid.Column="2" Content="{StaticResource CloseLabel}" Style="{StaticResource KlaCloseButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnCancelClick" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,12,14,4">
                <Grid Margin="0,4,0,12">
                    <Border Style="{StaticResource KlaGroupBorderStyle}">
                        <StackPanel Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ChecklistPath}" IsReadOnly="True" Margin="0,0,6,0" ToolTip="{Binding ChecklistPath}" />
                                <Button Grid.Column="1" Width="70" Content="{StaticResource BrowseLabel}" Style="{StaticResource KlaSmallButtonStyle}" Click="OnBrowseChecklistClick" />
                            </Grid>
                            <TextBlock x:Name="ChecklistStatus" Text="{Binding ChecklistStatus}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{StaticResource StartupChecklistGroupLabel}" Style="{StaticResource KlaGroupCaptionStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-8,0,0" />
                </Grid>

                <Grid Margin="0,4,0,12">
                    <Border Style="{StaticResource KlaGroupBorderStyle}">
                        <StackPanel Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SettingsPath}" IsReadOnly="True" Margin="0,0,6,0" ToolTip="{Binding SettingsPath}" />
                                <Button Grid.Column="1" Width="70" Content="{StaticResource BrowseLabel}" Style="{StaticResource KlaSmallButtonStyle}" Click="OnBrowseSettingsClick" />
                            </Grid>
                            <TextBlock x:Name="SettingsStatus" Text="{Binding SettingsStatus}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SeedModelStatus}" Style="{StaticResource KlaMutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CatalogStatus}" Style="{StaticResource KlaMutedTextStyle}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{StaticResource SettingsJsonGroupLabel}" Style="{StaticResource KlaGroupCaptionStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-8,0,0" />
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Border Style="{StaticResource KlaGroupBorderStyle}">
                        <TextBlock Margin="0,2,0,0"><Run Text="{StaticResource ActiveProjectLabel}" /><Run Text="{Binding DestinationProject}" Foreground="{StaticResource KlaSubtleTextBrush}" /></TextBlock>
                    </Border>
                    <TextBlock Text="{StaticResource DestinationGroupLabel}" Style="{StaticResource KlaGroupCaptionStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-8,0,0" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="14,8">
            <TextBlock Text="{StaticResource NothingCreatedUntilReviewLabel}" Style="{StaticResource KlaMutedTextStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="80" Content="{StaticResource CancelLabel}" Style="{StaticResource KlaGhostButtonStyle}" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick" />
                <Button Width="150" Height="30" Content="{StaticResource ReviewImportLabel}" Style="{StaticResource KlaButtonStyle}" IsDefault="True" IsEnabled="{Binding CanReview}" Click="OnReviewClick" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <TextBlock Text="{StaticResource PrototypeLabel}" Style="{StaticResource KlaFooterTextStyle}" HorizontalAlignment="Left" Margin="10,0,0,0" />
            <TextBlock Text="{StaticResource VersionLabel}" Foreground="{StaticResource KlaMutedTextBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="{StaticResource OutreachLabel}" Style="{StaticResource KlaFooterTextStyle}" HorizontalAlignment="Right" Margin="0,0,10,0" />
        </Grid>
    </Grid>
</Window>
