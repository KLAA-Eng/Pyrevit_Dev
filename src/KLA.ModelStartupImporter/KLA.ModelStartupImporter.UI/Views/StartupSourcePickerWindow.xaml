<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="KLA.ModelStartupImporter.UI.Views.StartupSourcePickerWindow" Title="{StaticResource SourcePickerTitle}" Width="560" Height="470" Style="{StaticResource KlaWindowStyle}" WindowStartupLocation="CenterOwner">
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,12,14,4">
                    <Grid Margin="0,4,0,12">
                        <Border Style="{StaticResource KlaGroupBorderStyle}">
                            <StackPanel Margin="0,2,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="112" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ChecklistPath}" IsReadOnly="True" Margin="0,0,6,0" ToolTip="{Binding ChecklistPath}" />
                                    <Button Grid.Column="1" Content="{StaticResource BrowseLabel}" Style="{StaticResource KlaSmallButtonStyle}" Click="OnBrowseChecklistClick" />
                                </Grid>
                                <TextBlock x:Name="ChecklistStatus" Text="{Binding ChecklistStatus}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{StaticResource StartupChecklistGroupLabel}" Style="{StaticResource KlaGroupCaptionStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-8,0,0" />
                    </Grid>
                    <Grid Margin="0,4,0,12">
                        <Border Style="{StaticResource KlaGroupBorderStyle}">
                            <StackPanel Margin="0,2,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="112" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SettingsPath}" IsReadOnly="True" Margin="0,0,6,0" ToolTip="{Binding SettingsPath}" />
                                    <Button Grid.Column="1" Content="{StaticResource BrowseLabel}" Style="{StaticResource KlaSmallButtonStyle}" Click="OnBrowseSettingsClick" />
                                </Grid>
                                <TextBlock x:Name="SettingsStatus" Text="{Binding SettingsStatus}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SeedModelStatus}" Style="{StaticResource KlaMutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CatalogStatus}" Style="{StaticResource KlaMutedTextStyle}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{StaticResource SettingsJsonGroupLabel}" Style="{StaticResource KlaGroupCaptionStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-8,0,0" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Border Style="{StaticResource KlaGroupBorderStyle}">
                            <TextBlock Margin="0,2,0,0">
                                <Run Text="{StaticResource ActiveProjectLabel}" />
                                <Run Text="{Binding DestinationProject}" Foreground="{StaticResource KlaSubtleTextBrush}" />
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{StaticResource DestinationGroupLabel}" Style="{StaticResource KlaGroupCaptionStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-8,0,0" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="1" Margin="0,8">
                <TextBlock Text="{StaticResource NothingCreatedUntilReviewLabel}" Style="{StaticResource KlaMutedTextStyle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{StaticResource CancelLabel}" Style="{StaticResource KlaGhostButtonStyle}" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick" />
                    <Button Content="{StaticResource ReviewImportLabel}" Style="{StaticResource KlaFoundationMainButton}" IsDefault="True" IsEnabled="{Binding CanReview}" Click="OnReviewClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </ContentControl>
</Window>
