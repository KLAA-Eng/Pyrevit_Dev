<Window x:Class="KLCode.FamilyStudio.Revit.Views.FamilyStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource FamilyStudioTitle}"
        Width="1180" Height="740"
        Style="{StaticResource KlaWindowStyle}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="36" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource header_background}" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="66" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource KlaHeaderBrandStyle}">
                <Run Text="{StaticResource BrandSlash}" Foreground="{StaticResource text_green}" />
                <Run Text="{StaticResource BrandName}" />
            </TextBlock>
            <TextBlock Grid.ColumnSpan="3" Text="{StaticResource FamilyStudioWindowTitle}"
                       Style="{StaticResource KlaHeaderTitleStyle}" MaxWidth="968" />
            <Button Grid.Column="2" Content="{StaticResource CloseLabel}" Style="{StaticResource KlaCloseButtonStyle}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnCloseClick" />
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="10,6,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{StaticResource border_green_dark}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{StaticResource FamiliesModeLabel}" IsChecked="True" GroupName="ContentMode" Style="{StaticResource KlaSegmentButtonStyle}" />
                    <RadioButton Content="{StaticResource ViewsModeLabel}" IsEnabled="False" GroupName="ContentMode" Style="{StaticResource KlaSegmentButtonStyle}" ToolTip="{StaticResource ViewsUnavailableLabel}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="{StaticResource border_green}" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                             ToolTip="{StaticResource SearchPlaceholderLabel}" KeyDown="OnSearchBoxKeyDown" />
                </Grid>
            </Border>
            <Border Grid.Column="4" BorderBrush="{StaticResource border_green_dark}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{StaticResource ThisProjectLabel}" IsEnabled="False" GroupName="SearchScope" Style="{StaticResource KlaSegmentButtonStyle}" ToolTip="{StaticResource ProjectScopeUnavailableLabel}" />
                    <RadioButton Content="{StaticResource LibraryLabel}" IsChecked="True" GroupName="SearchScope" Style="{StaticResource KlaSegmentButtonStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" BorderBrush="{StaticResource border_green_dark}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ListMode" Content="{StaticResource ListModeLabel}" IsChecked="True" GroupName="ViewMode" Style="{StaticResource KlaSegmentButtonStyle}" Checked="OnViewModeChanged" />
                    <RadioButton x:Name="GridMode" Content="{StaticResource GridModeLabel}" GroupName="ViewMode" Style="{StaticResource KlaSegmentButtonStyle}" Checked="OnViewModeChanged" />
                </StackPanel>
            </Border>
            <Button Grid.Column="8" Content="{StaticResource RefreshLibraryLabel}" Style="{StaticResource KlaSmallButtonStyle}" Click="OnRefreshClick" />
        </Grid>

        <!-- Filters -->
        <WrapPanel Grid.Row="2" Margin="10,2,10,8" VerticalAlignment="Center">
            <TextBlock Text="{StaticResource CategoryFieldLabel}" VerticalAlignment="Center" Margin="0,0,5,0" />
            <ComboBox x:Name="CategoryFilter" Width="150" Margin="0,0,9,0" SelectionChanged="OnFilterChanged" />
            <TextBlock Text="{StaticResource TypeFieldLabel}" VerticalAlignment="Center" Margin="0,0,5,0" />
            <ComboBox x:Name="TypeFilter" Width="130" Margin="0,0,9,0" SelectionChanged="OnFilterChanged" />
            <TextBlock Text="{StaticResource ParameterFieldLabel}" VerticalAlignment="Center" Margin="0,0,5,0" />
            <ComboBox x:Name="ParameterFilter" Width="130" Margin="0,0,9,0" SelectionChanged="OnFilterChanged" />
            <TextBlock Text="{StaticResource RootFieldLabel}" VerticalAlignment="Center" Margin="0,0,5,0" />
            <ComboBox x:Name="RootFilter" Width="190" Margin="0,0,10,0" SelectionChanged="OnFilterChanged" />
            <CheckBox x:Name="DuplicatesOnly" Content="{StaticResource DuplicatesOnlyLabel}" Margin="0,0,8,0"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
            <Button Content="{StaticResource ClearFiltersLabel}" Style="{StaticResource KlaLinkButtonStyle}" Click="OnClearFiltersClick" />
        </WrapPanel>

        <!-- Browser body -->
        <Grid Grid.Row="3" Margin="10,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="460" /></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="{StaticResource FamiliesCaptionLabel}" Foreground="{StaticResource text_green}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{StaticResource FavoritesLabel}" Style="{StaticResource KlaLinkButtonStyle}" Margin="0,0,8,0" Click="OnFavoritesClick" />
                        <Button Content="{StaticResource RecentLabel}" Style="{StaticResource KlaLinkButtonStyle}" Margin="0,0,12,0" Click="OnRecentClick" />
                        <TextBlock x:Name="ResultCount" Foreground="{StaticResource KlaMutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <ListBox x:Name="Results" Style="{StaticResource KlaListBoxStyle}"
                             ItemContainerStyle="{StaticResource KlaListBoxItemStyle}"
                             SelectionChanged="OnResultsSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" Tag="{Binding Id}"
                                              VerticalAlignment="Center" Checked="OnBatchChecked" Unchecked="OnBatchUnchecked" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource text_white}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource KlaMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource KlaBlockingChipStyle}" Margin="8,0,2,0"
                                            Visibility="{Binding FlagVisibility}">
                                        <TextBlock Text="{Binding FlagText}" FontSize="10" Foreground="{StaticResource KlaBlockingBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox x:Name="GridResults" Visibility="Collapsed" Style="{StaticResource KlaListBoxStyle}"
                             ItemContainerStyle="{StaticResource KlaListBoxItemStyle}"
                             SelectionChanged="OnGridResultsSelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource border_green_dark}" BorderThickness="1" CornerRadius="10" Padding="6" Margin="2">
                                    <StackPanel>
                                        <Border Height="112" Style="{StaticResource KlaPreviewBorderStyle}" CornerRadius="3">
                                            <Grid>
                                                <TextBlock Text="{StaticResource PreviewUnavailableLabel}" Foreground="{StaticResource KlaMutedTextBrush}"
                                                           FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" />
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Tag="{Binding Id}" HorizontalAlignment="Right"
                                                          VerticalAlignment="Top" Margin="0,5,5,0" Checked="OnBatchChecked" Unchecked="OnBatchUnchecked" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource text_white}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource KlaMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{StaticResource EmptyStateTitle}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{StaticResource EmptyStateBody}" Foreground="{StaticResource KlaMutedTextBrush}" Margin="0,6,0,12" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="{StaticResource ClearFiltersLabel}" Style="{StaticResource KlaSmallButtonStyle}" Margin="0,0,8,0" Click="OnClearFiltersClick" />
                            <Button Content="{StaticResource RefreshLibraryLabel}" Style="{StaticResource KlaSmallButtonStyle}" Click="OnRefreshClick" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Detail pane -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="2,0,4,0">
                    <Border Height="318" Style="{StaticResource KlaPreviewBorderStyle}">
                        <Grid>
                            <TextBlock x:Name="PreviewPlaceholder" Text="{StaticResource PreviewUnavailableLabel}"
                                       FontFamily="Consolas" FontSize="11" Foreground="{StaticResource KlaMutedTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="Thumbnail" Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="FamilyNameText" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,5" TextTrimming="CharacterEllipsis" />
                    <WrapPanel Margin="0,0,0,8">
                        <Border x:Name="StatusChip" Style="{StaticResource KlaWarningChipStyle}" Margin="0,0,6,0"><TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource KlaWarningBrush}" /></Border>
                        <Border Style="{StaticResource KlaChipBorderStyle}" Margin="0,0,6,0"><TextBlock x:Name="CategoryText" FontSize="11" Foreground="{StaticResource KlaMutedTextBrush}" /></Border>
                        <Border Style="{StaticResource KlaChipBorderStyle}"><TextBlock x:Name="DisciplineText" FontSize="11" Foreground="{StaticResource KlaMutedTextBrush}" /></Border>
                    </WrapPanel>

                    <Grid Margin="0,4,0,8">
                        <Border Style="{StaticResource KlaGroupBorderStyle}">
                            <StackPanel Margin="0,2,0,0">
                                <ComboBox x:Name="Types" DisplayMemberPath="Name" SelectionChanged="OnTypeSelectionChanged" />
                                <UniformGrid Columns="3" Margin="0,8,0,6">
                                    <Button Content="{StaticResource DuplicateTypeLabel}" Style="{StaticResource KlaSmallButtonStyle}" Margin="0,0,4,0" IsEnabled="False" ToolTip="{StaticResource TypeEditingUnavailableLabel}" />
                                    <Button Content="{StaticResource RenameTypeLabel}" Style="{StaticResource KlaSmallButtonStyle}" Margin="2,0" IsEnabled="False" ToolTip="{StaticResource TypeEditingUnavailableLabel}" />
                                    <Button Content="{StaticResource EditTypeLabel}" Style="{StaticResource KlaSmallButtonStyle}" Margin="4,0,0,0" IsEnabled="False" ToolTip="{StaticResource TypeEditingUnavailableLabel}" />
                                </UniformGrid>
                                <ItemsControl x:Name="TypeParameters">
                                    <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Style="{StaticResource KlaMutedTextStyle}" /><TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" FontSize="11" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{StaticResource TypeGroupLabel}" Style="{StaticResource KlaGroupCaptionStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-8,0,0" />
                    </Grid>

                    <Grid Margin="0,4,0,8">
                        <Border Style="{StaticResource KlaGroupBorderStyle}">
                            <ItemsControl x:Name="Tags" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource KlaNeutralChipStyle}" Background="{StaticResource KlaPanelBrush}" Margin="0,0,5,4"><TextBlock Text="{Binding}" FontSize="11" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock Text="{StaticResource TagsGroupLabel}" Style="{StaticResource KlaGroupCaptionStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-8,0,0" />
                    </Grid>

                    <Grid Margin="0,4,0,8">
                        <Border Style="{StaticResource KlaGroupBorderStyle}">
                            <ItemsControl x:Name="InstanceParameters" Margin="0,2,0,0">
                                <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Style="{StaticResource KlaMutedTextStyle}" /><TextBlock Grid.Column="1" Text="{Binding StorageType}" HorizontalAlignment="Right" FontSize="11" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock Text="{StaticResource InstanceParametersGroupLabel}" Style="{StaticResource KlaGroupCaptionStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-8,0,0" />
                    </Grid>

                    <TextBlock x:Name="PathText" Style="{StaticResource KlaMutedTextStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ModifiedText" Style="{StaticResource KlaMutedTextStyle}" Margin="0,3,0,0" />
                    <TextBlock x:Name="CatalogCheckText" Style="{StaticResource KlaMutedTextStyle}" Margin="0,3,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Actions -->
        <Grid Grid.Row="4" Margin="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{StaticResource LoadLabel}" Style="{StaticResource KlaButtonStyle}" Margin="0,0,8,0" Click="OnLoadClick" />
                <Button Content="{StaticResource LoadAndPlaceLabel}" Style="{StaticResource KlaButtonStyle}" Margin="0,0,8,0" Click="OnLoadAndPlaceClick" />
                <Button x:Name="BatchLoadButton" Content="{StaticResource BatchLoadLabel}" Style="{StaticResource KlaButtonStyle}" IsEnabled="False" Click="OnBatchLoadClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="BatchCount" Style="{StaticResource KlaMutedTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button x:Name="FavoriteButton" Content="{StaticResource FavoriteLabel}" Style="{StaticResource KlaButtonStyle}" Margin="0,0,8,0" Click="OnFavoriteClick" />
                <Button Content="{StaticResource CopyPathLabel}" Style="{StaticResource KlaButtonStyle}" Margin="0,0,8,0" Click="OnCopyPathClick" />
                <Button Content="{StaticResource OpenFolderLabel}" Style="{StaticResource KlaButtonStyle}" Click="OnOpenFolderClick" />
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="5">
            <TextBlock Text="{StaticResource PrototypeLabel}" Style="{StaticResource KlaFooterTextStyle}" HorizontalAlignment="Left" Margin="10,0,0,0" />
            <TextBlock Text="{StaticResource VersionLabel}" Foreground="{StaticResource KlaMutedTextBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="{StaticResource OutreachLabel}" Style="{StaticResource KlaFooterTextStyle}" HorizontalAlignment="Right" Margin="0,0,10,0" />
        </Grid>
    </Grid>
</Window>
