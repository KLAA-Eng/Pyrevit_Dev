<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="KLCode.FamilyStudio.Revit.Views.FamilyStudioWindow" Title="{StaticResource FamilyStudioTitle}" Width="1180" Height="740" Style="{StaticResource KlaWindowStyle}" WindowStartupLocation="CenterOwner">
    <ContentControl x:Name="window_shell" Style="{StaticResource klcWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,6,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="{StaticResource KlaBorderStrongBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{StaticResource FamiliesModeLabel}" IsChecked="True" GroupName="ContentMode" Style="{StaticResource KlaSegmentButtonStyle}" />
                        <RadioButton Content="{StaticResource ViewsModeLabel}" IsEnabled="False" GroupName="ContentMode" Style="{StaticResource KlaSegmentButtonStyle}" Margin="{StaticResource KlaPairGap}" ToolTip="{StaticResource ViewsUnavailableLabel}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" BorderBrush="{StaticResource klcBorderColor}" BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{StaticResource kliconSearch}" Style="{StaticResource KlaGuiIcon}" AutomationProperties.Name="Search" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" ToolTip="{StaticResource SearchPlaceholderLabel}" KeyDown="OnSearchBoxKeyDown" />
                    </Grid>
                </Border>
                <Border Grid.Column="4" BorderBrush="{StaticResource KlaBorderStrongBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{StaticResource ThisProjectLabel}" IsEnabled="False" GroupName="SearchScope" Style="{StaticResource KlaSegmentButtonStyle}" ToolTip="{StaticResource ProjectScopeUnavailableLabel}" />
                        <RadioButton Content="{StaticResource LibraryLabel}" IsChecked="True" GroupName="SearchScope" Style="{StaticResource KlaSegmentButtonStyle}" Margin="{StaticResource KlaPairGap}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" BorderBrush="{StaticResource KlaBorderStrongBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ListMode" Content="{StaticResource ListModeLabel}" IsChecked="True" GroupName="ViewMode" Style="{StaticResource KlaSegmentButtonStyle}" Checked="OnViewModeChanged">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource KlaGuiIcon}" Content="{StaticResource kliconList}" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>
                        <RadioButton x:Name="GridMode" Content="{StaticResource GridModeLabel}" GroupName="ViewMode" Style="{StaticResource KlaSegmentButtonStyle}" Checked="OnViewModeChanged" Margin="{StaticResource KlaPairGap}">
                            <RadioButton.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource KlaGuiIcon}" Content="{StaticResource kliconGrid}" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButton.ContentTemplate>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <Button Grid.Column="8" Content="{StaticResource RefreshLibraryLabel}" Style="{StaticResource KlaButtonStyle}" Click="OnRefreshClick" />
            </Grid>
            <WrapPanel Grid.Row="1" Margin="0,2,0,8" VerticalAlignment="Center">
                <TextBlock Text="{StaticResource CategoryFieldLabel}" VerticalAlignment="Center" Margin="0,0,5,0" />
                <ComboBox x:Name="CategoryFilter" Width="150" Margin="0,0,9,0" SelectionChanged="OnFilterChanged" />
                <TextBlock Text="{StaticResource TypeFieldLabel}" VerticalAlignment="Center" Margin="0,0,5,0" />
                <ComboBox x:Name="TypeFilter" Width="130" Margin="0,0,9,0" SelectionChanged="OnFilterChanged" />
                <TextBlock Text="{StaticResource ParameterFieldLabel}" VerticalAlignment="Center" Margin="0,0,5,0" />
                <ComboBox x:Name="ParameterFilter" Width="130" Margin="0,0,9,0" SelectionChanged="OnFilterChanged" />
                <TextBlock Text="{StaticResource RootFieldLabel}" VerticalAlignment="Center" Margin="0,0,5,0" />
                <ComboBox x:Name="RootFilter" Width="190" Margin="0,0,10,0" SelectionChanged="OnFilterChanged" />
                <CheckBox x:Name="DuplicatesOnly" Content="{StaticResource DuplicatesOnlyLabel}" Margin="0,0,8,0" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                <Button Content="{StaticResource ClearFiltersLabel}" Style="{StaticResource KlaLinkButtonStyle}" Click="OnClearFiltersClick" />
            </WrapPanel>
            <Grid Grid.Row="2" Margin="0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="460" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="{StaticResource FamiliesCaptionLabel}" Foreground="{StaticResource KlaMutedBrush}" FontSize="12" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{StaticResource FavoritesLabel}" Style="{StaticResource KlaLinkButtonStyle}" Margin="0,0,8,0" Click="OnFavoritesClick" />
                            <Button Content="{StaticResource RecentLabel}" Style="{StaticResource KlaLinkButtonStyle}" Margin="0,0,12,0" Click="OnRecentClick" />
                            <TextBlock x:Name="ResultCount" Foreground="{StaticResource KlaMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="Results" Style="{StaticResource KlaListBoxStyle}" ItemContainerStyle="{StaticResource KlaListBoxItemStyle}" SelectionChanged="OnResultsSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" Tag="{Binding Id}" VerticalAlignment="Center" Checked="OnBatchChecked" Unchecked="OnBatchUnchecked" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource klcTextColor}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource KlaMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource KlaBlockingChipStyle}" Margin="8,0,2,0" Visibility="{Binding FlagVisibility}">
                                            <TextBlock Text="{Binding FlagText}" FontSize="10" Foreground="{StaticResource klcErrorColor}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ListBox x:Name="GridResults" Visibility="Collapsed" Style="{StaticResource KlaListBoxStyle}" ItemContainerStyle="{StaticResource KlaListBoxItemStyle}" SelectionChanged="OnGridResultsSelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource KlaBorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="6" Margin="2">
                                        <StackPanel>
                                            <Border Height="112" Style="{StaticResource KlaPreviewBorderStyle}" CornerRadius="3">
                                                <Grid>
                                                    <TextBlock Text="{StaticResource PreviewUnavailableLabel}" Foreground="{StaticResource KlaMutedBrush}" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" />
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Tag="{Binding Id}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Checked="OnBatchChecked" Unchecked="OnBatchUnchecked" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource klcTextColor}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource KlaMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{StaticResource EmptyStateTitle}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{StaticResource EmptyStateBody}" Foreground="{StaticResource KlaMutedBrush}" Margin="0,6,0,12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="{StaticResource ClearFiltersLabel}" Style="{StaticResource KlaButtonStyle}" Margin="0,0,8,0" Click="OnClearFiltersClick" />
                                <Button Content="{StaticResource RefreshLibraryLabel}" Style="{StaticResource KlaButtonStyle}" Click="OnRefreshClick" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="2,0,4,0">
                        <Border Height="318" Style="{StaticResource KlaPreviewBorderStyle}">
                            <Grid>
                                <TextBlock x:Name="PreviewPlaceholder" Text="{StaticResource PreviewUnavailableLabel}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource KlaMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="Thumbnail" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="FamilyNameText" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,5" TextTrimming="CharacterEllipsis" />
                        <WrapPanel x:Name="DetailChips" Margin="0,0,0,8">
                            <Border x:Name="StatusChip" Style="{StaticResource KlaWarningChipStyle}" Margin="0,0,6,0">
                                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource klcWarningColor}" />
                            </Border>
                            <Border Style="{StaticResource KlaChipBorderStyle}" Margin="0,0,6,0">
                                <TextBlock x:Name="CategoryText" FontSize="11" Foreground="{StaticResource KlaMutedBrush}" />
                            </Border>
                            <Border Style="{StaticResource KlaChipBorderStyle}">
                                <TextBlock x:Name="DisciplineText" FontSize="11" Foreground="{StaticResource KlaMutedBrush}" />
                            </Border>
                        </WrapPanel>
                        <Grid Margin="0,4,0,8">
                            <Border Style="{StaticResource KlaGroupBorderStyle}">
                                <StackPanel Margin="0,2,0,0">
                                    <ComboBox x:Name="Types" DisplayMemberPath="Name" SelectionChanged="OnTypeSelectionChanged" />
                                    <UniformGrid Columns="3" Margin="0,8,0,6">
                                        <Button Content="{StaticResource DuplicateTypeLabel}" Style="{StaticResource KlaButtonStyle}" Margin="0,0,4,0" IsEnabled="False" ToolTip="{StaticResource TypeEditingUnavailableLabel}" />
                                        <Button Content="{StaticResource RenameTypeLabel}" Style="{StaticResource KlaButtonStyle}" Margin="2,0" IsEnabled="False" ToolTip="{StaticResource TypeEditingUnavailableLabel}" />
                                        <Button Content="{StaticResource EditTypeLabel}" Style="{StaticResource KlaButtonStyle}" Margin="4,0,0,0" IsEnabled="False" ToolTip="{StaticResource TypeEditingUnavailableLabel}" />
                                    </UniformGrid>
                                    <ItemsControl x:Name="TypeParameters">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource KlaMutedTextStyle}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" FontSize="11" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{StaticResource TypeGroupLabel}" Style="{StaticResource KlaGroupCaptionStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-8,0,0" />
                        </Grid>
                        <Grid Margin="0,4,0,8">
                            <Border Style="{StaticResource KlaGroupBorderStyle}">
                                <ItemsControl x:Name="Tags" Margin="0,2,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource KlaNeutralChipStyle}" Background="{StaticResource KlaComponentSurfaceBrush}" Margin="0,0,5,4">
                                                <TextBlock Text="{Binding}" FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Text="{StaticResource TagsGroupLabel}" Style="{StaticResource KlaGroupCaptionStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-8,0,0" />
                        </Grid>
                        <Grid Margin="0,4,0,8">
                            <Border Style="{StaticResource KlaGroupBorderStyle}">
                                <ItemsControl x:Name="InstanceParameters" Margin="0,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource KlaMutedTextStyle}" />
                                                <TextBlock Grid.Column="1" Text="{Binding StorageType}" HorizontalAlignment="Right" FontSize="11" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Text="{StaticResource InstanceParametersGroupLabel}" Style="{StaticResource KlaGroupCaptionStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-8,0,0" />
                        </Grid>
                        <TextBlock x:Name="PathText" Style="{StaticResource KlaMutedTextStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ModifiedText" Style="{StaticResource KlaMutedTextStyle}" Margin="0,3,0,0" />
                        <TextBlock x:Name="CatalogCheckText" Style="{StaticResource KlaMutedTextStyle}" Margin="0,3,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Grid.Row="3" Margin="0,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="{StaticResource LoadLabel}" Style="{StaticResource KlaButtonStyle}" Margin="0,0,8,0" Click="OnLoadClick" />
                    <Button Content="{StaticResource LoadAndPlaceLabel}" Style="{StaticResource KlaButtonStyle}" Margin="0,0,8,0" Click="OnLoadAndPlaceClick" />
                    <Button x:Name="BatchLoadButton" Content="{StaticResource BatchLoadLabel}" Style="{StaticResource KlaButtonStyle}" IsEnabled="False" Click="OnBatchLoadClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="BatchCount" Style="{StaticResource KlaMutedTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="FavoriteButton" Content="{StaticResource FavoriteLabel}" Style="{StaticResource KlaButtonStyle}" Margin="0,0,8,0" Click="OnFavoriteClick">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource KlaGuiIcon}" Content="{StaticResource kliconFav}" />
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button Content="{StaticResource CopyPathLabel}" Style="{StaticResource KlaButtonStyle}" Margin="0,0,8,0" Click="OnCopyPathClick" />
                    <Button Content="{StaticResource OpenFolderLabel}" Style="{StaticResource KlaButtonStyle}" Click="OnOpenFolderClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </ContentControl>
</Window>
