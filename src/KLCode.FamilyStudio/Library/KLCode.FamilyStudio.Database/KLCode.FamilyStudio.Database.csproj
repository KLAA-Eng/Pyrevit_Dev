<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>KLCode.FamilyStudio.Database</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FamilyStudioRevitHost)' == 'true'">
    <OutputPath>bin/RevitHost/$(Configuration)/</OutputPath>
    <IntermediateOutputPath>obj/RevitHost/$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KLCode.FamilyStudio.Core/KLCode.FamilyStudio.Core.csproj"
                      AdditionalProperties="FamilyStudioRevitHost=$(FamilyStudioRevitHost)" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.30" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.12" />
  </ItemGroup>
</Project>
