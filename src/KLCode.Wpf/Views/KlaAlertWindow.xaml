<Window x:Class="KLCode.Wpf.Views.KlaAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" Height="300" Style="{StaticResource KlaFoundationWindow}"
        WindowStartupLocation="CenterOwner">
    <ContentControl x:Name="window_shell" Style="{StaticResource KlaWindowShell}">
        <Grid x:Name="window_body">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="32"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="AlertIconBorder" Width="32" Height="32" Style="{StaticResource KlaStatusChip}" VerticalAlignment="Top">
                    <ContentControl x:Name="AlertIcon" Style="{StaticResource KlaGuiIcon}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="AlertHeading" Style="{StaticResource KlaSectionHeading}"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="AlertMessage" Style="{StaticResource KlaInfoText}"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <Button Grid.Row="2" Content="{StaticResource OkLabel}" Style="{StaticResource KlaFoundationMainButton}" IsDefault="True" IsCancel="True" Click="OnCloseClick"/>
        </Grid>
    </ContentControl>
</Window>
