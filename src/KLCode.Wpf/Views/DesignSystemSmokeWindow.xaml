<Window x:Class="KLCode.Wpf.Views.DesignSystemSmokeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource DesignSystemSmokeTitle}"
        Width="440"
        Height="240"
        Style="{StaticResource KlaWindowStyle}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{StaticResource header_background}"
              MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="66" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        Margin="5,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="{StaticResource BrandSlash}"
                           Foreground="{StaticResource text_green}"
                           FontSize="16" />
                <TextBlock Text="{StaticResource BrandName}"
                           Foreground="{StaticResource text_white}"
                           FontSize="16" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{StaticResource DesignSystemSmokeTitle}"
                       Foreground="{StaticResource text_white}"
                       FontSize="14"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Content="{StaticResource CloseLabel}"
                    Style="{StaticResource KlaCloseButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OnCloseClick" />
        </Grid>

        <Border Grid.Row="1"
                Margin="10"
                Padding="12"
                BorderBrush="{StaticResource border_green_dark}"
                BorderThickness="1"
                CornerRadius="10">
            <TextBlock Text="{StaticResource DesignSystemSmokeBody}"
                       Foreground="{StaticResource text_white}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="5,0,0,0"
                       Text="{StaticResource PrototypeLabel}"
                       Style="{StaticResource KlaFooterTextStyle}" />
            <TextBlock Grid.Column="1"
                       Text="{StaticResource VersionLabel}"
                       Foreground="{StaticResource text_gray}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       Margin="0,0,5,0"
                       Text="{StaticResource OutreachLabel}"
                       Style="{StaticResource KlaFooterTextStyle}"
                       HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
