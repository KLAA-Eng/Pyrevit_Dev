<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Compiled-only semantic tokens. The canonical Python palette remains untouched. -->
    <SolidColorBrush x:Key="KlaSurfaceBrush" Color="#10171B" />
    <SolidColorBrush x:Key="KlaSurfaceDeepBrush" Color="#0D1418" />
    <SolidColorBrush x:Key="KlaPanelBrush" Color="#22303A" />
    <SolidColorBrush x:Key="KlaMutedTextBrush" Color="#808080" />
    <SolidColorBrush x:Key="KlaSubtleTextBrush" Color="#9DB3A8" />
    <SolidColorBrush x:Key="KlaNeutralBorderBrush" Color="#3D5049" />
    <SolidColorBrush x:Key="KlaRowHoverBrush" Color="#4F4F4F" />
    <SolidColorBrush x:Key="KlaRowSelectedBrush" Color="#4933714F" />
    <SolidColorBrush x:Key="KlaNearBlackBrush" Color="#131313" />
    <SolidColorBrush x:Key="KlaBlackBrush" Color="#000000" />
    <SolidColorBrush x:Key="KlaDisabledTextBrush" Color="#888888" />
    <SolidColorBrush x:Key="KlaInfoBrush" Color="#3CB371" />
    <SolidColorBrush x:Key="KlaWarningBrush" Color="#DAA520" />
    <SolidColorBrush x:Key="KlaBlockingBrush" Color="#FF8000" />
    <SolidColorBrush x:Key="KlaTransparentBrush" Color="Transparent" />
    <LinearGradientBrush x:Key="KlaCheckboxFillBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#E6286048" Offset="1" />
        <GradientStop Color="#E6307050" Offset="0" />
    </LinearGradientBrush>
    <FontFamily x:Key="KlaLogoFont">../Assets/Fonts/#Audiowide</FontFamily>
</ResourceDictionary>
