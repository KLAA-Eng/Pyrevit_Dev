<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../GUI/Resources/KLCodeComponents.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="KlaWindowStyle" TargetType="Window" BasedOn="{StaticResource klcFdnWindow}" />
    <Style x:Key="KlaButtonStyle" TargetType="Button" BasedOn="{StaticResource klcFdnButton}" />
    <Style x:Key="KlaCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource klcButtonClose}" />
    <Style x:Key="KlaGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource xGhostButton}" />
    <Style x:Key="KlaLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource xLinkButton}" />
    <Style x:Key="KlaSegmentButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource xSegmentButton}" />
    <Style x:Key="KlaTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource klcTextBox}" />
    <Style x:Key="KlaComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource klcComboBoxFilter}" />
    <Style x:Key="KlaCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource klcCheckBox}" />
    <Style x:Key="KlaListBoxStyle" TargetType="ListBox" BasedOn="{StaticResource KlaFoundationList}" />
    <Style x:Key="KlaListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource KlaFoundationListItem}" />
    <Style x:Key="KlaGroupBorderStyle" TargetType="Border" BasedOn="{StaticResource klcBorder}" />
    <Style x:Key="KlaGroupCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource klcTextBlockHeading}">
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="KlaChipBorderStyle" TargetType="Border" BasedOn="{StaticResource xStatusChip}" />
    <Style x:Key="KlaInfoChipStyle" TargetType="Border" BasedOn="{StaticResource xStatusChip}">
        <Setter Property="BorderBrush" Value="{StaticResource klcInfo}" />
    </Style>
    <Style x:Key="KlaWarningChipStyle" TargetType="Border" BasedOn="{StaticResource xStatusWarning}" />
    <Style x:Key="KlaBlockingChipStyle" TargetType="Border" BasedOn="{StaticResource xStatusError}" />
    <Style x:Key="KlaNeutralChipStyle" TargetType="Border" BasedOn="{StaticResource xStatusChip}" />
    <Style x:Key="KlaMutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource klcTextBlockMuted}" />
    <Style x:Key="KlaPreviewBorderStyle" TargetType="Border" BasedOn="{StaticResource klcBorder}">
        <Setter Property="Background" Value="{StaticResource xPreviewSurfaceBrush}" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <!-- The implicit TextBox / ComboBox / CheckBox styles live in KLCodeComponents.xaml, shared with the Python host. -->
</ResourceDictionary>
