<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../GUI/Resources/KLCodeComponents.xaml" />
        <ResourceDictionary Source="KLCodeCompiledTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="KlaWindowStyle" TargetType="Window" BasedOn="{StaticResource KlaFoundationWindow}" />
    <Style x:Key="KlaButtonStyle" TargetType="Button" BasedOn="{StaticResource KlaFoundationButton}" />
    <Style x:Key="KlaSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource KlaFoundationButton}" />
    <Style x:Key="KlaCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource KlaFoundationCloseButton}" />
    <Style x:Key="KlaGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource KlaSecondaryButton}" />
    <Style x:Key="KlaLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource KlaSecondaryButton}" />
    <Style x:Key="KlaSegmentButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource KlaRadioButton}" />
    <Style x:Key="KlaTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource KlaCompactFieldInput}" />
    <Style x:Key="KlaComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource KlaCompactComboBox}" />
    <Style x:Key="KlaCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource KlaFoundationCheckBox}" />
    <Style x:Key="KlaListBoxStyle" TargetType="ListBox" BasedOn="{StaticResource KlaFoundationList}" />
    <Style x:Key="KlaListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource KlaFoundationListItem}" />
    <Style x:Key="KlaGroupBorderStyle" TargetType="Border" BasedOn="{StaticResource KlaSection}" />
    <Style x:Key="KlaGroupCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource KlaPromptText}" />
    <Style x:Key="KlaChipBorderStyle" TargetType="Border" BasedOn="{StaticResource KlaStatusChip}" />
    <Style x:Key="KlaInfoChipStyle" TargetType="Border" BasedOn="{StaticResource KlaStatusChip}">
        <Setter Property="BorderBrush" Value="{StaticResource KlaInfoBrush}" />
    </Style>
    <Style x:Key="KlaWarningChipStyle" TargetType="Border" BasedOn="{StaticResource KlaStatusWarning}" />
    <Style x:Key="KlaBlockingChipStyle" TargetType="Border" BasedOn="{StaticResource KlaStatusError}" />
    <Style x:Key="KlaNeutralChipStyle" TargetType="Border" BasedOn="{StaticResource KlaStatusChip}" />
    <Style x:Key="KlaMutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource KlaInfoText}" />
    <Style x:Key="KlaPreviewBorderStyle" TargetType="Border" BasedOn="{StaticResource KlaSection}">
        <Setter Property="Background" Value="{StaticResource KlaSurfaceBrush}" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource KlaTextBoxStyle}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource KlaComboBoxStyle}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource KlaCheckBoxStyle}" />
</ResourceDictionary>
